# The Wine winum is built from.
# WINE_VERSION: upstream Wine release the patches are made for.
# WINE_SHA256:  SHA-256 of the official wine-${WINE_VERSION}.tar.xz from
#               dl.winehq.org; scripts/lib/wine-source.sh checks it before
#               extraction. Taken from a download whose .sign verified with
#               Alexandre Julliard's key DA23579A74D4AD9AF9D3F945CEFAC8EAAF17519D
#               (listed in Arch's wine PKGBUILD validpgpkeys), 2026-11-08.
# WINUM_BUILD:  winum's build number for that Wine version - raise it when
#               patches/series or a patch in it changes. Release name:
#               winum-${WINE_VERSION}-${WINUM_BUILD}
WINE_VERSION=11.20
WINE_SHA256=eac8ca448f9c0087f963026b4dc276d1e2b7fbb64056edc093e59bbb7e56fe28
WINUM_BUILD=2
