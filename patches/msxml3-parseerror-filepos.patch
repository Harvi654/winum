+static void check_filepos_(unsigned line, IXMLDOMDocument *doc, HRESULT expect_hr, LONG expect, BOOL todo)
+{
+    IXMLDOMParseError *error;
+    LONG filepos;
+    HRESULT hr;
+
+    hr = IXMLDOMDocument_get_parseError(doc, &error);
+    ok_(__FILE__, line)(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    if (FAILED(hr)) return;
+
+    filepos = -1;
+    hr = IXMLDOMParseError_get_filepos(error, &filepos);
+    ok_(__FILE__, line)(hr == expect_hr, "Unexpected hr %#lx.\n", hr);
+    todo_wine_if(todo)
+    ok_(__FILE__, line)(filepos == expect, "Unexpected file position %ld.\n", filepos);
+
+    hr = IXMLDOMParseError_get_filepos(error, NULL);
+    ok_(__FILE__, line)(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
+
+    IXMLDOMParseError_Release(error);
+}
+#define check_filepos(doc, hr, pos, todo) check_filepos_(__LINE__, doc, hr, pos, todo)
+
+/* Values measured on Windows 10, msxml3 and msxml6 alike, x86_64 and i686
+ * (winum docs/wine-repro/msxml3-parseerror-filepos/windows-2026-11-08). */
+static void test_parseerror_filepos(const GUID *clsid, const char *name)
+{
+    /* a new document for every load, as in the measurement */
+    static const struct
+    {
+        const char *xml;
+        HRESULT hr;
+        LONG filepos;
+        BOOL todo;
+    } loads[] =
+    {
+        { "", S_OK, 0 },
+        /* the position is the offset of the offending character */
+        { "<a><b></a>", S_OK, 8, TRUE },
+        { "<a>\n  <b>\n</a>", S_OK, 12, TRUE },
+        /* no error after a successful load */
+        { "<a><b/></a>", S_FALSE, 0 },
+    };
+    IXMLDOMDocument *doc;
+    VARIANT_BOOL b;
+    unsigned int i;
+    HRESULT hr;
+
+    if (!is_clsid_supported(clsid, &IID_IXMLDOMDocument))
+    {
+        win_skip("%s is not supported.\n", name);
+        return;
+    }
+    winetest_push_context("%s", name);
+
+    doc = _create_object(clsid, name, &IID_IXMLDOMDocument, __LINE__);
+    check_filepos(doc, S_FALSE, 0, FALSE);
+    IXMLDOMDocument_Release(doc);
+
+    for (i = 0; i < ARRAY_SIZE(loads); i++)
+    {
+        winetest_push_context("%u", i);
+        doc = _create_object(clsid, name, &IID_IXMLDOMDocument, __LINE__);
+        b = loads[i].hr == S_OK ? VARIANT_TRUE : VARIANT_FALSE;
+        hr = IXMLDOMDocument_loadXML(doc, _bstr_(loads[i].xml), &b);
+        ok(hr == (loads[i].hr == S_OK ? S_FALSE : S_OK), "Unexpected hr %#lx.\n", hr);
+        ok(b == (loads[i].hr == S_OK ? VARIANT_FALSE : VARIANT_TRUE), "Unexpected result %d.\n", b);
+        check_filepos(doc, loads[i].hr, loads[i].filepos, loads[i].todo);
+        IXMLDOMDocument_Release(doc);
+        winetest_pop_context();
+    }
+
+    winetest_pop_context();
+}
+
 static void test_parseerror(void)
 {
     IXMLDOMParseError *error;
     IXMLDOMDocument *doc;
     HRESULT hr;
+    LONG filepos;
 
     doc = create_document(&IID_IXMLDOMDocument);
 
@@ -12953,6 +13032,15 @@
     todo_wine
     check_interface(error, &IID_IXMLDOMParseError2, FALSE);
 
+    /* no parse error: S_FALSE and 0, as the other getters on Windows */
+    filepos = -1;
+    hr = IXMLDOMParseError_get_filepos(error, &filepos);
+    ok(hr == S_FALSE, "Unexpected hr %#lx.\n", hr);
+    ok(filepos == 0, "Unexpected file position %ld.\n", filepos);
+
+    hr = IXMLDOMParseError_get_filepos(error, NULL);
+    ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
+
     hr = IXMLDOMParseError_get_line(error, NULL);
     ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
 
@@ -12963,7 +13051,9 @@
     ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
 
     IXMLDOMParseError_Release(error);
+
     IXMLDOMDocument_Release(doc);
+    free_bstrs();
 }
 
