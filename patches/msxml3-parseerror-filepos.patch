Wine 11.20: implement IXMLDOMParseError::get_filepos.

Experimental, AI-assisted; LGPL-2.1-or-later; not submitted upstream.
Return the parse-error object's stored position, matching its line/linepos
getters, and reject a NULL output pointer. This does not make invalid XML
valid or populate missing parser position metadata. SOLIDWORKS calls this
getter after loadXML("") fails; the old E_NOTIMPL precedes its C++ exception.
Application causality and native reference checks remain pending.

--- a/dlls/msxml3/parseerror.c
+++ b/dlls/msxml3/parseerror.c
@@ -242,8 +242,11 @@
     LONG *filepos )
 {
     parse_error_t *This = impl_from_IXMLDOMParseError2( iface );
-    FIXME("(%p)->(%p)\n", This, filepos);
-    return E_NOTIMPL;
+    TRACE("(%p)->(%p)\n", This, filepos);
+    if (!filepos) return E_INVALIDARG;
+
+    *filepos = This->filepos;
+    return S_OK;
 }
 
 static HRESULT WINAPI parseError_get_errorXPath(
