+
+/* Windowless timer IDs belong to the process, but delivery stays on the creating queue. */
+static struct msg_queue *find_windowless_timer_queue( struct process *process, unsigned int msg,
+                                                       lparam_t id )
+{
+    struct thread *thread;
+
+    LIST_FOR_EACH_ENTRY( thread, &process->thread_list, struct thread, proc_entry )
+        if (thread->queue && find_timer( thread->queue, 0, msg, id )) return thread->queue;
     return NULL;
 }

