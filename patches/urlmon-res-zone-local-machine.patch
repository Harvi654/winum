From: Harvi654 <202698022+Harvi654@users.noreply.github.com>
Subject: [PATCH] urlmon: Put res:/// URLs without a module in the zone of the res scheme.

AI-assisted (Claude), original code; LGPL-2.1-or-later. Not submitted
upstream.

Windows 10 (x86_64 and i686, our own MEASURE program, winum
docs/wine-repro/urlmon-zones/windows-2026-11-09) gives a res:/// URL,
a resource without a module, the Internet zone (3) through the zone of
the res scheme, while "res:" and "res:x" stay URLZONE_INVALID with S_OK.
Wine applied its rule for hierarchical URLs without a host to all of
them and answered URLZONE_INVALID, which WPF refuses (AutoCAD's ribbon
icons).

The change is limited to the res scheme and to URLs written with an
empty authority ("res:///"); every other URL keeps its path through
get_zone_from_domains(). The first version of this patch gave every
res: URL that ended up URLZONE_INVALID the local machine zone, which is
not what Windows returns.

Not changed: Windows maps a res: URL of an existing module to the
module's file, so res://shell32.dll/... gets the local machine zone and
a file: security URL; Wine keeps the res: URL. That check is todo_wine.

--- a/dlls/urlmon/sec_mgr.c
+++ b/dlls/urlmon/sec_mgr.c
@@ -544,6 +544,22 @@
         SysFreeString(path);
     }
 
+    /* A res:/// URL names a resource without a module. Windows puts it in
+     * the zone of the scheme; other hierarchical URLs without a host, such
+     * as "res:x", stay URLZONE_INVALID below. */
+    if(*zone == URLZONE_INVALID && !wcsicmp(scheme, L"res")) {
+        BSTR raw;
+
+        hres = IUri_GetRawUri(uri, &raw);
+        if(FAILED(hres)) {
+            SysFreeString(scheme);
+            return hres;
+        }
+        if(!wcsnicmp(raw, L"res:///", 7))
+            hres = get_zone_from_reg(scheme, zone);
+        SysFreeString(raw);
+    }
+
     if(*zone == URLZONE_INVALID) {
         hres = get_zone_from_domains(uri, zone);
         if(hres == S_FALSE)
--- a/dlls/urlmon/tests/sec_mgr.c
+++ b/dlls/urlmon/tests/sec_mgr.c
@@ -2403,6 +2403,67 @@
     IUnknown_Release(unk2);
 }
 
+static void test_res_zones(void)
+{
+    /* Measured on Windows 10 22H2, x86_64 and i686 alike
+     * (winum docs/wine-repro/urlmon-zones/windows-2026-11-09). */
+    static const struct {
+        const WCHAR *url;
+        HRESULT hres;
+        DWORD zone;
+        BOOL same_secur;
+        BOOL todo;
+    } tests[] = {
+        {L"res:///btn.xmx/icon.png", S_OK, URLZONE_INTERNET, TRUE},
+        {L"res:///%prodname%btn.xmx/RIBBON/icon.png", E_INVALIDARG, URLZONE_INVALID, TRUE},
+        /* Wine does not map a res: URL of a module to its file. */
+        {L"res://shell32.dll/#2/#130", S_OK, URLZONE_LOCAL_MACHINE, FALSE, TRUE},
+        {L"res://notexisting.dll/x.png", S_OK, URLZONE_INTERNET, TRUE},
+        {L"res:", S_OK, URLZONE_INVALID, TRUE},
+        {L"res:x", S_OK, URLZONE_INVALID, TRUE},
+        {L"unknownscheme:abc", S_OK, URLZONE_INTERNET, TRUE},
+        {L"unknownscheme://host/path", S_OK, URLZONE_INTERNET, TRUE},
+        {L"x", E_INVALIDARG, URLZONE_INVALID, TRUE},
+        {L"", E_INVALIDARG, URLZONE_INVALID, TRUE},
+    };
+    IInternetSecurityManager *secmgr;
+    WCHAR *secur;
+    DWORD zone;
+    HRESULT hres;
+    unsigned i;
+
+    hres = pCoInternetCreateSecurityManager(NULL, &secmgr, 0);
+    ok(hres == S_OK, "CoInternetCreateSecurityManager failed: %08lx\n", hres);
+    if(FAILED(hres))
+        return;
+
+    for(i = 0; i < ARRAY_SIZE(tests); i++) {
+        winetest_push_context("%s", wine_dbgstr_w(tests[i].url));
+
+        zone = 0xdeadbeef;
+        hres = IInternetSecurityManager_MapUrlToZone(secmgr, tests[i].url, &zone, 0);
+        ok(hres == tests[i].hres, "MapUrlToZone returned %08lx, expected %08lx\n", hres, tests[i].hres);
+        todo_wine_if(tests[i].todo)
+        ok(zone == tests[i].zone, "zone = %ld, expected %ld\n", zone, tests[i].zone);
+
+        secur = NULL;
+        hres = pCoInternetGetSecurityUrl(tests[i].url, &secur, PSU_SECURITY_URL_ONLY, 0);
+        ok(hres == S_OK, "CoInternetGetSecurityUrl returned %08lx\n", hres);
+        if(secur) {
+            if(tests[i].same_secur)
+                ok(!lstrcmpW(secur, tests[i].url), "security URL = %s\n", wine_dbgstr_w(secur));
+            else
+                todo_wine_if(tests[i].todo)
+                ok(!memcmp(secur, L"file://", 7 * sizeof(WCHAR)), "security URL = %s\n", wine_dbgstr_w(secur));
+            CoTaskMemFree(secur);
+        }
+
+        winetest_pop_context();
+    }
+
+    IInternetSecurityManager_Release(secmgr);
+}
+
 START_TEST(sec_mgr)
 {
     HMODULE hurlmon;
@@ -2445,6 +2506,7 @@
     }
 
     test_SecurityManager();
+    test_res_zones();
     test_SecurityManagerEx2();
     test_polices();
     test_zone_domains();
