From: Harvi654 <202698022+Harvi654@users.noreply.github.com>
Subject: msxml3: Keep a child that is replaced with, or inserted before, itself.

AI-assisted (Claude for the contributor, Codex for the test revision),
original code; LGPL-2.1-or-later. Not submitted upstream.
Contributed by Lukas10999 (winum pull request #4): the fix, the first
regression test and the Inventor reproducer. Taken into the series by
the maintainer with the Windows-informed test revision (e2b2162).

Findings: docs/wine-repro/msxml3-replacechild-same-node,
docs/wine-repro/msxml3-same-node-measure.

DWG TrueView 2027, which Inventor starts as its in-place server for DWG and
DXF previews, rewrites its profile (Profile.aws) through msxml3 on every
pass. It selects the AcApData element twice (selectSingleNode, two COM
objects for one node) and calls replaceChild(parent, new, old) with both.
Wine's node_replace_child inserted the node before itself and then removed
it: domnode_insert_domnode unlinks the child's list entry and
list_add_before links it to itself, so the parent's child list runs in a
cycle. The save that follows never finishes, appends the subtree forever
(the profile grew to 1.1 GB), and the preview Inventor waits for never
arrives. The import itself continued only after the viewer was killed.

Every IXMLDOMNode wrapper is created per access (get_item, selectSingleNode,
...), so two interface pointers may name the same node: compare the
underlying struct domnode, not the pointers. replaceChild with the same
node returns S_OK and the node as the removed child, and changes nothing.
insertBefore of a node before itself preserves the existing child-type
check. On Windows 10 it succeeds for a child of an element and returns
E_FAIL for the document root, leaving the tree unchanged either way.

v2 test follow-up (Codex, 2026-11-19): native Windows 10 on x86_64
and i686 gave the same results. Use a fresh tree for every call,
assert the result for the document root and cover calls without
an output pointer. Keep the contributor's runtime fix unchanged.
The output check compares the identity with the operation's own
input wrapper. It does not require Wine to share IUnknown between
separately acquired wrappers.

---
diff --git a/dlls/msxml3/node.c b/dlls/msxml3/node.c
index 36e122b..5b74c03 100644
--- a/dlls/msxml3/node.c
+++ b/dlls/msxml3/node.c
@@ -650,7 +650,10 @@ HRESULT node_insert_before(struct domnode *node, IXMLDOMNode *new_child, const V
         return E_FAIL;
     }
 
-    domnode_insert_domnode(node, child_node, ref_node);
+    /* The node is already where it would go: inserting it before itself
+     * would unlink its list entry and then link it to itself. */
+    if (ref_node != child_node)
+        domnode_insert_domnode(node, child_node, ref_node);
 
     if (ret)
     {
@@ -697,6 +700,18 @@ HRESULT node_replace_child(struct domnode *node, IXMLDOMNode *newChild, IXMLDOMN
         curr = curr->parent;
     }
 
+    /* Replacing a child with itself (two interface pointers to the same
+     * node) changes nothing; it must not remove the child. */
+    if (new_child == old_child)
+    {
+        if (ret)
+        {
+            *ret = oldChild;
+            IXMLDOMNode_AddRef(*ret);
+        }
+        return S_OK;
+    }
+
     V_VT(&ref) = VT_DISPATCH;
     V_DISPATCH(&ref) = (IDispatch *)oldChild;
     if (FAILED(hr = node_insert_before(node, newChild, &ref, NULL)))
diff --git a/dlls/msxml3/tests/domdoc.c b/dlls/msxml3/tests/domdoc.c
--- a/dlls/msxml3/tests/domdoc.c
+++ b/dlls/msxml3/tests/domdoc.c
@@ -4329,6 +4329,139 @@
     IXMLDOMDocument_Release( doc );
 
     free_bstrs();
+}
+
+static BOOL same_node_identity(IXMLDOMNode *first, IXMLDOMNode *second)
+{
+    IUnknown *first_unknown = NULL, *second_unknown = NULL;
+    BOOL equal = FALSE;
+
+    if (SUCCEEDED(IXMLDOMNode_QueryInterface(first, &IID_IUnknown, (void **)&first_unknown))
+        && SUCCEEDED(IXMLDOMNode_QueryInterface(second, &IID_IUnknown, (void **)&second_unknown)))
+        equal = first_unknown == second_unknown;
+    if (second_unknown) IUnknown_Release(second_unknown);
+    if (first_unknown) IUnknown_Release(first_unknown);
+    return equal;
+}
+
+static void test_same_node(BOOL document, BOOL insert, BOOL output)
+{
+    IXMLDOMDocument *doc;
+    IXMLDOMElement *element = NULL;
+    IXMLDOMNode *container = NULL, *child = NULL, *alias = NULL, *returned = NULL;
+    IXMLDOMNode *parent = NULL, *last = NULL;
+    IXMLDOMNodeList *list = NULL;
+    BSTR before = NULL, after = NULL, name = NULL;
+    const WCHAR *expected_last = document ? L"root" : L"target";
+    LONG index = document ? 0 : 1, count = -1;
+    BOOL intact;
+    VARIANT_BOOL loaded;
+    VARIANT ref = {0};
+    HRESULT hr;
+
+    winetest_push_context("%s parent=%s out=%d", insert ? "insertBefore" : "replaceChild",
+                          document ? "document" : "element", output);
+    doc = create_document(&IID_IXMLDOMDocument);
+    if (!doc) goto done;
+    hr = IXMLDOMDocument_loadXML(doc, _bstr_("<root><first/><target/></root>"), &loaded);
+    ok(hr == S_OK && loaded == VARIANT_TRUE, "loadXML returned %#lx, loaded %d.\n", hr, loaded);
+    if (hr != S_OK || loaded != VARIANT_TRUE) goto done;
+
+    if (document)
+        hr = IXMLDOMDocument_QueryInterface(doc, &IID_IXMLDOMNode, (void **)&container);
+    else
+    {
+        hr = IXMLDOMDocument_get_documentElement(doc, &element);
+        ok(hr == S_OK && !!element, "get_documentElement returned %#lx, element %p.\n", hr, element);
+        if (hr != S_OK || !element) goto done;
+        hr = IXMLDOMElement_QueryInterface(element, &IID_IXMLDOMNode, (void **)&container);
+    }
+    ok(hr == S_OK && !!container, "QueryInterface returned %#lx, node %p.\n", hr, container);
+    if (hr != S_OK || !container) goto done;
+    hr = IXMLDOMNode_get_childNodes(container, &list);
+    ok(hr == S_OK && !!list, "get_childNodes returned %#lx, list %p.\n", hr, list);
+    if (hr != S_OK || !list) goto done;
+    hr = IXMLDOMNodeList_get_item(list, index, &child);
+    ok(hr == S_OK && !!child, "first get_item returned %#lx, node %p.\n", hr, child);
+    if (hr != S_OK || !child) goto done;
+    hr = IXMLDOMNodeList_get_item(list, index, &alias);
+    ok(hr == S_OK && !!alias, "second get_item returned %#lx, node %p.\n", hr, alias);
+    if (hr != S_OK || !alias) goto done;
+    ok(child != alias, "got the same interface twice.\n");
+
+    hr = IXMLDOMNode_get_xml(container, &before);
+    ok(hr == S_OK && !!before, "get_xml returned %#lx, xml %p.\n", hr, before);
+    if (hr != S_OK || !before) goto done;
+
+    if (insert)
+    {
+        V_VT(&ref) = VT_DISPATCH;
+        V_DISPATCH(&ref) = (IDispatch *)alias;
+        hr = IXMLDOMNode_insertBefore(container, child, ref, output ? &returned : NULL);
+    }
+    else
+        hr = IXMLDOMNode_replaceChild(container, child, alias, output ? &returned : NULL);
+    ok(hr == (document && insert ? E_FAIL : S_OK), "returned %#lx.\n", hr);
+    if (output && !(document && insert))
+        ok(returned && same_node_identity(returned, insert ? child : alias),
+           "the output does not identify the child.\n");
+    else if (output)
+        ok(!returned, "returned %p.\n", returned);
+
+    hr = IXMLDOMNode_get_parentNode(child, &parent);
+    intact = hr == S_OK && parent;
+    ok(intact, "get_parentNode returned %#lx, parent %p.\n", hr, parent);
+    hr = IXMLDOMNode_get_lastChild(container, &last);
+    ok(hr == S_OK && !!last, "get_lastChild returned %#lx, node %p.\n", hr, last);
+    if (hr == S_OK && last)
+    {
+        hr = IXMLDOMNode_get_nodeName(last, &name);
+        ok(hr == S_OK && name && !lstrcmpW(name, expected_last), "last child %s, hr %#lx.\n",
+           wine_dbgstr_w(name), hr);
+        intact = intact && hr == S_OK && name && !lstrcmpW(name, expected_last);
+    }
+    else
+        intact = FALSE;
+
+    if (!intact)
+    {
+        /* With the broken list, walking or freeing the tree can loop. */
+        SysFreeString(name);
+        SysFreeString(before);
+        free_bstrs();
+        winetest_pop_context();
+        return;
+    }
+
+    hr = IXMLDOMNodeList_get_length(list, &count);
+    ok(hr == S_OK && count == index + 1, "get_length returned %#lx, length %ld.\n", hr, count);
+    hr = IXMLDOMNode_get_xml(container, &after);
+    ok(hr == S_OK && after && !lstrcmpW(before, after), "XML after the call %s, hr %#lx.\n",
+       wine_dbgstr_w(after), hr);
+
+done:
+    SysFreeString(after);
+    SysFreeString(name);
+    SysFreeString(before);
+    if (last) IXMLDOMNode_Release(last);
+    if (parent) IXMLDOMNode_Release(parent);
+    if (returned) IXMLDOMNode_Release(returned);
+    if (alias) IXMLDOMNode_Release(alias);
+    if (child) IXMLDOMNode_Release(child);
+    if (list) IXMLDOMNodeList_Release(list);
+    if (container) IXMLDOMNode_Release(container);
+    if (element) IXMLDOMElement_Release(element);
+    if (doc) IXMLDOMDocument_Release(doc);
+    free_bstrs();
+    winetest_pop_context();
+}
+
+static void test_same_node_calls(void)
+{
+    unsigned int i;
+
+    for (i = 0; i < 8; ++i)
+        test_same_node(!!(i & 1), !!(i & 2), !!(i & 4));
 }
 
 static void test_replaceChild(void)
@@ -19640,6 +19773,7 @@
     test_get_lastChild();
     test_removeChild();
     test_replaceChild();
+    test_same_node_calls();
     test_removeNamedItem();
     test_IXMLDOMDocument2();
     test_whitespace();
