From: Harvi654 <202698022+Harvi654@users.noreply.github.com>
Subject: shell32: Handle Enter in the focused shell view label editor

Inventor delegates Enter to the shell view and opens the selected folder after the Wine stub returns S_FALSE. Windows 10 build 19045.6466 consumes this message, commits the label and closes the editor on x86_64 and i686.

Dispatch only WM_KEYDOWN VK_RETURN addressed to the focused inline editor. Reuse the existing list-view end-edit behavior and leave the other keys and targets on the unhandled path.

AI-assisted (Codex), original code; LGPL-2.1-or-later. Not submitted upstream.
diff --git a/dlls/shell32/shlview.c b/dlls/shell32/shlview.c
index af09787..dd02679 100644
--- a/dlls/shell32/shlview.c
+++ b/dlls/shell32/shlview.c
@@ -1915,23 +1915,26 @@ static HRESULT WINAPI IShellView_fnContextSensitiveHelp(IShellView3 *iface, BOOL
 
 /**********************************************************
 * IShellView_TranslateAccelerator
-*
-* FIXME:
-*  use the accel functions
 */
 static HRESULT WINAPI IShellView_fnTranslateAccelerator(IShellView3 *iface, MSG *lpmsg)
 {
-#if 0
-	IShellViewImpl *This = (IShellViewImpl *)iface;
+    IShellViewImpl *This = impl_from_IShellView3(iface);
+    HWND edit;
 
-	FIXME("(%p)->(%p: hwnd=%x msg=%x lp=%x wp=%x) stub\n",This,lpmsg, lpmsg->hwnd, lpmsg->message, lpmsg->lParam, lpmsg->wParam);
-#endif
+    if (lpmsg->message >= WM_KEYFIRST && lpmsg->message <= WM_KEYLAST)
+        TRACE("key %#Ix in message %#x targeting %p\n", lpmsg->wParam, lpmsg->message, lpmsg->hwnd);
 
-	if ((lpmsg->message>=WM_KEYFIRST) && (lpmsg->message<=WM_KEYLAST))
-	{
-	  TRACE("-- key=0x04%Ix\n",lpmsg->wParam) ;
-	}
-	return S_FALSE; /* not handled */
+    if (This->hWndList && lpmsg->message == WM_KEYDOWN && lpmsg->wParam == VK_RETURN)
+    {
+        edit = (HWND)SendMessageW(This->hWndList, LVM_GETEDITCONTROL, 0, 0);
+        if (edit && lpmsg->hwnd == edit && GetFocus() == edit)
+        {
+            DispatchMessageW(lpmsg);
+            return S_OK;
+        }
+    }
+
+    return S_FALSE;
 }
 
