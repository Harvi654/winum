+            check_position(s,L"Position",cases[i].preamble);
+        }
+        hr = operation(s,L"WriteText",CALL,2,string(sample),number(0),S_OK,S_OK);
+        if (SUCCEEDED(hr))
+        {
+            check_position(s,L"Size",cases[i].written);
+            check_position(s,L"Position",cases[i].written);
+            operation(s,L"Charset",PUT,1,string(L"Unicode"),number(0),
+                      DISP_E_EXCEPTION,ADO_ILLEGAL_OPERATION);
+        }
+        SETINT(s,"LineSeparator",-1);
+        line1 = operation(s,L"WriteText",CALL,2,string(L"B"),number(1),S_OK,S_OK);
+        SETINT(s,"LineSeparator",10);
+        line2 = operation(s,L"WriteText",CALL,2,string(L"C"),number(1),S_OK,S_OK);
+        if (SUCCEEDED(operation(s,L"SaveToFile",CALL,2,string(path),number(2),S_OK,S_OK)) &&
+            SUCCEEDED(hr) && SUCCEEDED(line1) && SUCCEEDED(line2))
+        {
+            check_position(s,L"Position",0);
+            check_file(path,cases[i].bytes,cases[i].size);
+        }
+        if (i < 2 && SUCCEEDED(hr) && SUCCEEDED(line1) && SUCCEEDED(line2))
+        {
+            SETINT(s,"Position",0);
+            check_read(s,1,L"A",1,4);
+            check_read(s,3,bounded,ARRAY_SIZE(bounded),12);
+            check_read(s,-2,after_split,ARRAY_SIZE(after_split),18);
+        }
+        SETINT(s,"Position",0);
+        b = open_stream(1,NULL);
+        if (b)
+        {
+            if (SUCCEEDED(operation(s,L"CopyTo",CALL,2,object_arg(b),number(-1),S_OK,S_OK)) &&
+                SUCCEEDED(hr) && SUCCEEDED(line1) && SUCCEEDED(line2))
+            {
+                check_position(s,L"Position",cases[i].size);
+                check_position(b,L"Position",cases[i].size);
+                if (SUCCEEDED(operation(b,L"SaveToFile",CALL,2,string(path),number(2),S_OK,S_OK)))
+                    check_file(path,cases[i].bytes,cases[i].size);
+            }
+            METHOD(b,"Close");
+            IDispatch_Release(b);
+        }
+        SETINT(s,"Position",0);
+        METHOD(s,"SetEOS");
+        check_position(s,L"Size",0);
+        if (SUCCEEDED(operation(s,L"SaveToFile",CALL,2,string(path),number(2),S_OK,S_OK)))
+            check_file(path,NULL,0);
+        METHOD(s,"Close");
+        IDispatch_Release(s);
+        winetest_pop_context();
+    }
+}
+
+static void test_load(const WCHAR *path, BOOL bom)
+{
+    static const BYTE fixture[] = {0xef,0xbb,0xbf,0x41,0xc4,0x8d,0xe2,0x82,0xac,
+                                   0xf0,0x9f,0x98,0x83,0x0d,0x0a,0x5a,0x0a,0x51};
+    DWORD count = 0, offset = bom ? 0 : 3;
+    IDispatch *s, *b;
+    HANDLE f;
+
+    f = CreateFileW(path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL);
+    ok(f != INVALID_HANDLE_VALUE, "CreateFileW returned %lu.\n", GetLastError());
+    if (f == INVALID_HANDLE_VALUE) return;
+    ok(WriteFile(f,fixture + offset,sizeof(fixture) - offset,&count,NULL) &&
+       count == sizeof(fixture) - offset, "Fixture write returned %lu, bytes %lu.\n", GetLastError(), count);
+    CloseHandle(f);
+
+    s = open_stream(2,L"utf-8");
+    if (!s) return;
+    if (SUCCEEDED(FILECALL(s,"LoadFromFile",path)))
+    {
+        check_position(s,L"Size",18);
+        check_position(s,L"Position",0);
+        SETINT(s,"LineSeparator",-1);
+        check_read(s,-2,sample,ARRAY_SIZE(sample)-1,15);
+        SETINT(s,"LineSeparator",10);
+        check_read(s,-2,L"Z",1,17);
+        check_read(s,-1,L"Q",1,18);
+    }
+    SETINT(s,"Position",0);
+    METHOD(s,"SetEOS");
+    b = open_stream(1,NULL);
+    if (b)
+    {
+        if (SUCCEEDED(FILECALL(b,"LoadFromFile",path)))
+        {
+            check_position(b,L"Size",sizeof(fixture) - offset);
+            operation(b,L"CopyTo",CALL,2,object_arg(s),number(-1),
+                      DISP_E_EXCEPTION,ADO_ILLEGAL_OPERATION);
+            check_position(b,L"Position",0);
+            check_position(s,L"Size",0);
+        }
+        METHOD(b,"Close");
+        IDispatch_Release(b);
+    }
+    METHOD(s,"Close");
+    IDispatch_Release(s);
+}
+
+START_TEST(stream_charset)
+{
+    WCHAR temp[MAX_PATH], path[MAX_PATH];
+    HRESULT hr;
+    DWORD len;
+
+    hr = CoInitialize(NULL);
+    ok(SUCCEEDED(hr), "CoInitialize returned %#lx.\n", hr);
+    if (FAILED(hr)) return;
+    len = GetTempPathW(ARRAY_SIZE(temp),temp);
+    ok(len && len < ARRAY_SIZE(temp), "GetTempPathW returned %lu.\n", len);
+    if (len && len < ARRAY_SIZE(temp))
+    {
+        if (GetTempFileNameW(temp,L"ado",0,path))
+        {
+            test_write(path);
+            test_load(path,TRUE);
+            test_load(path,FALSE);
+            ok(DeleteFileW(path), "DeleteFileW returned %lu.\n", GetLastError());
+        }
+        else ok(FALSE, "GetTempFileNameW returned %lu.\n", GetLastError());
+    }
+    CoUninitialize();
+}
