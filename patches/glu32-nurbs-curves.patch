+/* A camera-plane crossing must be clipped by GL, not reject the NURBS. */
+static void test_nurbs_eye_plane( GLUnurbs *nurbs )
+{
+    GLfloat knots[] = {0, 0, 1, 1};
+    GLfloat control[] = {-0.5f, 0, -2, 1, 0, 2};
+    GLfloat feedback[4096];
+    int count, i;
+
+    glMatrixMode( GL_PROJECTION );
+    glLoadIdentity();
+    glFrustum( -1, 1, -1, 1, 1, 10 );
+    glMatrixMode( GL_MODELVIEW );
+    glLoadIdentity();
+    nurbs_errors = 0;
+    glFeedbackBuffer( ARRAY_SIZE(feedback), GL_3D, feedback );
+    glRenderMode( GL_FEEDBACK );
+    gluBeginCurve( nurbs );
+    gluNurbsCurve( nurbs, 4, knots, 3, control, 2, GL_MAP1_VERTEX_3 );
+    gluEndCurve( nurbs );
+    count = glRenderMode( GL_RENDER );
+    ok( !nurbs_errors, "eye-plane crossing error callbacks %u\n", nurbs_errors );
+    ok( count > 0, "eye-plane crossing emitted %d feedback floats\n", count );
+    if (count > 0)
+        for (i = 0; i < count; ++i)
+            ok( isfinite(feedback[i]), "nonfinite eye-plane feedback at %d\n", i );
+}
