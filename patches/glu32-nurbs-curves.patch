+/* Original synthetic NURBS tests; no vendor data. */
+static unsigned int nurbs_errors;
+static GLenum nurbs_error_codes[16];
+
+static void CALLBACK nurbs_error( GLenum error )
+{
+    if (nurbs_errors < ARRAY_SIZE(nurbs_error_codes)) nurbs_error_codes[nurbs_errors] = error;
+    ++nurbs_errors;
+}
+
+static void reset_nurbs_errors(void)
+{
+    nurbs_errors = 0;
+    memset( nurbs_error_codes, 0, sizeof(nurbs_error_codes) );
+}
+
+static void test_nurbs_properties( GLUnurbs *nurbs )
+{
+    static const struct { GLenum property; GLfloat value; } defaults[] =
+    {
+        {GLU_SAMPLING_TOLERANCE, 50.0f}, {GLU_SAMPLING_METHOD, 6.0f},
+        {GLU_DISPLAY_MODE, GLU_FILL}, {GLU_CULLING, GL_FALSE},
+        {GLU_AUTO_LOAD_MATRIX, GL_TRUE}, {GLU_PARAMETRIC_TOLERANCE, 0.5f},
+        {GLU_U_STEP, 100.0f}, {GLU_V_STEP, 100.0f}
+    };
+    static const struct { const char *name; GLfloat value, expected; GLenum error; } methods[] =
+    {
+        {"PATH_LENGTH", GLU_PATH_LENGTH, 6.0f, 0}, {"PARAMETRIC_ERROR", GLU_PARAMETRIC_ERROR, 5.0f, 0},
+        {"DOMAIN_DISTANCE", GLU_DOMAIN_DISTANCE, 2.0f, 0}, {"INVALID", -1.0f, 2.0f, GLU_INVALID_VALUE}
+    };
+    unsigned int i;
+    GLfloat value;
+
+    gluNurbsCallback( nurbs, GLU_ERROR, (void (CALLBACK *)(void))nurbs_error );
+    for (i = 0; i < ARRAY_SIZE(defaults); ++i)
+    {
+        reset_nurbs_errors();
+        value = -1.0f;
+        gluGetNurbsProperty( nurbs, defaults[i].property, &value );
+        ok( !nurbs_errors, "default property %#x callback count %u\n", defaults[i].property, nurbs_errors );
+        ok( value == defaults[i].value, "property %#x default %.8g expected %.8g\n",
+            defaults[i].property, value, defaults[i].value );
+    }
+    gluNurbsProperty( nurbs, GLU_SAMPLING_TOLERANCE, 7.0f );
+    gluGetNurbsProperty( nurbs, GLU_SAMPLING_TOLERANCE, &value );
+    ok( value == 7.0f, "sampling tolerance round trip %.8g\n", value );
+    for (i = 0; i < ARRAY_SIZE(methods); ++i)
+    {
+        reset_nurbs_errors();
+        gluNurbsProperty( nurbs, GLU_SAMPLING_METHOD, methods[i].value );
+        ok( nurbs_errors == !!methods[i].error, "%s set callback count %u\n", methods[i].name, nurbs_errors );
+        if (methods[i].error && nurbs_errors)
+            ok( nurbs_error_codes[0] == methods[i].error, "%s set error %#x expected %#x\n",
+                methods[i].name, nurbs_error_codes[0], methods[i].error );
+        reset_nurbs_errors();
+        value = -1.0f;
+        gluGetNurbsProperty( nurbs, GLU_SAMPLING_METHOD, &value );
+        ok( !nurbs_errors, "%s get callback count %u\n", methods[i].name, nurbs_errors );
+        ok( value == methods[i].expected, "%s get %.8g expected %.8g\n",
+            methods[i].name, value, methods[i].expected );
+    }
+    gluNurbsProperty( nurbs, GLU_SAMPLING_METHOD, GLU_PATH_LENGTH );
+    reset_nurbs_errors();
+}
