+static void test_nurbs_invalid( GLUnurbs *nurbs )
+{
+    GLfloat knots[] = {0, 0, 1, 1}, descending[] = {0, 1, 0, 1};
+    GLfloat control[] = {-1, 0, 0, 1, 0, 0};
+    GLfloat feedback[64];
+    static const GLenum first_errors[] = {GLU_NURBS_ERROR1, GLU_NURBS_ERROR2, GLU_NURBS_ERROR3};
+    int mode, count;
+
+    gluNurbsCallback( nurbs, GLU_ERROR, (void (CALLBACK *)(void))nurbs_error );
+    for (mode = 0; mode < 3; ++mode)
+    {
+        reset_nurbs_errors();
+        glFeedbackBuffer( ARRAY_SIZE(feedback), GL_3D, feedback );
+        glRenderMode( GL_FEEDBACK );
+        gluBeginCurve( nurbs );
+        gluNurbsCurve( nurbs, mode == 1 ? 3 : 4, mode == 2 ? descending : knots,
+                       3, control, mode == 0 ? 0 : 2, GL_MAP1_VERTEX_3 );
+        ok( nurbs_errors == 1, "invalid case %d after NurbsCurve callbacks %u expected 1\n", mode, nurbs_errors );
+        if (nurbs_errors)
+            ok( nurbs_error_codes[0] == first_errors[mode], "invalid case %d first error %#x expected %#x\n",
+                mode, nurbs_error_codes[0], first_errors[mode] );
+        gluEndCurve( nurbs );
+        count = glRenderMode( GL_RENDER );
+        ok( nurbs_errors == 2, "invalid case %d callback count %u expected 2\n", mode, nurbs_errors );
+        if (nurbs_errors >= 2)
+            ok( nurbs_error_codes[1] == GLU_NURBS_ERROR9, "invalid case %d second error %#x\n",
+                mode, nurbs_error_codes[1] );
+        ok( !count, "invalid case %d emitted %d feedback floats\n", mode, count );
+    }
+}
+
+/* Feedback compares geometry, not implementation-specific segment counts. */
+static void test_nurbs_feedback( GLUnurbs *nurbs )
+{
+    GLfloat linear_knots[] = {0, 0, 1, 1};
+    GLfloat quadratic_knots[] = {0, 0, 0, 1, 1, 1};
+    GLfloat linear[] = {-1, 0, 0, 999, 999, 1, 0, 0, 999, 999};
+    GLfloat quadratic[] = {-1, 0, 0, 0, 1, 0, 1, 0, 0};
+    GLfloat rational[] = {1, 0, 0, 1, 0.70710678f, 0.70710678f, 0, 0.70710678f, 0, 1, 0, 1};
+    static GLfloat feedback[65536];
+    unsigned int curves, vertices, j;
+    int count, i;
+    GLfloat x, y, expected_x, expected_y, last_x = 0, last_y = 0;
+
+    glViewport( 0, 0, 128, 128 );
+    glMatrixMode( GL_PROJECTION );
+    glLoadIdentity();
+    glOrtho( -2, 2, -2, 2, -2, 2 );
+    glMatrixMode( GL_MODELVIEW );
+    glLoadIdentity();
+    gluNurbsProperty( nurbs, GLU_SAMPLING_TOLERANCE, 5.0f );
+    for (curves = 0; curves < 3; ++curves)
+    {
+        nurbs_errors = 0;
+        glFeedbackBuffer( ARRAY_SIZE(feedback), GL_3D, feedback );
+        glRenderMode( GL_FEEDBACK );
+        gluBeginCurve( nurbs );
+        if (!curves) gluNurbsCurve( nurbs, 4, linear_knots, 5, linear, 2, GL_MAP1_VERTEX_3 );
+        else if (curves == 1) gluNurbsCurve( nurbs, 6, quadratic_knots, 3, quadratic, 3, GL_MAP1_VERTEX_3 );
+        else gluNurbsCurve( nurbs, 6, quadratic_knots, 4, rational, 3, GL_MAP1_VERTEX_4 );
+        gluEndCurve( nurbs );
+        count = glRenderMode( GL_RENDER );
+        ok( count > 0, "curve %u feedback count %d\n", curves, count );
+        ok( !nurbs_errors, "curve %u error callbacks %u\n", curves, nurbs_errors );
+        if (count <= 0) continue;
+        vertices = 0;
+        for (i = 0; i < count;)
+        {
+            ok( feedback[i] == GL_LINE_TOKEN || feedback[i] == GL_LINE_RESET_TOKEN,
+                "curve %u unexpected token %.8g\n", curves, feedback[i] );
+            if ((feedback[i] != GL_LINE_TOKEN && feedback[i] != GL_LINE_RESET_TOKEN) || i + 7 > count) break;
+            ++i;
+            for (j = 0; j < 2; ++j, i += 3)
+            {
+                x = (feedback[i] - 64.0f) / 32.0f;
+                y = (feedback[i + 1] - 64.0f) / 32.0f;
+                if (!vertices)
+                {
+                    expected_x = curves == 2 ? 1.0f : -1.0f;
+                    ok( fabs(x - expected_x) < 0.0001 && fabs(y) < 0.0001,
+                        "curve %u first vertex (%.8g, %.8g)\n", curves, x, y );
+                }
+                if (!curves) ok( fabs(y) < 0.0001, "line vertex y %.8g\n", y );
+                else if (curves == 1) ok( fabs(y - (1 - x*x) / 2) < 0.0001,
+                    "quadratic vertex (%.8g, %.8g)\n", x, y );
+                else ok( fabs(x*x + y*y - 1) < 0.0002 && x >= -0.0001 && y >= -0.0001,
+                    "rational vertex (%.8g, %.8g)\n", x, y );
+                ok( fabs(feedback[i + 2] - 0.5f) < 0.0001, "unexpected depth %.8g\n", feedback[i + 2] );
+                last_x = x;
+                last_y = y;
+                ++vertices;
+            }
+        }
+        expected_x = curves == 2 ? 0.0f : 1.0f;
+        expected_y = curves == 2 ? 1.0f : 0.0f;
+        ok( i == count, "curve %u incomplete feedback parse %d/%d\n", curves, i, count );
+        ok( vertices >= (curves ? 4 : 2), "curve %u too few vertices %u\n", curves, vertices );
+        ok( fabs(last_x - expected_x) < 0.0001 && fabs(last_y - expected_y) < 0.0001,
+            "curve %u final vertex (%.8g, %.8g)\n", curves, last_x, last_y );
+    }
+}
