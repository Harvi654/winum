+/* Curve-only NURBS implementation, written from the de Boor recurrence.
+ * No Mesa/SGI implementation code is used here. */
+struct nurbs_vertex
+{
+    GLdouble position[3];
+    BOOL start;
+};
+
+struct GLUnurbs
+{
+    GLfloat sampling_tolerance, parametric_tolerance, u_step, v_step;
+    GLenum sampling_method, display_mode;
+    BOOL culling, auto_load_matrix, in_curve, failed;
+    void (CALLBACK *error)(GLenum);
+    GLdouble model[16], projection[16];
+    GLint viewport[4];
+    GLdouble *knots, *control, *work;
+    GLint order, count;
+    struct nurbs_vertex *vertices;
+    SIZE_T vertex_count, vertex_capacity, span_limit;
+};
+
+#define NURBS_MAX_VERTICES 65536
+#define NURBS_MAX_DEPTH 16
+
+static void nurbs_error( GLUnurbs *nobj, GLenum error )
+{
+    nobj->failed = TRUE;
+    if (nobj->error) nobj->error( error );
+}
+
+static void nurbs_clear_curve( GLUnurbs *nobj )
+{
+    free( nobj->knots );
+    free( nobj->control );
+    free( nobj->work );
+    free( nobj->vertices );
+    nobj->knots = nobj->control = nobj->work = NULL;
+    nobj->vertices = NULL;
+    nobj->vertex_count = nobj->vertex_capacity = 0;
+}
+
+/* Evaluate one nonempty knot span in homogeneous coordinates. */
+static BOOL nurbs_evaluate( GLUnurbs *nobj, GLint span, GLdouble t, GLdouble point[3] )
+{
+    GLint i, r, j, component;
+    GLdouble denominator, alpha, *a, *b;
+
+    for (j = 0; j < nobj->order; ++j)
+        memcpy( nobj->work + 4 * (SIZE_T)j, nobj->control + 4 * (SIZE_T)(span - nobj->order + 1 + j), 4 * sizeof(GLdouble) );
+    for (r = 1; r < nobj->order; ++r)
+        for (j = nobj->order - 1; j >= r; --j)
+        {
+            i = span - nobj->order + 1 + j;
+            denominator = nobj->knots[i + nobj->order - r] - nobj->knots[i];
+            alpha = denominator ? (t - nobj->knots[i]) / denominator : 0;
+            a = nobj->work + 4 * (SIZE_T)(j - 1);
+            b = nobj->work + 4 * (SIZE_T)j;
+            for (component = 0; component < 4; ++component) b[component] = (1 - alpha) * a[component] + alpha * b[component];
+        }
+    b = nobj->work + 4 * (SIZE_T)(nobj->order - 1);
+    if (!b[3] || !isfinite(b[3])) return FALSE;
+    for (component = 0; component < 3; ++component)
+    {
+        point[component] = b[component] / b[3];
+        if (!isfinite(point[component])) return FALSE;
+    }
+    return TRUE;
+}
+
+static BOOL nurbs_project( GLUnurbs *nobj, const GLdouble point[3], GLdouble screen[2] )
+{
+    GLdouble eye[4], clip[4];
+    unsigned int i;
+
+    for (i = 0; i < 4; ++i)
+        eye[i] = nobj->model[i] * point[0] + nobj->model[4+i] * point[1] +
+                 nobj->model[8+i] * point[2] + nobj->model[12+i];
+    for (i = 0; i < 4; ++i)
+        clip[i] = nobj->projection[i] * eye[0] + nobj->projection[4+i] * eye[1] +
+                  nobj->projection[8+i] * eye[2] + nobj->projection[12+i] * eye[3];
+    if (!clip[3]) return FALSE;
+    for (i = 0; i < 2; ++i)
+    {
+        screen[i] = clip[i] / clip[3] * nobj->viewport[i+2] * 0.5;
+        if (!isfinite(screen[i])) return FALSE;
+    }
+    return TRUE;
+}
+
+static BOOL nurbs_append( GLUnurbs *nobj, const GLdouble point[3], BOOL start )
+{
+    struct nurbs_vertex *vertices;
+    SIZE_T capacity;
+
+    if (nobj->vertex_count == nobj->vertex_capacity)
+    {
+        if (nobj->vertex_capacity > SIZE_MAX / (2 * sizeof(*vertices))) return FALSE;
+        capacity = nobj->vertex_capacity ? nobj->vertex_capacity * 2 : 128;
+        if (!(vertices = realloc( nobj->vertices, capacity * sizeof(*vertices) ))) return FALSE;
+        nobj->vertices = vertices;
+        nobj->vertex_capacity = capacity;
+    }
+    memcpy( nobj->vertices[nobj->vertex_count].position, point, 3 * sizeof(GLdouble) );
+    nobj->vertices[nobj->vertex_count++].start = start;
+    return TRUE;
+}
+
+/* Fixed parameter subdivision avoids division by clip w at the eye plane.
+ * It is also used for DOMAIN_DISTANCE. OpenGL still performs real clipping. */
+static BOOL nurbs_uniform( GLUnurbs *nobj, GLint span, GLdouble left, GLdouble right, unsigned int segments )
+{
+    GLdouble point[3], t;
+    SIZE_T available = nobj->span_limit - nobj->vertex_count - 1;
+    unsigned int i;
+
+    if (!available) return TRUE;
+    if (segments > available) segments = available;
+    if (!segments) segments = 1;
+    for (i = 1; i <= segments; ++i)
+    {
+        t = i == segments ? right : left + (right - left) * ((GLdouble)i / segments);
+        if (!nurbs_evaluate( nobj, span, t, point ) || !nurbs_append( nobj, point, FALSE )) return FALSE;
+    }
+    return TRUE;
+}
+
+/* PATH_LENGTH bounds projected segment length; quarter-point probes also
+ * detect curvature/inflections. At depth/detail limits retain the endpoint,
+ * trading sampling quality for visibility instead of dropping the curve. */
+static BOOL nurbs_subdivide( GLUnurbs *nobj, GLint span, GLdouble left, GLdouble right,
+                            const GLdouble a[3], const GLdouble b[3], unsigned int depth )
+{
+    GLdouble probes[3][3], screen_a[2], screen_b[2], screen[2], delta, error = 0;
+    GLdouble fraction, length;
+    unsigned int i, j;
+
+    /* Leave one slot for the span's endpoint, appended by EndCurve even if
+     * remaining recursive intervals cannot add any more detail. */
+    if (nobj->vertex_count + 1 >= nobj->span_limit) return TRUE;
+    if (depth == NURBS_MAX_DEPTH ||
+        left + (right - left) * 0.5 == left || left + (right - left) * 0.5 == right)
+        return nurbs_append( nobj, b, FALSE );
+    if (!nurbs_project( nobj, a, screen_a ) || !nurbs_project( nobj, b, screen_b )) goto uniform;
+    for (i = 0; i < 3; ++i)
+    {
+        fraction = (i + 1) * 0.25;
+        if (!nurbs_evaluate( nobj, span, left + (right - left) * fraction, probes[i] )) return FALSE;
+        if (!nurbs_project( nobj, probes[i], screen )) goto uniform;
+        delta = 0;
+        for (j = 0; j < 2; ++j)
+            delta += pow( screen[j] - (screen_a[j] + (screen_b[j] - screen_a[j]) * fraction), 2 );
+        if (delta > error) error = delta;
+    }
+    length = pow( screen_b[0] - screen_a[0], 2 ) + pow( screen_b[1] - screen_a[1], 2 );
+    if ((unsigned int)nobj->order <= (1u << depth) &&
+        (nobj->sampling_method != GLU_PATH_LENGTH || length <= pow(nobj->sampling_tolerance, 2)) &&
+        error <= pow(nobj->sampling_method == GLU_PARAMETRIC_ERROR ? nobj->parametric_tolerance : nobj->sampling_tolerance * 0.25, 2))
+        return nurbs_append( nobj, b, FALSE );
+    return nurbs_subdivide( nobj, span, left, left + (right - left) * 0.5, a, probes[1], depth + 1 ) &&
+           nurbs_subdivide( nobj, span, left + (right - left) * 0.5, right, probes[1], b, depth + 1 );
+uniform:
+    return nurbs_uniform( nobj, span, left, right, nobj->order > 64 ? 256 : nobj->order < 2 ? 8 : nobj->order * 4 );
+}
+
+static void nurbs_unsupported( GLUnurbs *nobj )
+{
+    FIXME( "NURBS surfaces and trimming are not implemented.\n" );
+    if (nobj) nurbs_error( nobj, GLU_NURBS_ERROR35 );
+}
+
