+
+#ifndef STANDALONE
+static char own_ca_path[MAX_PATH];
+#endif
+
+static unsigned int feature_count(const struct variant *variant)
+{
+    return ARRAY_SIZE(features) + (variant->chain_order ? ARRAY_SIZE(chain_features) : 0);
+}
+
+static const struct feature *get_feature(unsigned int index)
+{
+    return index < ARRAY_SIZE(features) ? features + index : chain_features + index - ARRAY_SIZE(features);
+}
+
+static UINT execute(MSIHANDLE db, const char *sql)
+{
+    MSIHANDLE view = 0;
+    UINT result = MsiDatabaseOpenViewA(db, sql, &view);
+    if (!result) result = MsiViewExecute(view, 0);
+    if (view) MsiCloseHandle(view);
+    return result;
+}
+
+static BOOL new_guid(char *text)
+{
+    GUID guid;
+    WCHAR wide[39];
+    HRESULT hr = CoCreateGuid(&guid);
+    ok(hr == S_OK, "CoCreateGuid returned %#lx\n", hr);
+    if (hr != S_OK) return FALSE;
+    StringFromGUID2(&guid, wide, ARRAY_SIZE(wide));
+    return !!WideCharToMultiByte(CP_ACP, 0, wide, -1, text, 39, NULL, NULL);
+}
+
+static UINT insert_feature(MSIHANDLE db, const struct variant *variant, unsigned int index)
+{
+    const struct feature *feature = get_feature(index);
+    unsigned int level = feature->level, attributes = feature->attributes;
+    char sql[1024];
+
+    if (!strcmp(feature->name, "Loose")) { level = variant->loose_level; attributes = variant->loose_attributes; }
+    if (!strcmp(feature->name, "SWFiles")) attributes = variant->swfiles_attributes;
+    if (!strcmp(feature->name, "Other")) attributes = variant->other_attributes;
+    if (variant->level_probe && (!strcmp(feature->name, "DFChild") || !strcmp(feature->name, "FWChild")))
+    {
+        level = 200;
+        attributes = 8;
+    }
+    if (variant->nonfp_probe && (!strcmp(feature->name, "DFGrandchild") || !strcmp(feature->name, "FWGrandchild")))
+        attributes = 8;
+    if (feature->parent)
+        sprintf(sql, "INSERT INTO `Feature` (`Feature`,`Feature_Parent`,`Title`,`Display`,`Level`,`Directory_`,`Attributes`) VALUES ('%s','%s','%s',%u,%u,'PROBEDIR',%u)",
+                feature->name, feature->parent, feature->name, index + 1, level, attributes);
+    else
+        sprintf(sql, "INSERT INTO `Feature` (`Feature`,`Title`,`Display`,`Level`,`Directory_`,`Attributes`) VALUES ('%s','%s',%u,%u,'PROBEDIR',%u)",
+                feature->name, feature->name, index + 1, level, attributes);
+    return execute(db, sql);
+}
+
+static UINT insert_own_ca(MSIHANDLE db)
+{
+    char path[MAX_PATH], *slash;
+    MSIHANDLE view = 0, record = 0;
+    UINT result;
+#ifdef STANDALONE
+    DWORD size = GetModuleFileNameA(NULL, path, sizeof(path));
+    if (!size || size >= sizeof(path) || !(slash = strrchr(path, '\\'))) return ERROR_INVALID_DATA;
+    *++slash = 0;
+    if (strlen(path) + 40 >= sizeof(path)) return ERROR_INVALID_DATA;
+    strcat(path, sizeof(void *) == 8 ? "msi-feature-ca-x86_64.dll" : "msi-feature-ca-i686.dll");
+#else
+    (void)slash;
+    strcpy(path, own_ca_path);
+#endif
+    result = execute(db, "CREATE TABLE `Binary` (`Name` CHAR(72) NOT NULL, `Data` OBJECT NOT NULL PRIMARY KEY `Name`)");
+    if (!result) result = execute(db, "CREATE TABLE `CustomAction` (`Action` CHAR(72) NOT NULL, `Type` SHORT NOT NULL, `Source` CHAR(72), `Target` CHAR(255) PRIMARY KEY `Action`)");
+    if (result) return result;
+    result = MsiDatabaseOpenViewA(db, "INSERT INTO `Binary` (`Name`,`Data`) VALUES ('OwnFeatureStateCA', ?)", &view);
+    if (result) goto done;
+    record = MsiCreateRecord(1);
+    if (!record) { result = ERROR_OUTOFMEMORY; goto done; }
+    result = MsiRecordSetStreamA(record, 1, path);
+    if (!result) result = MsiViewExecute(view, record);
+    if (!result) result = execute(db, "INSERT INTO `CustomAction` (`Action`,`Type`,`Source`,`Target`) VALUES ('OwnSetFeatures',1,'OwnFeatureStateCA','ProbeFeatureStates')");
+    if (!result) result = execute(db, "INSERT INTO `InstallExecuteSequence` (`Action`,`Condition`,`Sequence`) VALUES ('OwnSetFeatures','NOT REMOVE',1100)");
+done:
+    if (record) MsiCloseHandle(record);
+    if (view) MsiCloseHandle(view);
+    return result;
+}
