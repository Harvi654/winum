+static BOOL create_package(const char *path, const char *product, const struct variant *variant)
+{
+    static const char *schema[] =
+    {
+        "CREATE TABLE `Property` (`Property` CHAR(72) NOT NULL, `Value` CHAR(0) LOCALIZABLE PRIMARY KEY `Property`)",
+        "CREATE TABLE `Directory` (`Directory` CHAR(72) NOT NULL, `Directory_Parent` CHAR(72), `DefaultDir` CHAR(255) NOT NULL PRIMARY KEY `Directory`)",
+        "CREATE TABLE `Feature` (`Feature` CHAR(38) NOT NULL, `Feature_Parent` CHAR(38), `Title` CHAR(64), `Description` CHAR(255), `Display` SHORT, `Level` SHORT, `Directory_` CHAR(72), `Attributes` SHORT PRIMARY KEY `Feature`)",
+        "CREATE TABLE `Component` (`Component` CHAR(72) NOT NULL, `ComponentId` CHAR(38), `Directory_` CHAR(72), `Attributes` SHORT, `Condition` CHAR(255), `KeyPath` CHAR(72) PRIMARY KEY `Component`)",
+        "CREATE TABLE `FeatureComponents` (`Feature_` CHAR(38) NOT NULL, `Component_` CHAR(72) NOT NULL PRIMARY KEY `Feature_`, `Component_`)",
+        /* Windows' RegisterProduct reads Media (2228 without it); one empty disk. */
+        "CREATE TABLE `Media` (`DiskId` SHORT NOT NULL, `LastSequence` SHORT NOT NULL, `DiskPrompt` CHAR(64), `Cabinet` CHAR(255), `VolumeLabel` CHAR(32), `Source` CHAR(72) PRIMARY KEY `DiskId`)",
+        "INSERT INTO `Media` (`DiskId`,`LastSequence`) VALUES (1,0)",
+        "CREATE TABLE `InstallExecuteSequence` (`Action` CHAR(72) NOT NULL, `Condition` CHAR(255), `Sequence` SHORT PRIMARY KEY `Action`)",
+        "INSERT INTO `Property` (`Property`,`Value`) VALUES ('ProductName','Synthetic feature selection probe')",
+        "INSERT INTO `Property` (`Property`,`Value`) VALUES ('Manufacturer','Synthetic MSI tests')",
+        "INSERT INTO `Property` (`Property`,`Value`) VALUES ('ProductVersion','1.0.0')",
+        "INSERT INTO `Property` (`Property`,`Value`) VALUES ('ProductLanguage','1033')",
+        "INSERT INTO `Property` (`Property`,`Value`) VALUES ('INSTALLLEVEL','100')",
+        "INSERT INTO `Directory` (`Directory`,`DefaultDir`) VALUES ('TARGETDIR','SourceDir')",
+        "INSERT INTO `Directory` (`Directory`,`Directory_Parent`,`DefaultDir`) VALUES ('PROBEDIR','TARGETDIR','FeatureProbe')"
+    };
+    static const struct { const char *name; unsigned int sequence; } actions[] =
+    {
+        {"CostInitialize", 800}, {"FileCost", 900}, {"CostFinalize", 1000},
+        {"InstallValidate", 1400}, {"InstallInitialize", 1500},
+        {"ProcessComponents", 1600}, {"UnpublishFeatures", 1800},
+        {"RegisterProduct", 6100}, {"PublishFeatures", 6300},
+        {"PublishProduct", 6400}, {"InstallFinalize", 6600}
+    };
+    MSIHANDLE db = 0, summary = 0;
+    char sql[1024], guid[39];
+    unsigned int i, index, count = feature_count(variant);
+    const struct feature *feature;
+    UINT result;
+    BOOL success = FALSE;
+
+    result = MsiOpenDatabaseA(path, (LPCSTR)MSIDBOPEN_CREATE, &db);
+    ok(result == ERROR_SUCCESS, "create database returned %u\n", result);
+    if (result) return FALSE;
+#define EXEC_SQL(statement) do { result = execute(db, statement); \
+    ok(result == ERROR_SUCCESS, "database statement returned %u\n", result); \
+    if (result) goto done; } while (0)
+    for (i = 0; i < ARRAY_SIZE(schema); ++i) EXEC_SQL(schema[i]);
+    sprintf(sql, "INSERT INTO `Property` (`Property`,`Value`) VALUES ('ProductCode','%s')", product);
+    EXEC_SQL(sql);
+    if (variant->chain_order)
+    {
+        /* Only the six chain Feature rows change order, not Component or
+         * FeatureComponents insertion, names, Display, attributes or selection. */
+        for (i = 0; i < count; ++i)
+        {
+            index = i;
+            if (variant->chain_order == 2 && i >= ARRAY_SIZE(features))
+                index = ARRAY_SIZE(features) + ((i - ARRAY_SIZE(features)) / 3) * 3 +
+                        2 - (i - ARRAY_SIZE(features)) % 3;
+            result = insert_feature(db, variant, index);
+            ok(!result, "feature row returned %u\n", result);
+            if (result) goto done;
+        }
+    }
+    for (i = 0; i < count; ++i)
+    {
+        feature = get_feature(i);
+        if (!variant->chain_order)
+        {
+            result = insert_feature(db, variant, i);
+            ok(!result, "feature row returned %u\n", result);
+            if (result) goto done;
+        }
+        if (!new_guid(guid)) goto done;
+        /* Empty components: directory key path, unique GUID, no File/Registry rows. */
+        sprintf(sql, "INSERT INTO `Component` (`Component`,`ComponentId`,`Directory_`,`Attributes`) VALUES ('C_%s','%s','PROBEDIR',0)", feature->name, guid);
+        EXEC_SQL(sql);
+        sprintf(sql, "INSERT INTO `FeatureComponents` (`Feature_`,`Component_`) VALUES ('%s','C_%s')", feature->name, feature->name);
+        EXEC_SQL(sql);
+    }
+    for (i = 0; i < ARRAY_SIZE(actions); ++i)
+    {
+        sprintf(sql, "INSERT INTO `InstallExecuteSequence` (`Action`,`Sequence`) VALUES ('%s',%u)", actions[i].name, actions[i].sequence);
+        EXEC_SQL(sql);
+    }
+    if (variant->ca_mode == 2)
+    {
+        result = insert_own_ca(db);
+        ok(!result, "embed our synthetic CA returned %u\n", result);
+        if (result) goto done;
+    }
+#undef EXEC_SQL
+    if (!new_guid(guid)) goto done;
+    result = MsiGetSummaryInformationA(db, NULL, 5, &summary);
+    ok(!result, "open summary returned %u\n", result);
+    if (result) goto done;
+#define SUMMARY(call) do { result = (call); ok(!result, "summary returned %u\n", result); if (result) goto done; } while (0)
+    SUMMARY(MsiSummaryInfoSetPropertyA(summary, 7, VT_LPSTR, 0, NULL, variant->ca_mode && sizeof(void *) == 8 ? "x64;1033" : "Intel;1033"));
+    SUMMARY(MsiSummaryInfoSetPropertyA(summary, 9, VT_LPSTR, 0, NULL, guid));
+    SUMMARY(MsiSummaryInfoSetPropertyA(summary, 14, VT_I4, 200, NULL, NULL));
+    SUMMARY(MsiSummaryInfoSetPropertyA(summary, 15, VT_I4, 0, NULL, NULL));
+    SUMMARY(MsiSummaryInfoPersist(summary));
+    SUMMARY(MsiDatabaseCommit(db));
+#undef SUMMARY
+    success = TRUE;
+done:
+    if (summary) MsiCloseHandle(summary);
+    MsiCloseHandle(db);
+    return success;
+}
+
+/* Reopen the persisted source: INSERT order is not a promise of enumeration
+ * order. Record only known synthetic names, without path or database contents. */
+static BOOL trace_feature_order(const char *path, const struct variant *variant)
+{
+    MSIHANDLE db = 0, view = 0, record = 0;
+    char name[73];
+    DWORD size;
+    UINT result;
+    unsigned int i, count = feature_count(variant), ordinal = 0;
+    BOOL success = FALSE, seen[ARRAY_SIZE(features) + ARRAY_SIZE(chain_features)] = {0};
+
+    result = MsiOpenDatabaseA(path, (LPCSTR)MSIDBOPEN_READONLY, &db);
+    ok(!result, "reopen row-order database returned %u\n", result);
+    if (result) return FALSE;
+    result = MsiDatabaseOpenViewA(db, "SELECT `Feature` FROM `Feature`", &view);
+    ok(!result, "open row-order query returned %u\n", result);
+    if (result) goto done;
+    result = MsiViewExecute(view, 0);
+    ok(!result, "execute row-order query returned %u\n", result);
+    if (result) goto done;
+    while ((result = MsiViewFetch(view, &record)) == ERROR_SUCCESS)
+    {
+        size = sizeof(name);
+        result = MsiRecordGetStringA(record, 1, name, &size);
+        MsiCloseHandle(record); record = 0;
+        ok(!result, "read row-order identifier returned %u\n", result);
+        if (result) goto done;
+        for (i = 0; i < count; ++i) if (!strcmp(name, get_feature(i)->name)) break;
+        ok(i < count, "unexpected synthetic row-order identifier\n");
+        if (i == count) goto done;
+        ok(!seen[i], "duplicate synthetic row-order identifier\n");
+        if (seen[i]) goto done;
+        seen[i] = TRUE;
+        trace("ROW %s ordinal=%u feature=%s\n", variant->name, ++ordinal, get_feature(i)->name);
+    }
+    ok(result == ERROR_NO_MORE_ITEMS, "row-order fetch ended with %u\n", result);
+    ok(ordinal == count, "row-order count %u expected %u\n", ordinal, count);
+    success = result == ERROR_NO_MORE_ITEMS && ordinal == count;
+done:
+    if (view) MsiCloseHandle(view);
+    MsiCloseHandle(db);
+    return success;
+}
+
+static const char *state_name(INSTALLSTATE state)
+{
+    switch (state)
+    {
+    case INSTALLSTATE_UNKNOWN: return "Unknown";
+    case INSTALLSTATE_ABSENT: return "Absent";
+    case INSTALLSTATE_LOCAL: return "Local";
+    case INSTALLSTATE_SOURCE: return "Source";
+    case INSTALLSTATE_ADVERTISED: return "Advertised";
+    case INSTALLSTATE_BROKEN: return "Broken";
+    default: return "Other";
+    }
+}
+
+/* Failure diagnosis without raw logs: only action names and numeric message
+ * codes are traced, never message text, arguments or paths. */
+static char last_action[73];
+static unsigned int ca_reports[2];
+static unsigned int descendant_reports[2];
+static BOOL ca_bad_report;
+
+
+static void trace_code(const char *kind, const char *text)
+{
+    unsigned int code;
+    if (text && sscanf(text, "%u", &code) == 1 && code >= 1000 && code < 30000)
+        trace("MSGCODE %s code=%u last_action=%s\n", kind, code, last_action);
+}
+
+static INT CALLBACK ui_handler(void *context, UINT type, const char *message)
+{
+    const UINT kind = type & 0xff000000;
+    const char *p;
+    unsigned int i;
+
+    (void)context;
+    if (!message) return 0;
+    if (!strncmp(message, "V10DESC ", 8))
+    {
+        char name[73];
+        unsigned int before, after, index;
+        int bi, ba, ai, aa, end = 0;
+        if (sscanf(message, "V10DESC name=%72s before_rc=%u before_installed=%d before_action=%d after_rc=%u after_installed=%d after_action=%d%n",
+                   name, &before, &bi, &ba, &after, &ai, &aa, &end) != 7 || message[end] ||
+            (strcmp(name, "FWGrandchild") && strcmp(name, "DFGrandchild")) ||
+            bi < -7 || bi > 5 || ba < -7 || ba > 5 || ai < -7 || ai > 5 || aa < -7 || aa > 5)
+        { ca_bad_report = TRUE; return 0; }
+        index = !strcmp(name, "FWGrandchild") ? 0 : 1;
+        descendant_reports[index]++;
+        /* Both return codes and before/after states are native measurements. */
+        trace("DESC feature=%s before_rc=%u before_installed=%d before_action=%d after_rc=%u after_installed=%d after_action=%d\n",
+              name, before, bi, ba, after, ai, aa);
+        return 0;
+    }
+    if (!strncmp(message, "V7CA ", 5))
+    {
+        char name[73];
+        unsigned int set, before, after, index;
+        int bi, ba, ai, aa, end = 0;
+        if (sscanf(message, "V7CA name=%72s set_rc=%u before_rc=%u before_installed=%d before_action=%d after_rc=%u after_installed=%d after_action=%d%n",
+                   name, &set, &before, &bi, &ba, &after, &ai, &aa, &end) != 8 || message[end] ||
+            (strcmp(name, "FWChild") && strcmp(name, "DFChild")) ||
+            bi < -7 || bi > 5 || ba < -7 || ba > 5 || ai < -7 || ai > 5 || aa < -7 || aa > 5)
+        { ca_bad_report = TRUE; return 0; }
+        ok(set == ERROR_SUCCESS, "CA %s Set returned %u\n", name, set);
+        ok(before == ERROR_SUCCESS, "CA %s Get(before) returned %u\n", name, before);
+        ok(after == ERROR_SUCCESS, "CA %s Get(after) returned %u\n", name, after);
+        ok(aa == INSTALLSTATE_LOCAL, "CA %s action after Set %d\n", name, aa);
+        index = !strcmp(name, "FWChild") ? 0 : 1;
+        ca_reports[index]++;
+        trace("CA feature=%s set_rc=%u before_rc=%u before_installed=%d before_action=%d after_rc=%u after_installed=%d after_action=%d\n",
+              name, set, before, bi, ba, after, ai, aa);
+        return 0;
+    }
+    if (kind == INSTALLMESSAGE_ACTIONSTART)
+    {
+        /* "Action hh:mm:ss: Name. Description" */
+        if ((p = strstr(message, ": ")))
+        {
+            p += 2;
+            for (i = 0; i < sizeof(last_action) - 1 && (isalnum((unsigned char)p[i]) || p[i] == '_'); ++i)
+                last_action[i] = p[i];
+            last_action[i] = 0;
+        }
+    }
+    else if (kind == INSTALLMESSAGE_ERROR || kind == INSTALLMESSAGE_FATALEXIT || kind == INSTALLMESSAGE_WARNING)
+    {
+        trace_code(kind == INSTALLMESSAGE_WARNING ? "warning" : "error",
+                   (p = strstr(message, "Error ")) ? p + 6 : NULL);
+    }
+    else if (kind == INSTALLMESSAGE_INFO)
+    {
+        if (strstr(message, "Return value 3")) trace("FAILED action=%s\n", last_action);
+        if ((p = strstr(message, "Note: 1: "))) trace_code("note", p + 9);
+        if ((p = strstr(message, "DEBUG: Error "))) trace_code("debug", p + 13);
+        /* 2228 names a missing table; an identifier is safe to print. */
+        if ((p = strstr(message, "Unknown table '")))
+        {
+            char table[73];
+            p += 15;
+            for (i = 0; i < sizeof(table) - 1 && (isalnum((unsigned char)p[i]) || p[i] == '_'); ++i) table[i] = p[i];
+            table[i] = 0;
+            if (p[i] == '\'') trace("MISSING table=%s last_action=%s\n", table, last_action);
+        }
+    }
+    return 0;
+}
+
+static void test_variant(const char *directory, const struct variant *variant)
+{
+    char path[MAX_PATH], product[39], command[2 * MAX_PATH];
+    INSTALLSTATE state;
+    unsigned int i;
+    UINT result;
+
+    winetest_push_context("%s", variant->name);
+    if (!new_guid(product)) goto done;
+    if (snprintf(path, sizeof(path), "%s\\probe.msi", directory) >= (int)sizeof(path))
+    {
+        ok(0, "temporary path too long\n");
+        goto done;
+    }
+    state = MsiQueryProductStateA(product);
+    ok(state == INSTALLSTATE_UNKNOWN, "fresh product state %d\n", state);
+    if (!create_package(path, product, variant)) goto delete_file;
+    if (variant->chain_order && !trace_feature_order(path, variant)) goto delete_file;
+    /* Private temp directory on C: / Wine C:; never a path from model/media data. */
+    if (snprintf(command, sizeof(command), "ALLUSERS=1 INSTALLLEVEL=100 %s PROBEDIR=\"%s\\empty\"",
+                 variant->selection, directory) >= (int)sizeof(command))
+    {
+        ok(0, "command line too long\n");
+        goto delete_file;
+    }
+    trace("BEGIN %s INSTALLLEVEL=100 ALLUSERS=1 %s Loose.level=%u Loose.attr=%u SWFiles.attr=%u Other.attr=%u chain_order=%u ca_mode=%u package_bits=%u level_probe=%u nonfp_probe=%u\n",
+          variant->name, variant->selection, variant->loose_level, variant->loose_attributes,
+          variant->swfiles_attributes, variant->other_attributes, variant->chain_order, variant->ca_mode,
+          variant->ca_mode && sizeof(void *) == 8 ? 64 : 32, variant->level_probe, variant->nonfp_probe);
+    last_action[0] = 0; ca_reports[0] = ca_reports[1] = 0; ca_bad_report = FALSE;
+    descendant_reports[0] = descendant_reports[1] = 0;
+    result = MsiInstallProductA(path, command);
+    if (result) trace("install failed: last_action=%s\n", last_action);
+    ok(result == ERROR_SUCCESS, "install returned %u\n", result);
+    if (variant->ca_mode == 2)
+    {
+        ok(!ca_bad_report, "invalid synthetic CA report\n");
+        ok(ca_reports[0] == 1 && ca_reports[1] == 1, "CA reports FWChild=%u DFChild=%u expected one each\n", ca_reports[0], ca_reports[1]);
+        ok(descendant_reports[0] == 1 && descendant_reports[1] == 1,
+           "DESC reports FWGrandchild=%u DFGrandchild=%u expected one each\n",
+           descendant_reports[0], descendant_reports[1]);
+    }
+    if (!result)
+    {
+        for (i = 0; i < feature_count(variant); ++i)
+        {
+            state = MsiQueryFeatureStateA(product, get_feature(i)->name);
+            todo_wine_if(todo_states[variant - variants][i] & ~SELECTION_FIXED_RULES)
+            ok(state == expected_states[variant - variants][i],
+               "feature %s state %d (%s), expected %d\n", get_feature(i)->name, state,
+               state_name(state), expected_states[variant - variants][i]);
+        }
+    }
+    /* Also attempt cleanup after a failed/partially registered installation. */
+    state = MsiQueryProductStateA(product);
+    if (state != INSTALLSTATE_UNKNOWN)
+    {
+        result = MsiConfigureProductExA(product, INSTALLLEVEL_DEFAULT, INSTALLSTATE_ABSENT, "REMOVE=ALL");
+        ok(result == ERROR_SUCCESS, "uninstall returned %u\n", result);
+    }
+    state = MsiQueryProductStateA(product);
+    ok(state == INSTALLSTATE_UNKNOWN, "product remains registered after cleanup: %d\n", state);
+    for (i = 0; i < feature_count(variant); ++i)
+    {
+        state = MsiQueryFeatureStateA(product, get_feature(i)->name);
+        ok(state == INSTALLSTATE_UNKNOWN, "feature %s remains after uninstall: %d\n", get_feature(i)->name, state);
+    }
+    trace("END %s cleanup_product_state=%d\n", variant->name, MsiQueryProductStateA(product));
+delete_file:
+    result = DeleteFileA(path);
+    ok(result || GetLastError() == ERROR_FILE_NOT_FOUND, "delete synthetic MSI failed: %lu\n", GetLastError());
+done:
+    winetest_pop_context();
+}
+
+START_TEST(selection)
+{
+    char temp[MAX_PATH], directory[MAX_PATH];
+    DWORD length;
+    unsigned int i;
+    INSTALLUILEVEL previous;
+    INSTALLUI_HANDLERA previous_handler;
+    BOOL result;
+
+    /* A measurement must not lose rows to Wine's default per-line limit (42). */
+#ifdef STANDALONE
+    winetest_mute_threshold = 1000;
+    if (winetest_debug < 1) winetest_debug = 1;
+#endif
+    trace("Synthetic selection conformance v10 arch=%u platform=%s; non-FP descendants measured separately\n",
+          (unsigned int)(8 * sizeof(void *)), winetest_platform);
+    length = GetTempPathA(ARRAY_SIZE(temp), temp);
+    ok(length && length < ARRAY_SIZE(temp) - 24, "temporary directory unavailable\n");
+    if (!length || length >= ARRAY_SIZE(temp) - 24) return;
+    /* Avoid generating even synthetic MSI files in the shared Z: folder. */
+    ok((temp[0] == 'C' || temp[0] == 'c') && temp[1] == ':', "TEMP must be on C: for this measurement\n");
+    if ((temp[0] != 'C' && temp[0] != 'c') || temp[1] != ':') return;
+    result = GetTempFileNameA(temp, "mfs", 0, directory);
+    ok(result, "reserve private temporary name failed: %lu\n", GetLastError());
+    if (!result) return;
+    DeleteFileA(directory);
+    result = CreateDirectoryA(directory, NULL);
+    ok(result, "create temporary directory failed: %lu\n", GetLastError());
+    if (!result) return;
+#ifndef STANDALONE
+    {
+        HRSRC resource = FindResourceA(NULL, "selection_ca.dll", "TESTDLL");
+        const void *data;
+        HANDLE file;
+        DWORD written, size;
+        ok(!!resource, "missing own CA resource\n");
+        if (!resource) goto cleanup_directory;
+        data = LockResource(LoadResource(NULL, resource));
+        size = SizeofResource(NULL, resource);
+        snprintf(own_ca_path, sizeof(own_ca_path), "%s\\own-ca.dll", directory);
+        file = CreateFileA(own_ca_path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL);
+        ok(file != INVALID_HANDLE_VALUE, "create own CA file failed %lu\n", GetLastError());
+        if (file == INVALID_HANDLE_VALUE) goto cleanup_directory;
+        result = WriteFile(file, data, size, &written, NULL);
+        CloseHandle(file);
+        ok(result && written == size, "write own CA file failed\n");
+        if (!result || written != size) goto cleanup_directory;
+    }
+#endif
+    previous = MsiSetInternalUI(INSTALLUILEVEL_NONE, NULL);
+    previous_handler = MsiSetExternalUIA(ui_handler, INSTALLLOGMODE_ACTIONSTART | INSTALLLOGMODE_ERROR |
+                                         INSTALLLOGMODE_FATALEXIT | INSTALLLOGMODE_WARNING | INSTALLLOGMODE_INFO, NULL);
+    for (i = 0; i < ARRAY_SIZE(variants); ++i) test_variant(directory, &variants[i]);
+    MsiSetExternalUIA(previous_handler, 0, NULL);
+    MsiSetInternalUI(previous, NULL);
+#ifndef STANDALONE
+cleanup_directory:
+    DeleteFileA(own_ca_path);
+#endif
+    /* No CreateFolders/InstallFiles actions: no payload directory is created. */
+    result = RemoveDirectoryA(directory);
+    ok(result, "remove temporary directory failed: %lu\n", GetLastError());
+}
