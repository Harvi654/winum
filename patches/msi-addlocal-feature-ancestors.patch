From: Harvi654 <202698022+Harvi654@users.noreply.github.com>
Subject: [PATCH] msi: Select ADDLOCAL ancestors and required descendants.

AI-assisted (Codex), original code; LGPL-2.1-or-later.

On a fresh installation, select the ancestors of ADDLOCAL features and
recursively select UIDisallowAbsent descendants. Optional FollowParent
children are not implicitly selected in this mode. Keep later overrides
and existing maintenance selection behavior.

Includes the shared original conformance fixture and its own CA DLL.
Windows v3-v10 defines 279 states; A2 and B remain separate todo_wine checks.
No vendor code or binaries. Not in series pending clean-F L4.

V10 covers all 279 measured Windows states, including non-FP descendants.

diff --git a/dlls/msi/action.c b/dlls/msi/action.c
--- a/dlls/msi/action.c
+++ b/dlls/msi/action.c
@@ -1513,6 +1513,44 @@
     return (feature->Level > 0 && feature->Level <= level);
 }
 
+/* ADDLOCAL selects ancestors first, then mandatory descendants.  Do this
+ * before subsequent overrides, so REMOVE/ADDSOURCE keep their precedence. */
+static void select_required_children( MSIFEATURE *feature )
+{
+    FeatureList *child;
+
+    LIST_FOR_EACH_ENTRY( child, &feature->Children, FeatureList, entry )
+    {
+        MSIFEATURE *f = child->feature;
+
+        if (f->Level > 0 && (f->Attributes & msidbFeatureAttributesUIDisallowAbsent) &&
+            f->ActionRequest == INSTALLSTATE_UNKNOWN)
+            f->Action = f->ActionRequest = INSTALLSTATE_LOCAL;
+        if (f->ActionRequest == INSTALLSTATE_LOCAL) select_required_children( f );
+    }
+}
+
+static void select_addlocal_parents( MSIPACKAGE *package )
+{
+    MSIFEATURE *feature, *parent;
+
+    LIST_FOR_EACH_ENTRY( feature, &package->features, MSIFEATURE, entry )
+    {
+        if (feature->ActionRequest != INSTALLSTATE_LOCAL) continue;
+        parent = feature;
+        while (parent->Feature_Parent)
+        {
+            parent = msi_get_loaded_feature( package, parent->Feature_Parent );
+            if (!parent || parent->Level <= 0) break;
+            parent->Action = parent->ActionRequest = INSTALLSTATE_LOCAL;
+        }
+    }
+    LIST_FOR_EACH_ENTRY( feature, &package->features, MSIFEATURE, entry )
+    {
+        if (feature->ActionRequest == INSTALLSTATE_LOCAL) select_required_children( feature );
+    }
+}
+
 static BOOL process_state_property(MSIPACKAGE* package, int level,
                                    LPCWSTR property, INSTALLSTATE state)
 {
