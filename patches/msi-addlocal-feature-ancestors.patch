+static void set_code(MSIHANDLE record, unsigned int field, UINT code)
+{
+    char buffer[11];
+    snprintf(buffer, sizeof(buffer), "%u", code);
+    MsiRecordSetStringA(record, field, buffer);
+}
+
+__declspec(dllexport) UINT WINAPI ProbeFeatureStates(MSIHANDLE package)
+{
+    static const char *features[] = {"FWChild", "DFChild"};
+    static const char *descendants[] = {"FWGrandchild", "DFGrandchild"};
+    unsigned int i;
+    for (i = 0; i < sizeof(features) / sizeof(features[0]); ++i)
+    {
+        INSTALLSTATE before_installed = INSTALLSTATE_UNKNOWN, before_action = INSTALLSTATE_UNKNOWN;
+        INSTALLSTATE after_installed = INSTALLSTATE_UNKNOWN, after_action = INSTALLSTATE_UNKNOWN;
+        INSTALLSTATE descendant_bi = INSTALLSTATE_UNKNOWN, descendant_ba = INSTALLSTATE_UNKNOWN;
+        INSTALLSTATE descendant_ai = INSTALLSTATE_UNKNOWN, descendant_aa = INSTALLSTATE_UNKNOWN;
+        UINT before, set, after, descendant_before, descendant_after;
+        MSIHANDLE record;
+        before = MsiGetFeatureStateA(package, features[i], &before_installed, &before_action);
+        descendant_before = MsiGetFeatureStateA(package, descendants[i], &descendant_bi, &descendant_ba);
+        set = MsiSetFeatureStateA(package, features[i], INSTALLSTATE_LOCAL);
+        after = MsiGetFeatureStateA(package, features[i], &after_installed, &after_action);
+        descendant_after = MsiGetFeatureStateA(package, descendants[i], &descendant_ai, &descendant_aa);
+        record = MsiCreateRecord(8);
+        if (!record) return ERROR_FUNCTION_FAILED;
+        MsiRecordSetStringA(record, 0, "V7CA name=[1] set_rc=[2] before_rc=[3] before_installed=[4] before_action=[5] after_rc=[6] after_installed=[7] after_action=[8]");
+        MsiRecordSetStringA(record, 1, features[i]);
+        set_code(record, 2, set);
+        set_code(record, 3, before);
+        MsiRecordSetInteger(record, 4, before_installed);
+        MsiRecordSetInteger(record, 5, before_action);
+        set_code(record, 6, after);
+        MsiRecordSetInteger(record, 7, after_installed);
+        MsiRecordSetInteger(record, 8, after_action);
+        MsiProcessMessage(package, INSTALLMESSAGE_INFO, record);
+        MsiCloseHandle(record);
+        /* Observe descendants without setting them, in both old FP and new
+         * non-FP cases. The EXE traces these values without native guesses. */
+        record = MsiCreateRecord(7);
+        if (!record) return ERROR_FUNCTION_FAILED;
+        MsiRecordSetStringA(record, 0, "V10DESC name=[1] before_rc=[2] before_installed=[3] before_action=[4] after_rc=[5] after_installed=[6] after_action=[7]");
+        MsiRecordSetStringA(record, 1, descendants[i]);
+        set_code(record, 2, descendant_before);
+        MsiRecordSetInteger(record, 3, descendant_bi);
+        MsiRecordSetInteger(record, 4, descendant_ba);
+        set_code(record, 5, descendant_after);
+        MsiRecordSetInteger(record, 6, descendant_ai);
+        MsiRecordSetInteger(record, 7, descendant_aa);
+        MsiProcessMessage(package, INSTALLMESSAGE_INFO, record);
+        MsiCloseHandle(record);
+    }
+    /* A measured API failure must not abort installation and hide later states. */
+    return ERROR_SUCCESS;
+}
