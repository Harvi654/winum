+    if (entry->is_method && (flags == DISPATCH_METHOD || flags == (DISPATCH_METHOD | DISPATCH_PROPERTYGET)))
+        return invoke_method( object, entry->name, params, result, excep_info );
 
     if (flags == (DISPATCH_METHOD|DISPATCH_PROPERTYGET) ||
         flags == DISPATCH_PROPERTYGET)
     {
         memset( params, 0, sizeof(*params) );
-        return IWbemClassObject_Get( object->object, name, 0, result, NULL, NULL );
+        return IWbemClassObject_Get( object->object, entry->name, 0, result, NULL, NULL );
     }
     else if (flags == DISPATCH_PROPERTYPUT)
     {
@@ -1381,11 +1681,11 @@ static HRESULT WINAPI object_Invoke(
             return E_INVALIDARG;
         }
 
-        vartype = to_vartype( type );
+        vartype = to_vartype( entry->type );
