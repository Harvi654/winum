-    CIMTYPE type;
     HRESULT hr;
 
     TRACE( "%p, %ld, %s, %#lx, %#x, %p, %p, %p, %p\n", object, member, debugstr_guid(riid),
@@ -1364,14 +1663,15 @@ static HRESULT WINAPI object_Invoke(
         return hr;
     }
 
-    if (!(name = get_member_name( object, member, &type )))
-        return DISP_E_MEMBERNOTFOUND;
