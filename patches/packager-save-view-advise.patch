+static HRESULT WINAPI ViewObject_Draw(IViewObject2 *iface, DWORD aspect, LONG index, void *aspect_info,
+        DVTARGETDEVICE *device, HDC target_dc, HDC dc, const RECTL *bounds, const RECTL *wbounds,
+        BOOL (STDMETHODCALLTYPE *cont)(ULONG_PTR), ULONG_PTR cont_arg)
+{
+    struct Package *This = impl_from_IViewObject2(iface);
+    SHFILEINFOW info;
+    HICON icon = NULL;
+    SIZE icon_size, text_size, total;
+    LOGFONTW lf;
+    HFONT font = NULL, old_font = NULL;
+    POINT corners[2];
+    int saved;
+
+    TRACE("(%p)->(%ld, %ld, %p, %p, %p, %p, %s, %p, %p, %Ix)\n", This, aspect, index, aspect_info, device,
+            target_dc, dc, wine_dbgstr_rect((const RECT *)bounds), wbounds, cont, cont_arg);
+
+    if(!dc || !bounds)
+        return E_INVALIDARG;
+
+    /* every aspect is drawn the same way (measured) */
+    if(*This->filename && SHGetFileInfoW(This->filename, 0, &info, sizeof(info), SHGFI_ICON | SHGFI_LARGEICON))
+        icon = info.hIcon;
+    get_layout(This, &icon_size, &text_size, &total);
+
+    /* the bounds are in the caller's logical units: draw into the device
+     * rectangle they map to */
+    corners[0].x = bounds->left;
+    corners[0].y = bounds->top;
+    corners[1].x = bounds->right;
+    corners[1].y = bounds->bottom;
+    LPtoDP(dc, corners, 2);
+
+    saved = SaveDC(dc);
+    SetMapMode(dc, MM_ANISOTROPIC);
+    SetWindowOrgEx(dc, 0, 0, NULL);
+    SetWindowExtEx(dc, total.cx, total.cy, NULL);
+    SetViewportOrgEx(dc, corners[0].x, corners[0].y, NULL);
+    SetViewportExtEx(dc, corners[1].x - corners[0].x, corners[1].y - corners[0].y, NULL);
+
+    DrawIconEx(dc, (total.cx - icon_size.cx) / 2, (total.cy - icon_size.cy - text_size.cy) / 3,
+            icon ? icon : LoadIconW(NULL, (const WCHAR *)IDI_APPLICATION),
+            icon_size.cx, icon_size.cy, 0, NULL, DI_NORMAL);
+    if(*This->label && SystemParametersInfoW(SPI_GETICONTITLELOGFONT, sizeof(lf), &lf, 0) &&
+            (font = CreateFontIndirectW(&lf))){
+        old_font = SelectObject(dc, font);
+        SetBkMode(dc, TRANSPARENT);
+        TextOutW(dc, (total.cx - text_size.cx) / 2, total.cy - text_size.cy - (total.cy - icon_size.cy - text_size.cy) / 3,
+                This->label, lstrlenW(This->label));
+        SelectObject(dc, old_font);
+        DeleteObject(font);
+    }
+    RestoreDC(dc, saved);
+
+    if(icon)
+        DestroyIcon(icon);
+    return S_OK;
+}
