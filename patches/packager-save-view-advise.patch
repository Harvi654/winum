+
+/* A package is shown as its file's icon with the file name under it. The
+ * layout in screen pixels, as measured on Windows 10 (pkgprobe, ole32
+ * docs/wine-repro): the width is 5/4 of the wider of the icon and the
+ * label plus one pixel, the height the icon plus 11/10 of the label's
+ * height plus 5.5 pixels (two font sizes measured). */
+static void get_layout(struct Package *This, SIZE *icon, SIZE *text, SIZE *total)
+{
+    LOGFONTW lf;
+    HFONT font, old;
+    HDC dc;
+
+    icon->cx = GetSystemMetrics(SM_CXICON);
+    icon->cy = GetSystemMetrics(SM_CYICON);
+    text->cx = text->cy = 0;
+    if(*This->label && SystemParametersInfoW(SPI_GETICONTITLELOGFONT, sizeof(lf), &lf, 0) &&
+            (font = CreateFontIndirectW(&lf))){
+        dc = GetDC(NULL);
+        old = SelectObject(dc, font);
+        GetTextExtentPoint32W(dc, This->label, lstrlenW(This->label), text);
+        SelectObject(dc, old);
+        ReleaseDC(NULL, dc);
+        DeleteObject(font);
+    }
+    total->cx = max(icon->cx, text->cx + 1) * 5 / 4;
+    total->cy = icon->cy + (11 * text->cy + 55) / 10;
+}
+
+/* the same for every aspect and index, in HIMETRIC */
+static void get_extent(struct Package *This, SIZEL *size)
+{
+    SIZE icon, text, total;
+    HDC dc = GetDC(NULL);
+    int dpix = GetDeviceCaps(dc, LOGPIXELSX), dpiy = GetDeviceCaps(dc, LOGPIXELSY);
+
+    ReleaseDC(NULL, dc);
+    get_layout(This, &icon, &text, &total);
+    size->cx = MulDiv(total.cx, 2540, dpix);
+    size->cy = MulDiv(total.cy, 2540, dpiy);
+}
