+static void test_save(void)
+{
+    /* the layout Windows writes (measured with OleCreateFromFileEx) */
+    static BYTE native[] = {
+        0x61, 0x00, 0x00, 0x00, /* size of the rest */
+        0x02, 0x00,
+        'a','.','t','x','t',0, /* label */
+        'C',':','\\','a','.','t','x','t',0, /* source path */
+        0x00, 0x00,
+        0x03, 0x00,
+        0x09, 0x00, 0x00, 0x00, /* ASCIIZ temp path size */
+        'C',':','\\','a','.','t','x','t',0,
+        0x05, 0x00, 0x00, 0x00, /* payload size */
+        'h','e','l','l','o', /* payload */
+        0x08, 0x00, 0x00, 0x00, /* WCHAR temp path */
+        'C',0,':',0,'\\',0,'a',0,'.',0,'t',0,'x',0,'t',0,
+        0x05, 0x00, 0x00, 0x00, /* WCHAR label */
+        'a',0,'.',0,'t',0,'x',0,'t',0,
+        0x08, 0x00, 0x00, 0x00, /* WCHAR source path */
+        'C',0,':',0,'\\',0,'a',0,'.',0,'t',0,'x',0,'t',0,
+    };
+    IStorage *src, *dst;
+    IStream *stm;
+    IOleObject *oleobj;
+    IPersistStorage *persist;
+    BYTE buf[sizeof(native) + 16];
+    WCHAR *type;
+    CLSID clsid;
+    ULONG read;
+    HRESULT hr;
+
+    hr = StgCreateDocfile(NULL, STGM_READWRITE | STGM_CREATE | STGM_SHARE_EXCLUSIVE | STGM_DELETEONRELEASE, 0, &src);
+    ok(hr == S_OK, "StgCreateDocfile failed: %08lx\n", hr);
+    hr = IStorage_CreateStream(src, L"\1Ole10Native", STGM_WRITE | STGM_SHARE_EXCLUSIVE, 0, 0, &stm);
+    ok(hr == S_OK, "CreateStream failed: %08lx\n", hr);
+    IStream_Write(stm, native, sizeof(native), NULL);
+    IStream_Release(stm);
+    /* embedded packages carry this class (measured on Windows) */
+    hr = WriteClassStg(src, &CLSID_Package_Alt);
+    ok(hr == S_OK, "WriteClassStg failed: %08lx\n", hr);
+
+    hr = CoCreateInstance(&CLSID_Package_Alt, NULL, CLSCTX_INPROC_SERVER | CLSCTX_INPROC_HANDLER,
+            &IID_IOleObject, (void**)&oleobj);
+    ok(hr == S_OK, "CoCreateInstance(CLSID_Package_Alt) failed: %08lx\n", hr);
+    hr = IOleObject_QueryInterface(oleobj, &IID_IPersistStorage, (void**)&persist);
+    ok(hr == S_OK, "QueryInterface(IPersistStorage) failed: %08lx\n", hr);
+
+    hr = IPersistStorage_Load(persist, src);
+    ok(hr == S_OK, "Load failed: %08lx\n", hr);
+
+    hr = IPersistStorage_GetClassID(persist, &clsid);
+    ok(hr == S_OK, "GetClassID failed: %08lx\n", hr);
+    ok(IsEqualCLSID(&clsid, &CLSID_Package_Alt), "got class %s\n", wine_dbgstr_guid(&clsid));
+
+    hr = IOleObject_GetUserClassID(oleobj, &clsid);
+    ok(hr == S_OK, "GetUserClassID failed: %08lx\n", hr);
+    ok(IsEqualCLSID(&clsid, &CLSID_Package_Alt), "got class %s\n", wine_dbgstr_guid(&clsid));
+
+    hr = IOleObject_GetUserType(oleobj, USERCLASSTYPE_FULL, &type);
+    ok(hr == S_OK, "GetUserType failed: %08lx\n", hr);
+    if(hr == S_OK){
+        ok(!lstrcmpW(type, L"Package"), "got user type %s\n", wine_dbgstr_w(type));
+        CoTaskMemFree(type);
+    }
+
+    hr = IPersistStorage_IsDirty(persist);
+    ok(hr == S_FALSE, "IsDirty returned %08lx\n", hr);
+
+    test_view_advise(oleobj);
+
+    hr = StgCreateDocfile(NULL, STGM_READWRITE | STGM_CREATE | STGM_SHARE_EXCLUSIVE | STGM_DELETEONRELEASE, 0, &dst);
+    ok(hr == S_OK, "StgCreateDocfile failed: %08lx\n", hr);
+    hr = OleSave(persist, dst, FALSE);
+    ok(hr == S_OK, "OleSave failed: %08lx\n", hr);
+    hr = IPersistStorage_SaveCompleted(persist, NULL);
+    ok(hr == S_OK, "SaveCompleted failed: %08lx\n", hr);
+
+    hr = ReadClassStg(dst, &clsid);
+    ok(hr == S_OK, "ReadClassStg failed: %08lx\n", hr);
+    ok(IsEqualCLSID(&clsid, &CLSID_Package_Alt), "got class %s\n", wine_dbgstr_guid(&clsid));
+    check_user_type(dst);
+
+    /* Save itself writes the class and user type, not only OleSave */
+    {
+        IStorage *dst2;
+
+        hr = StgCreateDocfile(NULL, STGM_READWRITE | STGM_CREATE | STGM_SHARE_EXCLUSIVE | STGM_DELETEONRELEASE, 0, &dst2);
+        ok(hr == S_OK, "StgCreateDocfile failed: %08lx\n", hr);
+        hr = IPersistStorage_Save(persist, dst2, FALSE);
+        ok(hr == S_OK, "Save failed: %08lx\n", hr);
+        hr = IPersistStorage_SaveCompleted(persist, NULL);
+        ok(hr == S_OK, "SaveCompleted failed: %08lx\n", hr);
+        hr = ReadClassStg(dst2, &clsid);
+        ok(hr == S_OK, "ReadClassStg failed: %08lx\n", hr);
+        ok(IsEqualCLSID(&clsid, &CLSID_Package_Alt), "got class %s\n", wine_dbgstr_guid(&clsid));
+        check_user_type(dst2);
+        IStorage_Release(dst2);
+    }
+
+    hr = IStorage_OpenStream(dst, L"\1Ole10Native", NULL, STGM_READ | STGM_SHARE_EXCLUSIVE, 0, &stm);
+    ok(hr == S_OK, "OpenStream failed: %08lx\n", hr);
+    if(hr == S_OK){
+        read = 0;
+        IStream_Read(stm, buf, sizeof(buf), &read);
+        /* Windows rewrites the stream (with the path of its own temporary
+         * copy), so only check that it is there and loads again */
+        ok(read > 0, "got %lu bytes\n", read);
+        IStream_Release(stm);
+    }
+
+    {
+        IPersistStorage *persist2;
+        IOleObject *oleobj2;
+
+        hr = CoCreateInstance(&CLSID_Package_Alt, NULL, CLSCTX_INPROC_SERVER | CLSCTX_INPROC_HANDLER,
+                &IID_IOleObject, (void**)&oleobj2);
+        ok(hr == S_OK, "CoCreateInstance(CLSID_Package_Alt) failed: %08lx\n", hr);
+        hr = IOleObject_QueryInterface(oleobj2, &IID_IPersistStorage, (void**)&persist2);
+        ok(hr == S_OK, "QueryInterface(IPersistStorage) failed: %08lx\n", hr);
+        hr = IPersistStorage_Load(persist2, dst);
+        ok(hr == S_OK, "Load of the saved package failed: %08lx\n", hr);
+        IOleObject_Close(oleobj2, OLECLOSE_NOSAVE);
+        IPersistStorage_Release(persist2);
+        IOleObject_Release(oleobj2);
+    }
+
+    IOleObject_Close(oleobj, OLECLOSE_NOSAVE);
+    IPersistStorage_Release(persist);
+    IOleObject_Release(oleobj);
+    IStorage_Release(dst);
+    IStorage_Release(src);
+}
+
