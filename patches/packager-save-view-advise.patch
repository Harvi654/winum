+/* plain Read/Write: the container's stream may implement nothing more */
+static HRESULT copy_stream(IStream *src, IStream *dst)
+{
+    LARGE_INTEGER zero = {{0}};
+    BYTE buf[4096];
+    ULONG read;
+    HRESULT hr;
+
+    hr = IStream_Seek(src, zero, STREAM_SEEK_SET, NULL);
+    while(SUCCEEDED(hr)){
+        hr = IStream_Read(src, buf, sizeof(buf), &read);
+        if(FAILED(hr) || !read)
+            break;
+        hr = IStream_Write(dst, buf, read, NULL);
+    }
+    return FAILED(hr) ? hr : S_OK;
+}
+
+/* keeps the whole \1Ole10Native stream so that Save can write it back */
+static HRESULT keep_native_data(struct Package *This, IStream *stream)
+{
+    IStorage *stg;
+    IStream *copy;
+    HRESULT hr;
+
+    hr = StgCreateDocfile(NULL, STGM_CREATE | STGM_READWRITE | STGM_SHARE_EXCLUSIVE |
+            STGM_DELETEONRELEASE, 0, &stg);
+    if(FAILED(hr))
+        return hr;
+    hr = IStorage_CreateStream(stg, L"native", STGM_CREATE | STGM_READWRITE |
+            STGM_SHARE_EXCLUSIVE, 0, 0, &copy);
+    if(SUCCEEDED(hr)){
+        hr = copy_stream(stream, copy);
+        IStream_Release(copy);
+    }
+    if(FAILED(hr)){
+        IStorage_Release(stg);
+        return hr;
+    }
+
+    if(This->native)
+        IStorage_Release(This->native);
+    This->native = stg;
+    return S_OK;
+}
