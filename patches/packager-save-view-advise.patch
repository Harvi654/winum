+static void check_user_type(IStorage *stg)
+{
+    CLIPFORMAT cf = 0xdead;
+    WCHAR *type = NULL;
+    HRESULT hr;
+
+    hr = ReadFmtUserTypeStg(stg, &cf, &type);
+    ok(hr == S_OK, "ReadFmtUserTypeStg failed: %08lx\n", hr);
+    if(hr == S_OK){
+        ok(!cf, "got clipboard format %u\n", cf);
+        ok(type && !lstrcmpW(type, L"OLE Package"), "got user type %s\n", wine_dbgstr_w(type));
+        CoTaskMemFree(type);
+    }
+}
