+static IAdviseSink test_sink;
+
+static HRESULT WINAPI sink_QueryInterface(IAdviseSink *iface, REFIID riid, void **obj)
+{
+    if(IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IAdviseSink)){
+        *obj = iface;
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI sink_AddRef(IAdviseSink *iface) { return 2; }
+static ULONG WINAPI sink_Release(IAdviseSink *iface) { return 1; }
+static LONG view_changes;
+static void WINAPI sink_OnDataChange(IAdviseSink *iface, FORMATETC *fmt, STGMEDIUM *med) {}
+static void WINAPI sink_OnViewChange(IAdviseSink *iface, DWORD aspect, LONG index) { view_changes++; }
+static void WINAPI sink_OnRename(IAdviseSink *iface, IMoniker *mk) {}
+static void WINAPI sink_OnSave(IAdviseSink *iface) {}
+static void WINAPI sink_OnClose(IAdviseSink *iface) {}
+
+static IAdviseSinkVtbl sink_vtbl = {
+    sink_QueryInterface, sink_AddRef, sink_Release, sink_OnDataChange,
+    sink_OnViewChange, sink_OnRename, sink_OnSave, sink_OnClose
+};
+static IAdviseSink test_sink = { &sink_vtbl };
+
+/* measured on Windows 10 with pkgprobe (ole32 docs/wine-repro) */
+static void test_view_advise(IOleObject *oleobj)
+{
+    static const DWORD aspects[] = { DVASPECT_CONTENT, DVASPECT_THUMBNAIL, DVASPECT_ICON, DVASPECT_DOCPRINT };
+    IEnumSTATDATA *enm;
+    IViewObject2 *view;
+    IAdviseSink *sink;
+    SIZEL first, size;
+    DWORD conn, aspect, advf;
+    HRESULT hr;
+    LONG index;
+    int i;
+
+    hr = IOleObject_QueryInterface(oleobj, &IID_IViewObject2, (void **)&view);
+    ok(hr == S_OK, "QueryInterface(IViewObject2) failed: %08lx\n", hr);
+    if(FAILED(hr))
+        return;
+
+    /* every aspect and index gets the same extent */
+    hr = IViewObject2_GetExtent(view, DVASPECT_CONTENT, -1, NULL, &first);
+    ok(hr == S_OK, "GetExtent failed: %08lx\n", hr);
+    ok(first.cx > 0 && first.cy > 0, "got extent %ldx%ld\n", first.cx, first.cy);
+    for(i = 0; i < ARRAY_SIZE(aspects); i++)
+        for(index = -1; index <= 1; index++){
+            size.cx = size.cy = 0;
+            hr = IViewObject2_GetExtent(view, aspects[i], index, NULL, &size);
+            ok(hr == S_OK && size.cx == first.cx && size.cy == first.cy,
+                    "aspect %lu index %ld: got %08lx %ldx%ld\n", aspects[i], index, hr, size.cx, size.cy);
+            size.cx = size.cy = 0;
+            hr = IOleObject_GetExtent(oleobj, aspects[i], &size);
+            ok(hr == S_OK && size.cx == first.cx && size.cy == first.cy,
+                    "IOleObject aspect %lu: got %08lx %ldx%ld\n", aspects[i], hr, size.cx, size.cy);
+        }
+
+    /* no notification when the sink is set, also with ADVF_PRIMEFIRST */
+    view_changes = 0;
+    hr = IViewObject2_SetAdvise(view, DVASPECT_CONTENT, ADVF_PRIMEFIRST, &test_sink);
+    ok(hr == S_OK, "SetAdvise failed: %08lx\n", hr);
+    ok(!view_changes, "got %ld OnViewChange\n", view_changes);
+    hr = IViewObject2_SetAdvise(view, DVASPECT_ICON, ADVF_PRIMEFIRST | ADVF_ONLYONCE, &test_sink);
+    ok(hr == S_OK, "SetAdvise failed: %08lx\n", hr);
+    ok(!view_changes, "got %ld OnViewChange\n", view_changes);
+    sink = NULL;
+    hr = IViewObject2_GetAdvise(view, &aspect, &advf, &sink);
+    ok(hr == S_OK, "GetAdvise failed: %08lx\n", hr);
+    ok(aspect == DVASPECT_ICON, "got aspect %lu\n", aspect);
+    ok(advf == (ADVF_PRIMEFIRST | ADVF_ONLYONCE), "got advf %#lx\n", advf);
+    ok(sink == &test_sink, "got sink %p\n", sink);
+    if(sink)
+        IAdviseSink_Release(sink);
+    hr = IViewObject2_SetAdvise(view, DVASPECT_CONTENT, 0, NULL);
+    ok(hr == S_OK, "SetAdvise(NULL) failed: %08lx\n", hr);
+
+    enm = (IEnumSTATDATA *)0xdeadbeef;
+    hr = IOleObject_EnumAdvise(oleobj, &enm);
+    ok(hr == E_FAIL, "EnumAdvise before Advise returned %08lx\n", hr);
+    ok(enm == (IEnumSTATDATA *)0xdeadbeef, "got enumerator %p\n", enm);
+    hr = IOleObject_Advise(oleobj, &test_sink, &conn);
+    ok(hr == S_OK, "Advise failed: %08lx\n", hr);
+    ok(!view_changes, "got %ld OnViewChange\n", view_changes);
+    enm = (IEnumSTATDATA *)0xdeadbeef;
+    hr = IOleObject_EnumAdvise(oleobj, &enm);
+    ok(hr == E_NOTIMPL, "EnumAdvise after Advise returned %08lx\n", hr);
+    ok(!enm, "got enumerator %p\n", enm);
+    hr = IOleObject_Unadvise(oleobj, conn);
+    ok(hr == S_OK, "Unadvise failed: %08lx\n", hr);
+
+    IViewObject2_Release(view);
+}
