From: Harvi654 <202698022+Harvi654@users.noreply.github.com>
Subject: [PATCH] server: Preserve input components and desktop reparent associations.

AI-assisted (Codex), original code; LGPL-2.1-or-later. Not
submitted upstream.

Windows 10 x86_64/i686, measured through public APIs with our own windows
(docs/wine-repro/server-input-attachment-components/windows-2026-11-09,
bundle run 42659893206), preserves remaining explicit AttachThreadInput
components when one reference is removed: chains, bridges, cycles and
repeated/reversed edges. Focus, active and captured windows stay in the
component of the active anchor. Nonedges fail without splitting input.

Vanilla split only the from queue, breaking surviving links and moving
active/focus away from the foreground input object. Keep the v1 component
walk and retain the active component's input object. Allocation failure
restores the removed reference; detach-all is unchanged.

The measured implicit child sequences differ: SetParent(child, NULL)
retains the shared input association, including after that child is later
destroyed, whereas direct destruction detaches its old host on Windows.
Do not split the old parent group when moving a child to the desktop.
Otherwise v1 would newly clear the old host's active window, a field that
vanilla preserves like Windows. Direct-destruction detachment and the
self-detach error-code discrepancy remain separate Wine gaps, limited
todo_wine assertions in the test. No claim covers unmeasured desktop,
DPI, cross-process or allocator-failure Windows behavior.

v2 (2026-11-09): add a Wine test with literal observed state checkpoints
and invalid/duplicate reference results, plus the measured desktop-reparent
limit that preserves the old host too. The x86_64 and i686 measurements
are identical except bitness; expected values are never computed from
Wine's attachment graph. Native assertion L1 and paired L2 are pending.

diff --git a/server/queue.c b/server/queue.c
--- a/server/queue.c
+++ b/server/queue.c
@@ -1495,11 +1495,91 @@
     release_object( old_input );
 }
 
+/* Return the queues reachable through the remaining undirected attachments. */
+static size_t collect_input_component( struct thread_input *input, struct msg_queue *seed,
+                                       struct msg_queue **queues )
+{
+    struct attachment *attach;
+    struct msg_queue *other;
+    size_t count = 1, i, j;
+
+    queues[0] = seed;
+    for (i = 0; i < count; ++i)
+    {
+        LIST_FOR_EACH_ENTRY( attach, &input->attachments, struct attachment, entry )
+        {
+            if (attach->queue_from == queues[i]) other = attach->queue_to;
+            else if (attach->queue_to == queues[i]) other = attach->queue_from;
+            else continue;
+            for (j = 0; j < count; ++j) if (queues[j] == other) break;
+            if (j == count) queues[count++] = other;
+        }
+    }
+    return count;
+}
+
+/* Split a disconnected component, keeping the active window's input object. */
+static int split_thread_input( struct msg_queue *queue_from, struct msg_queue *queue_to,
+                               struct desktop *desktop )
+{
+    struct thread_input *old_input = queue_from->input, *new_input;
+    struct attachment *attach, *next;
+    struct msg_queue **queues;
+    struct thread *owner;
+    size_t capacity = 1, count, i;
+
+    LIST_FOR_EACH_ENTRY( attach, &old_input->attachments, struct attachment, entry )
+    {
+        if (capacity > ~(size_t)0 / sizeof(*queues) - 2)
+        {
+            set_error( STATUS_NO_MEMORY );
+            return 0;
+        }
+        capacity += 2;
+    }
+    if (!(queues = mem_alloc( capacity * sizeof(*queues) ))) return 0;
+    count = collect_input_component( old_input, queue_from, queues );
+    for (i = 0; i < count; ++i) if (queues[i] == queue_to) break;
+    if (i < count)  /* another path still connects the two endpoints */
+    {
+        free( queues );
+        return 1;
+    }
+
+    /* The foreground desktop still points at old_input. Do not move its active
+     * window's queue to the new object while leaving foreground input behind. */
+    if (old_input->shared->active && (owner = get_window_thread( old_input->shared->active )))
+    {
+        for (i = 0; i < count; ++i) if (queues[i] == owner->queue) break;
+        release_object( owner );
+        if (i < count) count = collect_input_component( old_input, queue_to, queues );
+    }
+    if (!(new_input = create_thread_input( desktop )))
+    {
+        free( queues );
+        return 0;
+    }
+
+    grab_object( old_input );
+    for (i = 0; i < count; ++i) assign_thread_input( queues[i], new_input );
+    LIST_FOR_EACH_ENTRY_SAFE( attach, next, &old_input->attachments, struct attachment, entry )
+    {
+        if (attach->queue_from->input != new_input) continue;
+        assert( attach->queue_to->input == new_input );
+        list_remove( &attach->entry );
+        list_add_tail( &new_input->attachments, &attach->entry );
+    }
+    release_object( old_input );
+    release_object( new_input );
+    free( queues );
+    return 1;
+}
+
 /* detach two thread input data structures */
 void detach_thread_input( struct msg_queue *queue_from, struct msg_queue *queue_to, struct desktop *desktop )
 {
     struct thread_input *old_input = queue_from->input, *new_input;
-    struct attachment *attach, *next;
+    struct attachment *attach, *next, *removed = NULL;
     int count = 0;
 
     LIST_FOR_EACH_ENTRY_SAFE( attach, next, &old_input->attachments, struct attachment, entry )
@@ -1508,15 +1588,18 @@
         if (attach->queue_to != queue_from && (!queue_to || attach->queue_to != queue_to)) continue;
         if (count++ && queue_to) break;
         list_remove( &attach->entry );
-        free( attach );
+        if (queue_to) removed = attach;
+        else free( attach );
     }
     if (queue_to)
     {
         if (!count) return set_error( STATUS_INVALID_PARAMETER );
-        if (count > 1) return;
-    }
-    /* TODO: detaching a thread may create two separate thread input graphs */
-
+        if (count > 1 || split_thread_input( queue_from, queue_to, desktop )) free( removed );
+        else list_add_tail( &old_input->attachments, &removed->entry );
+        return;
+    }
+
+    /* Moving one queue to another desktop still removes all its attachments. */
     if (!(new_input = create_thread_input( desktop ))) return;
     assign_thread_input( queue_from, new_input );
     release_object( new_input );
diff --git a/server/window.c b/server/window.c
--- a/server/window.c
+++ b/server/window.c
@@ -425,7 +425,9 @@
 
     if (parent)
     {
-        attach_parent_thread( win, false );
+        /* Reparenting a child to the desktop retains its input association.
+         * In particular, another child can still share input with that host. */
+        if (!is_desktop_window( parent )) attach_parent_thread( win, false );
         if (win->parent) release_object( win->parent );
         win->parent = (struct window *)grab_object( parent );
         attach_parent_thread( win, true );
