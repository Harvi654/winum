From: Harvi654 <202698022+Harvi654@users.noreply.github.com>
Subject: [DEBUG PATCH] msxml3: Trace Content Center stream load and DOM operations.

AI-assisted (Codex), original code; LGPL-2.1-or-later. Not submitted upstream.

Temporary diagnostics for Inventor issue #45. Print public return values,
the stored parse error and a bounded serialized DOM preview under +msxml.
Keep captured XML local. This patch is never part of the release series.

--- a/dlls/msxml3/domdoc.c
+++ b/dlls/msxml3/domdoc.c
@@ -263,10 +263,39 @@
     FIXME("%p: stub!\n", iface);
 
     return S_FALSE;
 }
 
+/* Keep the preview local to explicit +msxml captures. Do not reread the input stream. */
+static void trace_stream_load(domdoc *doc, const char *api, HRESULT hr, const VARIANT_BOOL *result)
+{
+    BSTR xml = NULL;
+    HRESULT xml_hr;
+    UINT len, limit, offset;
+
+    if (!TRACE_ON(msxml)) return;
+    if (result)
+        TRACE("cc_msxml load doc=%p api=%s hr=%#010lx result=%d parse_error=%#010lx.\n",
+                &doc->IXMLDOMDocument3_iface, api, hr, *result, doc->error);
+    else
+        TRACE("cc_msxml load doc=%p api=%s hr=%#010lx result=NA parse_error=%#010lx.\n",
+                &doc->IXMLDOMDocument3_iface, api, hr, doc->error);
+    if (hr != S_OK) return;
+
+    xml_hr = node_get_xml(doc->node, &xml);
+    len = SysStringLen(xml);
+    limit = min(len, 300);
+    TRACE("cc_msxml preview doc=%p xml_hr=%#010lx xml_len=%u preview_len=%u.\n",
+            &doc->IXMLDOMDocument3_iface, xml_hr, len, limit);
+    /* debugstr_wn has a small escaped-output buffer. */
+    if (SUCCEEDED(xml_hr))
+        for (offset = 0; offset < limit; offset += 48)
+            TRACE("cc_msxml xml doc=%p offset=%u %s.\n", &doc->IXMLDOMDocument3_iface,
+                    offset, debugstr_wn(xml + offset, min(limit - offset, 48)));
+    SysFreeString(xml);
+}
