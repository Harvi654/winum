+/* Called only for an identified status-bar DC with +sbdiag enabled. */
+void trace_statusbar_surface( DC *dc )
+{
+    PHYSDEV dev = find_dc_driver( dc, &window_driver );
+    struct windrv_physdev *physdev;
+    struct window_surface *surface;
+
+    if (!dev)
+    {
+        TRACE_(sbdiag)( "SBSURFACE hdc=%p window_driver=0 bitmap=%p\n", dc->hSelf, dc->hBitmap );
+        return;
+    }
+    physdev = get_windrv_physdev( dev );
+    surface = physdev->surface;
+    TRACE_(sbdiag)( "SBSURFACE hdc=%p window_driver=1 surface=%p dummy=%u hwnd=%p "
+                    "rect=%s bitmap=%p dibrect=%s stride=%d\n",
+                    dc->hSelf, surface, surface == &dummy_surface, surface->hwnd,
+                    wine_dbgstr_rect( &surface->rect ), surface->color_bitmap,
+                    wine_dbgstr_rect( &physdev->dibdrv->dib.rect ), physdev->dibdrv->dib.stride );
+    trace_statusbar_region( dc->hSelf, "dib", physdev->dibdrv->clip );
+}
+
 /* gdi_lock should not be locked */
 static inline void lock_surface( struct windrv_physdev *dev )
 {
