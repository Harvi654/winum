--- a/dlls/win32u/dce.c
+++ b/dlls/win32u/dce.c
@@ -33,6 +33,7 @@
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(win);
+WINE_DECLARE_DEBUG_CHANNEL(sbdiag);
 
