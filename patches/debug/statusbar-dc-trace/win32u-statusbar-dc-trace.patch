+/* Diagnostic only: numeric GDI state, never application strings or pixel data. */
+void trace_statusbar_region( HDC hdc, const char *kind, HRGN handle )
+{
+    const WINEREGION *region;
+    UINT hash = 2166136261u;
+    int i, j;
+
+    if (!handle || !(region = get_wine_region( handle )))
+    {
+        TRACE_(sbdiag)( "SBREGION hdc=%p kind=%s present=0\n", hdc, kind );
+        return;
+    }
+    for (i = 0; i < region->numRects; i++)
+    {
+        const RECT *r = &region->rects[i];
+        const LONG values[] = {r->left, r->top, r->right, r->bottom};
+        for (j = 0; j < ARRAY_SIZE(values); j++) hash = (hash ^ (UINT)values[j]) * 16777619u;
+    }
+    TRACE_(sbdiag)( "SBREGION hdc=%p kind=%s present=1 count=%d hash=%08x box=%s\n",
+                    hdc, kind, region->numRects, hash, wine_dbgstr_rect( &region->extents ));
+    for (i = 0; i < min( region->numRects, 8 ); i++)
+        TRACE_(sbdiag)( "SBRECT hdc=%p kind=%s index=%d rect=%s\n",
+                        hdc, kind, i, wine_dbgstr_rect( &region->rects[i] ));
+    release_wine_region( handle );
+}
+
+BOOL trace_statusbar_dc( DC *dc, INT x, INT y, UINT flags, const RECT *rect, UINT count )
+{
+    WCHAR buffer[64];
+    UNICODE_STRING name = {0, sizeof(buffer), buffer};
+    DC_ATTR *a = dc->attr;
+    const XFORM *m = &dc->xformWorld2Vport;
+    struct dce *dce = dc->dce;
+
+    if (!TRACE_ON(sbdiag) || !dce || !dce->hwnd) return FALSE;
+    if (!NtUserGetClassName( dce->hwnd, FALSE, &name ) ||
+        wcsicmp( buffer, u"msctls_statusbar32" )) return FALSE;
+
+    TRACE_(sbdiag)( "SBSTATE hwnd=%p hdc=%p count=%u flags=%x xy=%d,%d rect=%s dcx=%x "
+                    "vis=%s device=%s wnd=%d,%d/%d,%d vp=%d,%d/%d,%d "
+                    "map=%d gm=%d layout=%x bk=%08x text=%08x bkmode=%u align=%x "
+                    "matrix=%g,%g,%g,%g,%g,%g backend=%p\n",
+                    dce->hwnd, dc->hSelf, count, flags, x, y, wine_dbgstr_rect( rect ), dce->flags,
+                    wine_dbgstr_rect( &a->vis_rect ), wine_dbgstr_rect( &dc->device_rect ),
+                    a->wnd_org.x, a->wnd_org.y, a->wnd_ext.cx, a->wnd_ext.cy,
+                    a->vport_org.x, a->vport_org.y, a->vport_ext.cx, a->vport_ext.cy,
+                    a->map_mode, a->graphics_mode, (UINT)a->layout, (UINT)a->background_color,
+                    (UINT)a->text_color, a->background_mode, a->text_align,
+                    m->eM11, m->eM12, m->eM21, m->eM22, m->eDx, m->eDy,
+                    GET_DC_PHYSDEV( dc, pExtTextOut )->funcs );
+    trace_statusbar_region( dc->hSelf, "visible", dc->hVisRgn );
+    trace_statusbar_region( dc->hSelf, "app", dc->hClipRgn );
+    trace_statusbar_region( dc->hSelf, "meta", dc->hMetaRgn );
+    trace_statusbar_region( dc->hSelf, "effective", get_dc_region( dc ) );
+    trace_statusbar_surface( dc );
+    return TRUE;
+}
 
