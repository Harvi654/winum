MSXML6-only cache namespace adoption with Windows reference tests.
AI-assisted; LGPL-2.1-or-later. Native MSXML3 XSD and unrelated error mapping differences remain todo_wine.

--- a/dlls/msxml3/schema.c
+++ b/dlls/msxml3/schema.c
@@ -756,8 +756,26 @@

     link_datatypes(new_doc);

-    /* TODO: if the nsURI is different from the default xmlns or targetNamespace,
-     *       do we need to do something special here? */
+    /* MSXML6 binds a schema without a target namespace to the cache namespace.
+     * Normalize only our private copy. Explicit target namespaces, including
+     * mismatches, must still be checked by the schema validator. */
+    if (v == MSXML6 && nsURI && *nsURI)
+    {
+        xmlNodePtr root = xmlDocGetRootElement(new_doc);
+
+        if (root && !xmlHasProp(root, BAD_CAST "targetNamespace"))
+        {
+            /* Unprefixed references to global types/elements in a chameleon
+             * schema must resolve in the adopted namespace as well. */
+            if (!xmlSetProp(root, BAD_CAST "targetNamespace", nsURI) ||
+                (!xmlSearchNs(new_doc, root, NULL) && !xmlNewNs(root, nsURI, NULL)))
+            {
+                xmlFreeDoc(new_doc);
+                free(entry);
+                return NULL;
+            }
+        }
+    }
     entry->type = CacheEntryType_XSD;
     entry->ref = 0;
     spctx = xmlSchemaNewDocParserCtxt(new_doc);
