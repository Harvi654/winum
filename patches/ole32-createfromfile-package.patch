+/* the extent of a Package, measured on Windows 10 at 96 dpi with 32x32
+ * icons and a Segoe UI icon title font 15 and 25 pixels high (pkgprobe):
+ * 5/4 of the wider of the icon and the label plus one pixel, and the icon
+ * plus 11/10 of the label's height plus 5.5 pixels. That rule is inferred
+ * from these measurements, so exact values are checked only there; the
+ * width following the label and the height staying are checked always. */
+static void test_OleCreateFromFile_package_extent(void)
+{
+    static const WCHAR *names[] = { L"r.txt", L"report.txt", L"a much longer file name for the package label.txt" };
+    WCHAR dir[MAX_PATH], path[MAX_PATH];
+    SIZEL size, other, expect, first = {0, 0};
+    SIZE text;
+    TEXTMETRICW tm;
+    BOOL measured;
+    IViewObject2 *view;
+    IUnknown *obj;
+    IStorage *stg;
+    LOGFONTW lf;
+    HFONT font, old_font;
+    HANDLE file;
+    HRESULT hr;
+    HDC dc;
+    int i, dpix, dpiy, cx, cy;
+
+    GetTempPathW(ARRAY_SIZE(dir), dir);
+    swprintf(dir + lstrlenW(dir), MAX_PATH - lstrlenW(dir), L"winetest_olecfx%lx%lx", GetCurrentProcessId(), GetTickCount());
+    ok(CreateDirectoryW(dir, NULL), "CreateDirectory failed: %lu\n", GetLastError());
+
+    SystemParametersInfoW(SPI_GETICONTITLELOGFONT, sizeof(lf), &lf, 0);
+    dc = GetDC(NULL);
+    dpix = GetDeviceCaps(dc, LOGPIXELSX);
+    dpiy = GetDeviceCaps(dc, LOGPIXELSY);
+    font = CreateFontIndirectW(&lf);
+    old_font = SelectObject(dc, font);
+    GetTextMetricsW(dc, &tm);
+    measured = dpix == 96 && dpiy == 96 && GetSystemMetrics(SM_CXICON) == 32 && GetSystemMetrics(SM_CYICON) == 32 &&
+               !lstrcmpW(lf.lfFaceName, L"Segoe UI") && (tm.tmHeight == 15 || tm.tmHeight == 25);
+    if (!measured)
+        skip("exact extents: %s, %ld px high, %d dpi, %dx%d icons not measured\n", wine_dbgstr_w(lf.lfFaceName),
+             tm.tmHeight, dpix, GetSystemMetrics(SM_CXICON), GetSystemMetrics(SM_CYICON));
+
+    for (i = 0; i < ARRAY_SIZE(names); i++)
+    {
+        winetest_push_context("%s", wine_dbgstr_w(names[i]));
+        GetTextExtentPoint32W(dc, names[i], lstrlenW(names[i]), &text);
+        cx = max(GetSystemMetrics(SM_CXICON), text.cx + 1) * 5 / 4;
+        cy = GetSystemMetrics(SM_CYICON) + (11 * text.cy + 55) / 10;
+        expect.cx = MulDiv(cx, 2540, dpix);
+        expect.cy = MulDiv(cy, 2540, dpiy);
+
+        swprintf(path, ARRAY_SIZE(path), L"%s\\%s", dir, names[i]);
+        file = CreateFileW(path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL);
+        ok(file != INVALID_HANDLE_VALUE, "CreateFile failed: %lu\n", GetLastError());
+        CloseHandle(file);
+
+        stg = NULL;
+        hr = StgCreateDocfile(NULL, STGM_READWRITE | STGM_CREATE | STGM_SHARE_EXCLUSIVE | STGM_DELETEONRELEASE, 0, &stg);
+        ok(hr == S_OK, "StgCreateDocfile failed: %#lx\n", hr);
+        obj = NULL;
+        if (SUCCEEDED(hr))
+        {
+            hr = OleCreateFromFile(&CLSID_NULL, path, &IID_IUnknown, OLERENDER_NONE, NULL, NULL, stg, (void **)&obj);
+            ok(hr == S_OK, "OleCreateFromFile failed: %#lx\n", hr);
+        }
+        if (obj)
+        {
+            hr = IUnknown_QueryInterface(obj, &IID_IViewObject2, (void **)&view);
+            ok(hr == S_OK, "QueryInterface(IViewObject2) failed: %#lx\n", hr);
+            if (hr == S_OK)
+            {
+                size.cx = size.cy = 0;
+                hr = IViewObject2_GetExtent(view, DVASPECT_CONTENT, -1, NULL, &size);
+                ok(hr == S_OK, "GetExtent failed: %#lx\n", hr);
+                if (measured)
+                    ok(size.cx == expect.cx && size.cy == expect.cy, "got %ldx%ld, expected %ldx%ld (text %ldx%ld)\n",
+                       size.cx, size.cy, expect.cx, expect.cy, text.cx, text.cy);
+                ok(size.cx > 0 && size.cy > 0, "got %ldx%ld\n", size.cx, size.cy);
+                if (i == 0) first = size;
+                else
+                {
+                    ok(size.cx > first.cx, "width %ld, shortest name %ld\n", size.cx, first.cx);
+                    ok(size.cy == first.cy, "height %ld, shortest name %ld\n", size.cy, first.cy);
+                }
+                hr = IViewObject2_GetExtent(view, DVASPECT_ICON, -1, NULL, &other);
+                ok(hr == S_OK && other.cx == size.cx && other.cy == size.cy,
+                   "DVASPECT_ICON: %#lx %ldx%ld\n", hr, other.cx, other.cy);
+                if (i == 1) check_package_draw(view);
+                IViewObject2_Release(view);
+            }
+            IUnknown_Release(obj);
+        }
+        if (stg) IStorage_Release(stg);
+        DeleteFileW(path);
+        winetest_pop_context();
+    }
+    SelectObject(dc, old_font);
+    DeleteObject(font);
+    ReleaseDC(NULL, dc);
+    RemoveDirectoryW(dir);
+}
