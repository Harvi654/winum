+/* a Package without the UTF-16 names that follow the contents: what older
+ * writers produce (the ANSI name is counted with its terminator) */
+static void write_ansi_package(IStorage *stg, const char *name)
+{
+    static const CLSID clsid_package = {0x0003000c, 0, 0, {0xc0, 0, 0, 0, 0, 0, 0, 0x46}};
+    static const WORD type = 2, unknown[2] = { 0, 3 };
+    static const char data[] = "ansi only\r\n";
+    char path[MAX_PATH];
+    DWORD total, n, size = sizeof(data) - 1;
+    IStream *stm;
+    HRESULT hr;
+
+    sprintf(path, "C:\\%s", name);
+    total = sizeof(type) + strlen(name) + 1 + strlen(path) + 1 + sizeof(unknown) + 4 + strlen(path) + 1 + 4 + size;
+    hr = IStorage_CreateStream(stg, L"\1Ole10Native", STGM_CREATE | STGM_WRITE | STGM_SHARE_EXCLUSIVE, 0, 0, &stm);
+    ok(hr == S_OK, "CreateStream failed: %#lx\n", hr);
+    if (FAILED(hr)) return;
+    IStream_Write(stm, &total, 4, NULL);
+    IStream_Write(stm, &type, 2, NULL);
+    IStream_Write(stm, name, strlen(name) + 1, NULL);
+    IStream_Write(stm, path, strlen(path) + 1, NULL);
+    IStream_Write(stm, unknown, 4, NULL);
+    n = strlen(path) + 1;
+    IStream_Write(stm, &n, 4, NULL);
+    IStream_Write(stm, path, n, NULL);
+    IStream_Write(stm, &size, 4, NULL);
+    IStream_Write(stm, data, size, NULL);
+    IStream_Release(stm);
+    hr = WriteClassStg(stg, &clsid_package);
+    ok(hr == S_OK, "WriteClassStg failed: %#lx\n", hr);
+}
+
+/* loading a Package copies its file into the temporary directory; Windows
+ * 10 fails (E_FAIL) only when the name, or a numbered name for a second
+ * copy, does not fit into MAX_PATH - with or without the UTF-16 names
+ * (measured with pkgprobe parts K and O) */
+static void test_OleCreateFromFile_package_tmp_limit(void)
+{
+    static const struct { int len; HRESULT first, second; } tests[] = {
+        { 105, S_OK, S_OK }, { 106, S_OK, E_FAIL }, { 109, S_OK, E_FAIL }, { 110, E_FAIL, E_FAIL },
+    };
+    WCHAR dir[MAX_PATH], path[MAX_PATH], tmp[MAX_PATH], old_tmp[MAX_PATH], old_temp[MAX_PATH], got[MAX_PATH + 1];
+    IUnknown *obj, *a, *b;
+    IStorage *stg, *stgs[2];
+    char ansi_name[151];
+    HANDLE file;
+    HRESULT hr;
+    DWORD tmp_len, temp_len;
+    int i, j, k, n;
+
+    GetTempPathW(ARRAY_SIZE(dir), dir);
+    swprintf(dir + lstrlenW(dir), MAX_PATH - lstrlenW(dir), L"wtl%lx%lx", GetCurrentProcessId(), GetTickCount());
+    ok(CreateDirectoryW(dir, NULL), "CreateDirectory failed: %lu\n", GetLastError());
+    /* a file name of 150 characters */
+    swprintf(path, ARRAY_SIZE(path), L"%s\\", dir);
+    for (n = lstrlenW(path), j = 0; j < 146; j++) path[n + j] = 'm';
+    lstrcpyW(path + n + 146, L".txt");
+    file = CreateFileW(path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL);
+    ok(file != INVALID_HANDLE_VALUE, "CreateFile failed: %lu\n", GetLastError());
+    CloseHandle(file);
+
+    hr = StgCreateDocfile(NULL, STGM_READWRITE | STGM_CREATE | STGM_SHARE_EXCLUSIVE | STGM_DELETEONRELEASE, 0, &stg);
+    ok(hr == S_OK, "StgCreateDocfile failed: %#lx\n", hr);
+    if (FAILED(hr)) return;
+    obj = NULL;
+    hr = OleCreateFromFile(&CLSID_NULL, path, &IID_IUnknown, OLERENDER_NONE, NULL, NULL, stg, (void **)&obj);
+    ok(hr == S_OK, "OleCreateFromFile failed: %#lx\n", hr);
+    if (obj) IUnknown_Release(obj);
+    stgs[0] = stg;
+    hr = StgCreateDocfile(NULL, STGM_READWRITE | STGM_CREATE | STGM_SHARE_EXCLUSIVE | STGM_DELETEONRELEASE, 0, &stgs[1]);
+    ok(hr == S_OK, "StgCreateDocfile failed: %#lx\n", hr);
+    if (FAILED(hr)) stgs[1] = NULL;
+    memset(ansi_name, 'q', 146);
+    strcpy(ansi_name + 146, ".txt");
+    if (stgs[1]) write_ansi_package(stgs[1], ansi_name);
+
+    tmp_len = GetEnvironmentVariableW(L"TMP", old_tmp, ARRAY_SIZE(old_tmp));
+    temp_len = GetEnvironmentVariableW(L"TEMP", old_temp, ARRAY_SIZE(old_temp));
+    for (i = 0; i < ARRAY_SIZE(tests); i++)
+    {
+        winetest_push_context("%d", tests[i].len);
+        /* a directory whose GetTempPath length is tests[i].len */
+        swprintf(tmp, ARRAY_SIZE(tmp), L"%s\\", dir);
+        for (n = lstrlenW(tmp); n < tests[i].len - 1; n++) tmp[n] = 'k';
+        tmp[n] = 0;
+        ok(CreateDirectoryW(tmp, NULL), "CreateDirectory failed: %lu\n", GetLastError());
+        SetEnvironmentVariableW(L"TMP", tmp);
+        SetEnvironmentVariableW(L"TEMP", tmp);
+        GetTempPathW(ARRAY_SIZE(got), got);
+        ok(lstrlenW(got) == tests[i].len, "GetTempPath length %u\n", lstrlenW(got));
+
+        for (k = 0; k < 2; k++)
+        {
+            if (!stgs[k]) continue;
+            a = b = NULL;
+            hr = OleLoad(stgs[k], &IID_IUnknown, NULL, (void **)&a);
+            ok(hr == tests[i].first, "%s: first load: got %#lx\n", k ? "ANSI only" : "UTF-16", hr);
+            hr = OleLoad(stgs[k], &IID_IUnknown, NULL, (void **)&b);
+            ok(hr == tests[i].second, "%s: second load: got %#lx\n", k ? "ANSI only" : "UTF-16", hr);
+            if (b) IUnknown_Release(b);
+            if (a) IUnknown_Release(a);
+        }
+
+        SetEnvironmentVariableW(L"TMP", tmp_len ? old_tmp : NULL);
+        SetEnvironmentVariableW(L"TEMP", temp_len ? old_temp : NULL);
+        ok(RemoveDirectoryW(tmp), "RemoveDirectory failed: %lu\n", GetLastError());
+        winetest_pop_context();
+    }
+    IStorage_Release(stg);
+    if (stgs[1]) IStorage_Release(stgs[1]);
+    DeleteFileW(path);
+    RemoveDirectoryW(dir);
+}
