+static void test_scf_word(void)
+{
+    static const WCHAR *texts[] = { L"ab cd  e_f1 g.h i'j k-l", L"x \x00e9\x00e8z 12,5 m\tn ?! o" };
+    static const struct { const struct scf_word_point *points; unsigned int count; } tables[] =
+    {
+        { word_text0, ARRAY_SIZE(word_text0) },
+        { word_text1, ARRAY_SIZE(word_text1) },
+    };
+    CHARFORMAT2W cf;
+    unsigned int t, i;
+    char format[32];
+    HWND hwnd;
+    int len;
+
+    hwnd = new_richedit();
+    for (t = 0; t < ARRAY_SIZE(texts); t++)
+    {
+        len = lstrlenW(texts[t]);
+        for (i = 0; i < tables[t].count; i++)
+        {
+            const struct scf_word_point *p = &tables[t].points[i];
+
+            winetest_push_context("text %u, %d-%d", t, p->start, p->end);
+            reset_text(hwnd, texts[t]);
+            set_bold_word(hwnd, p->start, p->end, TRUE);
+            get_format(hwnd, format, len, FALSE);
+            todo_wine_if(p->todo)
+            ok(!strcmp(format, p->format), "got %s, expected %s\n", format, p->format);
+            winetest_pop_context();
+        }
+    }
+
+    /* letters set in another face, then the normal face with SCF_WORD */
+    for (i = 0; i < ARRAY_SIZE(word_face); i++)
+    {
+        const struct scf_word_point *p = &word_face[i];
+
+        winetest_push_context("face, point %d", p->start);
+        SendMessageW(hwnd, WM_SETTEXT, 0, (LPARAM)L"ab gaj cd");
+        memset(&cf, 0, sizeof(cf));
+        cf.cbSize = sizeof(cf);
+        cf.dwMask = CFM_FACE;
+        lstrcpyW(cf.szFaceName, L"Arial");
+        SendMessageW(hwnd, EM_SETCHARFORMAT, SCF_ALL, (LPARAM)&cf);
+        SendMessageW(hwnd, EM_SETSEL, 3, 6);
+        lstrcpyW(cf.szFaceName, L"Courier New");
+        SendMessageW(hwnd, EM_SETCHARFORMAT, SCF_SELECTION, (LPARAM)&cf);
+        SendMessageW(hwnd, EM_SETSEL, p->start, p->end);
+        lstrcpyW(cf.szFaceName, L"Times New Roman");
+        SendMessageW(hwnd, EM_SETCHARFORMAT, SCF_SELECTION | SCF_WORD, (LPARAM)&cf);
+        get_format(hwnd, format, 9, TRUE);
+        todo_wine_if(p->todo)
+        ok(!strcmp(format, p->format), "got %s, expected %s\n", format, p->format);
+        winetest_pop_context();
+    }
+
+    /* paragraphs, format changes, word starts */
+    for (i = 0; i < ARRAY_SIZE(word_cases); i++)
+    {
+        const struct scf_word_case *c = &word_cases[i];
+
+        winetest_push_context("%s, point %d", wine_dbgstr_w(c->text), c->point);
+        reset_text(hwnd, c->text);
+        if (c->mark)
+        {
+            SendMessageW(hwnd, EM_SETSEL, c->mark_start, c->mark_end);
+            memset(&cf, 0, sizeof(cf));
+            cf.cbSize = sizeof(cf);
+            if (c->mark == 1) { cf.dwMask = CFM_ITALIC; cf.dwEffects = CFE_ITALIC; }
+            else { cf.dwMask = CFM_COLOR; cf.crTextColor = RGB(255, 0, 0); }
+            SendMessageW(hwnd, EM_SETCHARFORMAT, SCF_SELECTION, (LPARAM)&cf);
+        }
+        len = SendMessageW(hwnd, WM_GETTEXTLENGTH, 0, 0);
+        ok(len == strlen(c->format), "got length %d\n", len);
+        set_bold_word(hwnd, c->point, c->point, TRUE);
+        get_format(hwnd, format, min(len, ARRAY_SIZE(format) - 1), FALSE);
+        todo_wine_if(c->todo)
+        ok(!strcmp(format, c->format), "got %s, expected %s\n", format, c->format);
+        winetest_pop_context();
+    }
+    DestroyWindow(hwnd);
+}
