+static HWND new_richedit(void)
+{
+    HWND hwnd = CreateWindowW(MSFTEDIT_CLASS, NULL, ES_MULTILINE | WS_POPUP | WS_VISIBLE,
+                              0, 0, 480, 150, NULL, NULL, NULL, NULL);
+    ok(hwnd != NULL, "error %lu\n", GetLastError());
+    return hwnd;
+}
+
+static void get_format(HWND hwnd, char *out, int len, BOOL faces)
+{
+    CHARFORMAT2W cf;
+    int i;
+
+    for (i = 0; i < len; i++)
+    {
+        memset(&cf, 0, sizeof(cf));
+        cf.cbSize = sizeof(cf);
+        SendMessageW(hwnd, EM_SETSEL, i, i + 1);
+        SendMessageW(hwnd, EM_GETCHARFORMAT, SCF_SELECTION, (LPARAM)&cf);
+        if (faces)
+            out[i] = !lstrcmpW(cf.szFaceName, L"Arial") ? 'A' : !lstrcmpW(cf.szFaceName, L"Courier New") ? 'C' :
+                     !lstrcmpW(cf.szFaceName, L"Times New Roman") ? 'T' : '?';
+        else
+            out[i] = (cf.dwMask & CFM_BOLD) && (cf.dwEffects & CFE_BOLD) ? 'B' : '.';
+    }
+    out[len] = 0;
+}
+
+static void set_bold_word(HWND hwnd, int start, int end, BOOL check_point)
+{
+    CHARFORMAT2W cf;
+    LRESULT ret;
+
+    SendMessageW(hwnd, EM_SETSEL, start, end);
+    memset(&cf, 0, sizeof(cf));
+    cf.cbSize = sizeof(cf);
+    cf.dwMask = CFM_BOLD;
+    cf.dwEffects = CFE_BOLD;
+    ret = SendMessageW(hwnd, EM_SETCHARFORMAT, SCF_SELECTION | SCF_WORD, (LPARAM)&cf);
+    ok(ret == 1, "got %Id\n", ret);
+    if (!check_point) return;
+    /* the insertion point itself takes the format */
+    memset(&cf, 0, sizeof(cf));
+    cf.cbSize = sizeof(cf);
+    SendMessageW(hwnd, EM_GETCHARFORMAT, SCF_SELECTION, (LPARAM)&cf);
+    ok((cf.dwMask & CFM_BOLD) && (cf.dwEffects & CFE_BOLD), "insertion point not bold\n");
+}
+
+static void reset_text(HWND hwnd, const WCHAR *text)
+{
+    CHARFORMAT2W cf;
+
+    SendMessageW(hwnd, WM_SETTEXT, 0, (LPARAM)text);
+    memset(&cf, 0, sizeof(cf));
+    cf.cbSize = sizeof(cf);
+    cf.dwMask = CFM_BOLD | CFM_ITALIC | CFM_COLOR;
+    SendMessageW(hwnd, EM_SETCHARFORMAT, SCF_ALL, (LPARAM)&cf);
+}
