+/* Windows of both classes in one process, created and destroyed in turn:
+ * at the end of a word before a space SCF_WORD formats nothing in
+ * msftedit's RichEdit50W and the word with the space in riched20's
+ * RichEdit20W (measured on Windows 10, x86_64 and i686). */
+static void test_scf_word_classes(void)
+{
+    static const struct { const WCHAR *cls; const char *format; } classes[] =
+    {
+        { MSFTEDIT_CLASS, "......................." },
+        { L"RichEdit20W", "BBB...................." },
+    };
+    char format[32];
+    unsigned int i, c;
+    HWND hwnd;
+
+    if (!LoadLibraryA("riched20.dll"))
+    {
+        win_skip("riched20.dll not available\n");
+        return;
+    }
+    for (i = 0; i < 3; i++)
+        for (c = 0; c < ARRAY_SIZE(classes); c++)
+        {
+            winetest_push_context("round %u, %s", i, wine_dbgstr_w(classes[c].cls));
+            hwnd = CreateWindowW(classes[c].cls, NULL, ES_MULTILINE | WS_POPUP | WS_VISIBLE,
+                                 0, 0, 480, 150, NULL, NULL, NULL, NULL);
+            ok(hwnd != NULL, "error %lu\n", GetLastError());
+            reset_text(hwnd, L"ab cd  e_f1 g.h i'j k-l");
+            set_bold_word(hwnd, 2, 2, TRUE);
+            get_format(hwnd, format, 23, FALSE);
+            ok(!strcmp(format, classes[c].format), "got %s, expected %s\n", format, classes[c].format);
+            DestroyWindow(hwnd);
+            winetest_pop_context();
+        }
+}
+
+START_TEST(editor)
+{
+    HMODULE module = LoadLibraryA("msftedit.dll");
+    ok(module != NULL, "error %lu\n", GetLastError());
+
+    test_scf_word();
+    test_scf_word_classes();
+}
