+static HWND new_scf_word_richedit(void)
+{
+    HWND hwnd = CreateWindowW(RICHEDIT_CLASS20W, NULL, ES_MULTILINE | WS_POPUP | WS_VISIBLE,
+                              0, 0, 480, 150, NULL, NULL, NULL, NULL);
+    ok(hwnd != NULL, "error %lu\n", GetLastError());
+    return hwnd;
+}
+
+static void get_scf_word_format(HWND hwnd, char *out, int len, BOOL faces)
+{
+    CHARFORMAT2W cf;
+    int i;
+
+    for (i = 0; i < len; i++)
+    {
+        memset(&cf, 0, sizeof(cf));
+        cf.cbSize = sizeof(cf);
+        SendMessageW(hwnd, EM_SETSEL, i, i + 1);
+        SendMessageW(hwnd, EM_GETCHARFORMAT, SCF_SELECTION, (LPARAM)&cf);
+        if (faces)
+            out[i] = !lstrcmpW(cf.szFaceName, L"Arial") ? 'A' : !lstrcmpW(cf.szFaceName, L"Courier New") ? 'C' :
+                     !lstrcmpW(cf.szFaceName, L"Times New Roman") ? 'T' : '?';
+        else
+            out[i] = (cf.dwMask & CFM_BOLD) && (cf.dwEffects & CFE_BOLD) ? 'B' : '.';
+    }
+    out[len] = 0;
+}
+
+static void set_scf_word_bold(HWND hwnd, int start, int end, BOOL check_point)
+{
+    CHARFORMAT2W cf;
+    LRESULT ret;
+
+    SendMessageW(hwnd, EM_SETSEL, start, end);
+    memset(&cf, 0, sizeof(cf));
+    cf.cbSize = sizeof(cf);
+    cf.dwMask = CFM_BOLD;
+    cf.dwEffects = CFE_BOLD;
+    ret = SendMessageW(hwnd, EM_SETCHARFORMAT, SCF_SELECTION | SCF_WORD, (LPARAM)&cf);
+    ok(ret == 1, "got %Id\n", ret);
+    if (!check_point) return;
+    /* the insertion point itself takes the format */
+    memset(&cf, 0, sizeof(cf));
+    cf.cbSize = sizeof(cf);
+    SendMessageW(hwnd, EM_GETCHARFORMAT, SCF_SELECTION, (LPARAM)&cf);
+    ok((cf.dwMask & CFM_BOLD) && (cf.dwEffects & CFE_BOLD), "insertion point not bold\n");
+}
+
+static void reset_scf_word_text(HWND hwnd, const WCHAR *text)
+{
+    CHARFORMAT2W cf;
+
+    SendMessageW(hwnd, WM_SETTEXT, 0, (LPARAM)text);
+    memset(&cf, 0, sizeof(cf));
+    cf.cbSize = sizeof(cf);
+    cf.dwMask = CFM_BOLD | CFM_ITALIC | CFM_COLOR;
+    SendMessageW(hwnd, EM_SETCHARFORMAT, SCF_ALL, (LPARAM)&cf);
+}
+
+static void test_EM_SETCHARFORMAT_word_point(void)
+{
+    static const WCHAR *texts[] = { L"ab cd  e_f1 g.h i'j k-l", L"x \x00e9\x00e8z 12,5 m\tn ?! o" };
+    static const struct { const struct scf_word_point *points; unsigned int count; } tables[] =
+    {
+        { word_text0, ARRAY_SIZE(word_text0) },
+        { word_text1, ARRAY_SIZE(word_text1) },
+    };
+    CHARFORMAT2W cf;
+    unsigned int t, i;
+    char format[32];
+    HWND hwnd;
+    int len;
+
+    hwnd = new_scf_word_richedit();
+    for (t = 0; t < ARRAY_SIZE(texts); t++)
+    {
+        len = lstrlenW(texts[t]);
+        for (i = 0; i < tables[t].count; i++)
+        {
+            const struct scf_word_point *p = &tables[t].points[i];
+
+            winetest_push_context("text %u, %d-%d", t, p->start, p->end);
+            reset_scf_word_text(hwnd, texts[t]);
+            set_scf_word_bold(hwnd, p->start, p->end, TRUE);
+            get_scf_word_format(hwnd, format, len, FALSE);
+            todo_wine_if(p->todo)
+            ok(!strcmp(format, p->format), "got %s, expected %s\n", format, p->format);
+            winetest_pop_context();
+        }
+    }
+
+    /* letters set in another face, then the normal face with SCF_WORD */
+    for (i = 0; i < ARRAY_SIZE(word_face); i++)
+    {
+        const struct scf_word_point *p = &word_face[i];
+
+        winetest_push_context("face, point %d", p->start);
+        SendMessageW(hwnd, WM_SETTEXT, 0, (LPARAM)L"ab gaj cd");
+        memset(&cf, 0, sizeof(cf));
+        cf.cbSize = sizeof(cf);
+        cf.dwMask = CFM_FACE;
+        lstrcpyW(cf.szFaceName, L"Arial");
+        SendMessageW(hwnd, EM_SETCHARFORMAT, SCF_ALL, (LPARAM)&cf);
+        SendMessageW(hwnd, EM_SETSEL, 3, 6);
+        lstrcpyW(cf.szFaceName, L"Courier New");
+        SendMessageW(hwnd, EM_SETCHARFORMAT, SCF_SELECTION, (LPARAM)&cf);
+        SendMessageW(hwnd, EM_SETSEL, p->start, p->end);
+        lstrcpyW(cf.szFaceName, L"Times New Roman");
+        SendMessageW(hwnd, EM_SETCHARFORMAT, SCF_SELECTION | SCF_WORD, (LPARAM)&cf);
+        get_scf_word_format(hwnd, format, 9, TRUE);
+        todo_wine_if(p->todo)
+        ok(!strcmp(format, p->format), "got %s, expected %s\n", format, p->format);
+        winetest_pop_context();
+    }
+
+    /* paragraphs, format changes, word starts */
+    for (i = 0; i < ARRAY_SIZE(word_cases); i++)
+    {
+        const struct scf_word_case *c = &word_cases[i];
+
+        winetest_push_context("%s, point %d", wine_dbgstr_w(c->text), c->point);
+        reset_scf_word_text(hwnd, c->text);
+        if (c->mark)
+        {
+            SendMessageW(hwnd, EM_SETSEL, c->mark_start, c->mark_end);
+            memset(&cf, 0, sizeof(cf));
+            cf.cbSize = sizeof(cf);
+            if (c->mark == 1) { cf.dwMask = CFM_ITALIC; cf.dwEffects = CFE_ITALIC; }
+            else { cf.dwMask = CFM_COLOR; cf.crTextColor = RGB(255, 0, 0); }
+            SendMessageW(hwnd, EM_SETCHARFORMAT, SCF_SELECTION, (LPARAM)&cf);
+        }
+        len = SendMessageW(hwnd, WM_GETTEXTLENGTH, 0, 0);
+        ok(len == strlen(c->format), "got length %d\n", len);
+        set_scf_word_bold(hwnd, c->point, c->point, TRUE);
+        get_scf_word_format(hwnd, format, min(len, ARRAY_SIZE(format) - 1), FALSE);
+        todo_wine_if(c->todo)
+        ok(!strcmp(format, c->format), "got %s, expected %s\n", format, c->format);
+        winetest_pop_context();
+    }
+    DestroyWindow(hwnd);
+}
