+enum word_class { WORD_CLASS_BREAK, WORD_CLASS_SPACE, WORD_CLASS_WORD, WORD_CLASS_PUNCT };
+
+static WCHAR char_at_ofs( ME_TextEditor *editor, int ofs )
+{
+    WCHAR buf[2] = { 0 };
+    ME_Cursor cursor;
+
+    cursor_from_char_ofs( editor, ofs, &cursor );
+    ME_GetTextW( editor, buf, ARRAY_SIZE(buf), &cursor, 1, FALSE, FALSE );
+    return buf[0];
+}
+
+/* an apostrophe between two word characters belongs to the word */
+static enum word_class word_class_at( ME_TextEditor *editor, int ofs, int len )
+{
+    WCHAR c = char_at_ofs( editor, ofs );
+
+    if (c == '\'' && ofs > 0 && ofs + 1 < len && iswalnum( char_at_ofs( editor, ofs - 1 ) ) &&
+        iswalnum( char_at_ofs( editor, ofs + 1 ) ))
+        return WORD_CLASS_WORD;
+    if (iswalnum( c )) return WORD_CLASS_WORD;
+    if (c == ' ' || c == '\t') return WORD_CLASS_SPACE;
+    if (!c || c == '\r' || c == '\n' || c == '\v' || c == WCH_EMBEDDING) return WORD_CLASS_BREAK;
+    return WORD_CLASS_PUNCT;
+}
+
+/* The range SCF_WORD formats at an empty insertion point, as msftedit does:
+   only when the characters on both sides are of the same class - the word
+   (letters, digits, inner apostrophes) or the run of punctuation around the
+   point, or between spaces the word before them with the spaces. */
+static BOOL scf_word_range( ME_TextEditor *editor, ME_Cursor *start, ME_Cursor *end )
+{
+    int len = ME_GetTextLength( editor ), ofs = ME_GetCursorOfs( &editor->pCursors[0] );
+    enum word_class class;
+    int from, to;
+
+    if (ofs <= 0 || ofs >= len) return FALSE;
+    class = word_class_at( editor, ofs - 1, len );
+    if (class == WORD_CLASS_BREAK || class != word_class_at( editor, ofs, len )) return FALSE;
+
+    from = ofs - 1;
+    while (from > 0 && word_class_at( editor, from - 1, len ) == class) from--;
+    to = ofs + 1;
+    while (to < len && word_class_at( editor, to, len ) == class) to++;
+    if (class == WORD_CLASS_SPACE)
+        while (from > 0 && word_class_at( editor, from - 1, len ) == WORD_CLASS_WORD) from--;
+
+    cursor_from_char_ofs( editor, from, start );
+    cursor_from_char_ofs( editor, to, end );
+    return TRUE;
+}
