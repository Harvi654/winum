@@ -224,6 +224,7 @@
     textfont_prop_val props[FONT_PROPID_LAST];
     BOOL get_cache_enabled;
     BOOL set_cache_enabled;
+    BOOL apply_tmp;
 } ITextFontImpl;
 
 typedef struct ITextParaImpl {
@@ -727,6 +728,9 @@
     CHARFORMAT2W fmt;
     LONG start, end;
 
+    if (font->apply_tmp)
+        TRACE("temporary formatting, property %d not applied\n", propid);
+
     /* when font is not attached to any range use cache */
     if (!font->range || font->set_cache_enabled) {
         if (propid == FONT_NAME) {
@@ -3004,11 +3008,32 @@
             This->get_cache_enabled = FALSE;
             break;
         case tomApplyLater:
+            /* temporary changes stay temporary: a following tomApplyNow
+               drops them as well */
             This->set_cache_enabled = TRUE;
             break;
         case tomApplyNow:
             This->set_cache_enabled = FALSE;
-            textfont_apply_range_props(This);
+            /* temporary (display-only) formatting is not supported: drop it
+               instead of writing it into the text */
+            if (This->apply_tmp)
+                This->apply_tmp = FALSE;
+            else
+                textfont_apply_range_props(This);
+            break;
+        case tomApplyTmp:
+            /* riched20's RichEdit20W rejects temporary formatting */
+            if (!get_range_reole( This->range )->editor->msftedit)
+                return E_INVALIDARG;
+            /* Temporary formatting is shown on screen only and never becomes
+               part of the text (spell checkers use it for the wavy underline
+               under misspelled words). It is not implemented; collect the
+               following changes in the cache and drop them, rather than
+               applying them as real formatting. */
+            WARN("temporary formatting (tomApplyTmp) not supported, ignored\n");
+            textfont_cache_range_props(This);
+            This->set_cache_enabled = TRUE;
+            This->apply_tmp = TRUE;
             break;
         case tomUsePoints:
         case tomUseTwips:
@@ -3495,6 +3520,7 @@
 
     font->ITextFont_iface.lpVtbl = &textfontvtbl;
     font->ref = 1;
+    font->apply_tmp = FALSE;
 
     if (src) {
         font->range = NULL;
--- a/dlls/riched20/tests/richole.c
+++ b/dlls/riched20/tests/richole.c
@@ -3215,6 +3215,121 @@
   release_interfaces(&hwnd, &reOle, &doc, NULL);
 }
 
+/* ITextFont::Reset(tomApplyTmp) in riched20's RichEdit20W (the W class that
+ * was measured), as measured on
+ * Windows 10 (x86_64 and i686): it fails with E_INVALIDARG and the setters
+ * that follow change the text at once. (msftedit's class accepts it; see
+ * msftedit's richole tests.) */
+static HWND create_class_document(const WCHAR *cls, IRichEditOle **ole, ITextDocument **doc)
+{
+    HWND hwnd = CreateWindowW(cls, NULL, ES_MULTILINE | WS_POPUP | WS_VISIBLE,
+                              0, 0, 200, 60, NULL, NULL, NULL, NULL);
+    ok(hwnd != NULL, "class %s: error %lu\n", wine_dbgstr_w(cls), GetLastError());
+    *ole = NULL;
+    SendMessageW(hwnd, EM_GETOLEINTERFACE, 0, (LPARAM)ole);
+    ok(*ole != NULL, "no IRichEditOle\n");
+    IRichEditOle_QueryInterface(*ole, &IID_ITextDocument, (void **)doc);
+    return hwnd;
+}
+
+static void test_textfont_applytmp_riched20(void)
+{
+    ITextDocument *doc;
+    IRichEditOle *ole;
+    ITextRange *range;
+    ITextFont *font, *dup;
+    CHARFORMAT2W cf;
+    unsigned int i, c;
+    HRESULT hr;
+    LONG value;
+    HWND hwnd;
+
+    hwnd = create_class_document(L"RichEdit20W", &ole, &doc);
+    /* "abc def ghi" in green, "def" red and bold */
+    SendMessageW(hwnd, WM_SETTEXT, 0, (LPARAM)L"abc def ghi");
+    memset(&cf, 0, sizeof(cf));
+    cf.cbSize = sizeof(cf);
+    cf.dwMask = CFM_COLOR | CFM_BOLD;
+    cf.crTextColor = RGB(0, 128, 0);
+    SendMessageW(hwnd, EM_SETCHARFORMAT, SCF_ALL, (LPARAM)&cf);
+    SendMessageW(hwnd, EM_SETSEL, 4, 7);
+    cf.crTextColor = RGB(255, 0, 0);
+    cf.dwEffects = CFE_BOLD;
+    SendMessageW(hwnd, EM_SETCHARFORMAT, SCF_SELECTION, (LPARAM)&cf);
+
+    hr = ITextDocument_Range(doc, 4, 7, &range);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = ITextRange_GetFont(range, &font);
+    ok(hr == S_OK, "got %#lx\n", hr);
+
+    hr = ITextFont_Reset(font, tomApplyTmp);
+    ok(hr == E_INVALIDARG, "got %#lx\n", hr);
+    hr = ITextFont_SetUnderline(font, tomWave);
+    todo_wine ok(hr == S_OK, "got %#lx\n", hr);
+    hr = ITextFont_SetForeColor(font, RGB(0, 0, 255));
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = ITextFont_SetBold(font, tomFalse);
+    ok(hr == S_OK, "got %#lx\n", hr);
+
+    /* the changes are in the text at once */
+    hr = ITextFont_GetForeColor(font, &value);
+    ok(hr == S_OK && (COLORREF)value == RGB(0, 0, 255), "got %#lx, color %#lx\n", hr, value);
+    hr = ITextFont_GetBold(font, &value);
+    ok(hr == S_OK && value == tomFalse, "got %#lx, bold %ld\n", hr, value);
+    memset(&cf, 0, sizeof(cf));
+    cf.cbSize = sizeof(cf);
+    SendMessageW(hwnd, EM_SETSEL, 4, 7);
+    SendMessageW(hwnd, EM_GETCHARFORMAT, SCF_SELECTION, (LPARAM)&cf);
+    ok((cf.dwMask & CFM_COLOR) && cf.crTextColor == RGB(0, 0, 255), "got mask %#lx color %#lx\n", cf.dwMask, cf.crTextColor);
+    ok((cf.dwMask & CFM_BOLD) && !(cf.dwEffects & CFE_BOLD), "got mask %#lx effects %#lx\n", cf.dwMask, cf.dwEffects);
+
+    /* tomApplyNow writes no older values back */
+    hr = ITextFont_Reset(font, tomApplyNow);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    memset(&cf, 0, sizeof(cf));
+    cf.cbSize = sizeof(cf);
+    SendMessageW(hwnd, EM_SETSEL, 4, 7);
+    SendMessageW(hwnd, EM_GETCHARFORMAT, SCF_SELECTION, (LPARAM)&cf);
+    todo_wine ok((cf.dwMask & CFM_COLOR) && cf.crTextColor == RGB(0, 0, 255), "got mask %#lx color %#lx\n", cf.dwMask, cf.crTextColor);
+    todo_wine ok((cf.dwMask & CFM_BOLD) && !(cf.dwEffects & CFE_BOLD), "got mask %#lx effects %#lx\n", cf.dwMask, cf.dwEffects);
+
+    /* a font that is not attached to a range */
+    hr = ITextFont_GetDuplicate(font, &dup);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = ITextFont_Reset(dup, tomApplyTmp);
+    todo_wine ok(hr == E_INVALIDARG, "got %#lx\n", hr);
+    ITextFont_Release(dup);
+
+    ITextFont_Release(font);
+    ITextRange_Release(range);
+    release_interfaces(&hwnd, &ole, &doc, NULL);
+
+    /* both classes in turn in one process: msftedit's RichEdit50W accepts
+     * tomApplyTmp (S_OK), RichEdit20W does not (measured) */
+    if (!LoadLibraryA("msftedit.dll"))
+    {
+        win_skip("msftedit.dll not available\n");
+        return;
+    }
+    for (i = 0; i < 3; i++)
+        for (c = 0; c < 2; c++)
+        {
+            winetest_push_context("round %u, %s", i, c ? "RichEdit20W" : "RichEdit50W");
+            hwnd = create_class_document(c ? L"RichEdit20W" : L"RichEdit50W", &ole, &doc);
+            SendMessageW(hwnd, WM_SETTEXT, 0, (LPARAM)L"abc def ghi");
+            hr = ITextDocument_Range(doc, 4, 7, &range);
+            ok(hr == S_OK, "got %#lx\n", hr);
+            hr = ITextRange_GetFont(range, &font);
+            ok(hr == S_OK, "got %#lx\n", hr);
+            hr = ITextFont_Reset(font, tomApplyTmp);
+            ok(hr == (c ? E_INVALIDARG : S_OK), "got %#lx\n", hr);
+            ITextFont_Release(font);
+            ITextRange_Release(range);
+            release_interfaces(&hwnd, &ole, &doc, NULL);
+            winetest_pop_context();
+        }
+}
+
