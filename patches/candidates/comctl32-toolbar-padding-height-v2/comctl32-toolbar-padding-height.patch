From: Harvi654 <202698022+Harvi654@users.noreply.github.com>
Subject: [PATCH] comctl32/toolbar: Use the TB_SETPADDING height when measuring buttons.

AI-assisted (Claude), original code; LGPL-2.1-or-later. Not submitted
upstream.

Windows 10 (x86_64 and i686, comctl32 5.82 and 6.16 give the same values,
measured with winum docs/wine-repro/comctl32-toolbar-padding-height,
windows-2026-11-09): when a toolbar recalculates its button size (strings
added before the buttons), the button is the bitmap height + the
TB_SETPADDING height + 1 + the text height high, and the bitmap width + the
TB_SETPADDING width wide: with a 16x16 image list the default padding 7x6
gives 23x38, padding 0x0 gives 16x32 (the width: the wider of bitmap and
text + the padding width). TB_SETBUTTONSIZE does not go below
bitmap + padding (16x16 for padding 0x0).

Wine used the padding for the width but a fixed 6 for the height, so a
toolbar that sets a smaller padding got taller buttons than on Windows;
Inventor's symbol palette (padding 0) needed a scroll bar.

The change is limited to the non-list layout with a bitmap, the case
measured. Not changed, and different from Windows (open points, not in
this patch):
- TB_SETPADDING clamps the padding to SM_CXEDGE/SM_CYEDGE; Windows keeps
  e.g. 16x16, and treats 0xffff x 0xffff as the default 7x6. The test
  therefore uses paddings up to 2x2.
- a toolbar with an image list but no strings: Windows keeps 23x22 when the
  image list is set, Wine recalculates (width already from the padding
  before this patch); the test marks it todo_wine.
- TBSTYLE_LIST: Windows uses the padding height there too, Wine 6.

v2 (2026-11-09): adds the Wine test, with expected values from the
Windows measurement; the code change is the one of v1.

--- a/dlls/comctl32/tests/toolbar.c
+++ b/dlls/comctl32/tests/toolbar.c
@@ -3150,6 +3150,128 @@
     DestroyWindow(hToolbar);
 }
 
+/* Button sizes after TB_SETPADDING, as measured on Windows 10 (v5 and v6
+ * give the same values): when the size is recalculated, the height padding
+ * is the TB_SETPADDING height, like the width; a toolbar without strings
+ * keeps its size when an image list is set. */
+static void test_padding_height(void)
+{
+    static const DWORD styles[] =
+    {
+        0, TBSTYLE_FLAT, TBSTYLE_FLAT | TBSTYLE_WRAPABLE | CCS_VERT,
+    };
+    static const struct { int set; WORD cx, cy; } paddings[] =
+    {
+        { 0 }, { 1, 0, 0 }, { 1, 1, 1 }, { 1, 2, 2 },
+    };
+    HIMAGELIST (WINAPI *pImageList_Create)(int, int, UINT, int, int);
+    int (WINAPI *pImageList_Add)(HIMAGELIST, HBITMAP, HBITMAP);
+    BOOL (WINAPI *pImageList_Destroy_)(HIMAGELIST);
+    DWORD size, pad, def_size = 0;
+    unsigned int s, c, p;
+    TBBUTTON buttons[4];
+    HIMAGELIST himl;
+    HBITMAP bitmap;
+    HMODULE module;
+    HWND toolbar;
+    LRESULT first;
+    int i, cx, cy;
+    HDC hdc;
+
+    /* the image list functions of the comctl32 version in use */
+    module = GetModuleHandleA("comctl32.dll");
+    pImageList_Create = (void *)GetProcAddress(module, "ImageList_Create");
+    pImageList_Add = (void *)GetProcAddress(module, "ImageList_Add");
+    pImageList_Destroy_ = (void *)GetProcAddress(module, "ImageList_Destroy");
+
+    hdc = GetDC(NULL);
+    bitmap = CreateCompatibleBitmap(hdc, 64, 16);
+    ReleaseDC(NULL, hdc);
+
+    for (s = 0; s < ARRAY_SIZE(styles); s++)
+    {
+        /* content 0: 16x16 image list and strings; 1: strings, no image list
+         * (I_IMAGENONE); 2: image list, no strings; 3: neither */
+        for (c = 0; c < 4; c++)
+        {
+            for (p = 0; p < ARRAY_SIZE(paddings); p++)
+            {
+                winetest_push_context("style %#lx content %u padding %u", styles[s], c, p);
+                toolbar = CreateWindowExA(0, TOOLBARCLASSNAMEA, NULL, WS_CHILD | WS_VISIBLE | styles[s],
+                                          0, 0, 0, 0, hMainWnd, (HMENU)5, GetModuleHandleA(NULL), NULL);
+                ok(toolbar != NULL, "failed to create toolbar\n");
+                SendMessageA(toolbar, TB_BUTTONSTRUCTSIZE, sizeof(TBBUTTON), 0);
+                if (paddings[p].set)
+                {
+                    SendMessageA(toolbar, TB_SETPADDING, 0, MAKELPARAM(paddings[p].cx, paddings[p].cy));
+                    pad = SendMessageA(toolbar, TB_GETPADDING, 0, 0);
+                    ok(pad == MAKELONG(paddings[p].cx, paddings[p].cy), "got padding %#lx\n", pad);
+                }
+                himl = NULL;
+                if (c == 0 || c == 2)
+                {
+                    himl = pImageList_Create(16, 16, ILC_COLOR24, 4, 0);
+                    ok(pImageList_Add(himl, bitmap, NULL) == 0, "ImageList_Add failed\n");
+                    SendMessageA(toolbar, TB_SETIMAGELIST, 0, (LPARAM)himl);
+                }
+                first = -1;
+                if (c <= 1)
+                    first = SendMessageA(toolbar, TB_ADDSTRINGA, 0, (LPARAM)"Ab\0Cd\0Ef\0Gh\0");
+                memset(buttons, 0, sizeof(buttons));
+                for (i = 0; i < 4; i++)
+                {
+                    buttons[i].iBitmap = c == 1 ? I_IMAGENONE : i;
+                    buttons[i].idCommand = 100 + i;
+                    buttons[i].fsState = TBSTATE_ENABLED;
+                    buttons[i].fsStyle = BTNS_BUTTON;
+                    buttons[i].iString = first >= 0 ? first + i : -1;
+                }
+                ok(SendMessageA(toolbar, TB_ADDBUTTONSA, 4, (LPARAM)buttons), "TB_ADDBUTTONS failed\n");
+                SendMessageA(toolbar, TB_AUTOSIZE, 0, 0);
+                size = SendMessageA(toolbar, TB_GETBUTTONSIZE, 0, 0);
+
+                if (!paddings[p].set)
+                {
+                    /* the default padding is 7 x 6 */
+                    def_size = size;
+                    if (c >= 2)
+                        ok(size == MAKELONG(23, 22), "got size %#lx\n", size);
+                    else
+                        ok(HIWORD(size) > 16 + 6 + 1, "got size %#lx\n", size);
+                }
+                else if (c <= 1)
+                {
+                    /* recalculated with the strings: both paddings count */
+                    cx = LOWORD(def_size) - 7 + paddings[p].cx;
+                    cy = HIWORD(def_size) - 6 + paddings[p].cy;
+                    ok(size == MAKELONG(cx, cy), "got size %#lx, expected %dx%d\n", size, cx, cy);
+                }
+                else
+                {
+                    /* not recalculated: still the default size */
+                    todo_wine_if(c == 2)
+                    ok(size == MAKELONG(23, 22), "got size %#lx\n", size);
+                }
+
+                /* TB_SETBUTTONSIZE does not go below the 16x16 images + padding */
+                if (himl)
+                {
+                    SendMessageA(toolbar, TB_SETBUTTONSIZE, 0, MAKELPARAM(1, 1));
+                    size = SendMessageA(toolbar, TB_GETBUTTONSIZE, 0, 0);
+                    cx = 16 + (paddings[p].set ? paddings[p].cx : 7);
+                    cy = 16 + (paddings[p].set ? paddings[p].cy : 6);
+                    ok(size == MAKELONG(cx, cy), "got size %#lx after TB_SETBUTTONSIZE, expected %dx%d\n", size, cx, cy);
+                }
+
+                DestroyWindow(toolbar);
+                if (himl) pImageList_Destroy_(himl);
+                winetest_pop_context();
+            }
+        }
+    }
+    DeleteObject(bitmap);
+}
+
 START_TEST(toolbar)
 {
     ULONG_PTR ctx_cookie;
@@ -3206,6 +3328,7 @@
     test_WM_ERASEBKGND(FALSE);
     test_WM_PAINT(FALSE);
     test_wrap();
+    test_padding_height();
 
     if (!load_v6_module(&ctx_cookie, &ctx))
         return;
@@ -3217,6 +3340,7 @@
     test_WM_ERASEBKGND(TRUE);
     test_WM_PAINT(TRUE);
     test_wrap();
+    test_padding_height();
 
     PostQuitMessage(0);
     while(GetMessageA(&msg,0,0,0)) {
--- a/dlls/comctl32/toolbar.c
+++ b/dlls/comctl32/toolbar.c
@@ -1669,7 +1669,10 @@
     {
         if (bHasBitmap)
         {
-            sizeButton.cy = infoPtr->nBitmapHeight + DEFPAD_CY;
+            /* the height padding is the one set with TB_SETPADDING, like the
+               width (DEFPAD_CY by default) - Inventor's symbol palette sets
+               0 for rows as tall as its 16 pixel symbols */
+            sizeButton.cy = infoPtr->nBitmapHeight + infoPtr->szPadding.cy;
             if (sizeString.cy > 0)
                 sizeButton.cy += 1 + sizeString.cy;
             sizeButton.cx = infoPtr->szPadding.cx +
