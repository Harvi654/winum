+/* TB_SETROWS in a vertical wrapable toolbar (measured on Windows 10,
+ * comctl32 5 and 6): every group of buttons between separators starts a
+ * new row and a separator has a row of its own. The number of buttons per
+ * row is the one that gives the most button rows not above the request,
+ * or with bLarger the fewest that reach it; separators are not counted. */
+static void
+TOOLBAR_SetRowsVertical (TOOLBAR_INFO *infoPtr, INT rows, BOOL bLarger)
+{
+    TBUTTON_INFO *btnPtr = infoPtr->buttons;
+    INT buttons = 0, columns, i;
+
+    if (infoPtr->nRows == rows && infoPtr->nRowsColumns) return;
+
+    for (i = 0; i < infoPtr->nNumButtons; i++)
+        if (!(btnPtr[i].fsState & TBSTATE_HIDDEN) && !(btnPtr[i].fsStyle & BTNS_SEP))
+            buttons++;
+
+    if (rows < 1) rows = 1;
+    for (columns = 1; columns < buttons; columns++)
+        if (TOOLBAR_WrapColumns(infoPtr, columns) <= rows)
+            break;
+    if (bLarger && columns > 1 && TOOLBAR_WrapColumns(infoPtr, columns) < rows)
+        columns--;
+    if (columns < 1) columns = 1;
+
+    TRACE("Trying to wrap at %d (%d buttons, %d rows)\n", columns, buttons, rows);
+    TOOLBAR_WrapColumns(infoPtr, columns);
+    infoPtr->nRowsColumns = columns;
+
+    TOOLBAR_CalcToolbar (infoPtr);
+    TRACE("Result - %d rows, %ld x %ld\n", infoPtr->nRows,
+          infoPtr->rcBound.right - infoPtr->rcBound.left,
+          infoPtr->rcBound.bottom - infoPtr->rcBound.top);
+
+    /* As below: resize only with CCS_NORESIZE. This resize keeps the rows. */
+    if (infoPtr->dwStyle & CCS_NORESIZE)
+    {
+        infoPtr->bSettingRows = TRUE;
+        SetWindowPos(infoPtr->hwndSelf, NULL, 0, 0,
+                     infoPtr->rcBound.right - infoPtr->rcBound.left,
+                     infoPtr->rcBound.bottom - infoPtr->rcBound.top,
+                     SWP_NOMOVE | SWP_NOZORDER | SWP_NOACTIVATE);
+        infoPtr->bSettingRows = FALSE;
+    }
+
+    InvalidateRect(infoPtr->hwndSelf, NULL, TRUE);
+}
+
