-{
-    LONG expand_start, expand_end;
+static ME_Paragraph *textrange_paragraph_at(ME_TextEditor *editor, LONG offset)
+{
+    ME_Cursor cursor;
+
+    cursor_from_char_ofs(editor, offset, &cursor);
+    return cursor.para;
+}
+
+/* Count boundaries reached, with the last legal position set by the endpoint. */
+static LONG textrange_move_paragraphs(ME_TextEditor *editor, LONG *offset, LONG count, LONG limit)
+{
+    ME_Paragraph *para = textrange_paragraph_at(editor, *offset);
+    LONG moved = 0;
+
+    while (count > 0 && *offset < limit)
+    {
+        para = para_next(para);
+        *offset = min(para->nCharOfs, limit);
+        --count;
+        ++moved;
+    }
+
+    while (count < 0)
+    {
+        if (*offset <= para->nCharOfs)
+            para = para_prev(para);
+        if (!para)
+            break;
+        *offset = para->nCharOfs;
+        ++count;
+        --moved;
+    }
+    return moved;
+}
+
+static HRESULT textrange_expand(ITextRange *range, ME_TextEditor *editor, LONG unit, LONG *delta)
+{
+    LONG expand_start, expand_end, start, end;
+
+    if (unit == tomParagraph || delta)
+    {
+        ITextRange_GetStart(range, &start);
+        ITextRange_GetEnd(range, &end);
+    }
 
     switch (unit)
     {
     case tomStory:
         expand_start = 0;
         ITextRange_GetStoryLength(range, &expand_end);
         break;
+    case tomParagraph:
+    {
+        expand_start = textrange_paragraph_at(editor, start)->nCharOfs;
+        /* A nonempty range ends after its last included character. */
+        expand_end = para_next(textrange_paragraph_at(editor, end > start ? end - 1 : end))->nCharOfs;
+        break;
+    }
     default:
         FIXME("unit %ld is not supported\n", unit);
         return E_NOTIMPL;
     }
 
-    if (delta) {
-        LONG start, end;
-
-        ITextRange_GetStart(range, &start);
-        ITextRange_GetEnd(range, &end);
+    if (delta)
         *delta = expand_end - expand_start - (end - start);
-    }
+    if (unit == tomParagraph && start == expand_start && end == expand_end)
+        return S_FALSE;
 
     ITextRange_SetStart(range, expand_start);
     ITextRange_SetEnd(range, expand_end);
 
     return S_OK;
 }
