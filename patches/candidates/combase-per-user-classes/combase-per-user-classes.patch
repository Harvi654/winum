From: Harvi654 <202698022+Harvi654@users.noreply.github.com>
Subject: [PATCH] combase: Look up per-user in-process classes.

AI-assisted (Codex), original code; LGPL-2.1-or-later. Not submitted upstream.

Non-elevated Windows 10 selected the user registration over the machine
registration when both named the same in-process class. It also resolved
the per-user ProgID and TreatAs keys. Search the current user's classes
before the existing machine lookup for those reads. Keep explicit registry
view selection and preserve other HKCR callers.

v2 (2026-11-24): The native Windows 10 fixture found that High integrity
callers cannot activate a class registered only in HKCU. Use the thread
token when impersonating and otherwise the process token. At High or
above, or if integrity cannot be determined, use the existing machine
lookup. This revision requires the server and ntdll token integrity
patches so a limited Wine process reports its actual integrity level.

--- a/dlls/combase/combase.c
+++ b/dlls/combase/combase.c
@@ -304,5 +304,64 @@
 }
 
-HRESULT open_key_for_clsid(REFCLSID clsid, const WCHAR *keyname, REGSAM access, HKEY *subkey)
+static BOOL classes_key_missing(LSTATUS ret)
+{
+    return ret == ERROR_FILE_NOT_FOUND || ret == ERROR_PATH_NOT_FOUND;
+}
+
+static BOOL use_per_user_classes(void)
+{
+    union
+    {
+        TOKEN_MANDATORY_LABEL label;
+        BYTE buffer[sizeof(TOKEN_MANDATORY_LABEL) + SECURITY_MAX_SID_SIZE];
+    } info;
+    HANDLE token;
+    NTSTATUS status;
+    ULONG size;
+    PSID sid;
+    UCHAR count;
+
+    status = NtOpenThreadToken(GetCurrentThread(), TOKEN_QUERY, TRUE, &token);
+    if (status == STATUS_NO_TOKEN) status = NtOpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token);
+    if (status) return FALSE;
+
+    status = NtQueryInformationToken(token, TokenIntegrityLevel, &info, sizeof(info), &size);
+    NtClose(token);
+    if (status) return FALSE;
+
+    sid = info.label.Label.Sid;
+    if (!RtlValidSid(sid) || !(count = *RtlSubAuthorityCountSid(sid))) return FALSE;
+    return *RtlSubAuthoritySid(sid, count - 1) < SECURITY_MANDATORY_HIGH_RID;
+}
+
+static LSTATUS open_user_classes_key(const WCHAR *name, const WCHAR *leaf, REGSAM access, HKEY *key)
+{
+    static const WCHAR prefix[] = L"Software\\Classes\\";
+    SIZE_T count = ARRAY_SIZE(prefix) + lstrlenW(name);
+    WCHAR *path;
+    HKEY user;
+    LSTATUS ret;
+
+    if (!use_per_user_classes()) return ERROR_FILE_NOT_FOUND;
+    if (leaf) count += 1 + lstrlenW(leaf);
+    if (!(path = malloc(count * sizeof(*path)))) return ERROR_NOT_ENOUGH_MEMORY;
+    lstrcpyW(path, prefix);
+    lstrcatW(path, name);
+    if (leaf)
+    {
+        lstrcatW(path, L"\\");
+        lstrcatW(path, leaf);
+    }
+    if (!(ret = RegOpenCurrentUser(KEY_READ, &user)))
+    {
+        ret = RegOpenKeyExW(user, path, 0, access, key);
+        RegCloseKey(user);
+    }
+    free(path);
+    return ret;
+}
+
+static HRESULT open_class_key(REFCLSID clsid, const WCHAR *keyname, REGSAM access, HKEY *subkey,
+                              BOOL user_first)
 {
     static const WCHAR clsidW[] = L"CLSID\\";
@@ -313,4 +372,11 @@
     lstrcpyW(path, clsidW);
     StringFromGUID2(clsid, path + lstrlenW(clsidW), CHARS_IN_GUID);
+    if (user_first)
+    {
+        res = open_user_classes_key(path, keyname, access, subkey);
+        if (res == ERROR_SUCCESS) return S_OK;
+        if (!classes_key_missing(res))
+            return res == ERROR_NOT_ENOUGH_MEMORY ? E_OUTOFMEMORY : REGDB_E_READREGDB;
+    }
     res = open_classes_key(HKEY_CLASSES_ROOT, path, access, &key);
     if (res == ERROR_FILE_NOT_FOUND)
@@ -335,4 +401,9 @@
 }
 
+HRESULT open_key_for_clsid(REFCLSID clsid, const WCHAR *keyname, REGSAM access, HKEY *subkey)
+{
+    return open_class_key(clsid, keyname, access, subkey, FALSE);
+}
