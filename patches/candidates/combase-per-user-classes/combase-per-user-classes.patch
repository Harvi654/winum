     if (FAILED(hr) && (opposite == KEY_WOW64_32KEY || (IsWow64Process(GetCurrentProcess(), &is_wow64) && is_wow64)))
     {
-        hr = open_key_for_clsid(clsid, L"ProgID", opposite | KEY_READ, &hkey);
