+++ b/dlls/msi/table.c
@@ -3053,9 +3053,13 @@ static MSIRECORD *get_transform_record( const struct table_view *tv, const strin
             r = IStorage_OpenStream( stg, encname, NULL, STGM_READ | STGM_SHARE_EXCLUSIVE, 0, &stm );
             if ( r != ERROR_SUCCESS )
             {
