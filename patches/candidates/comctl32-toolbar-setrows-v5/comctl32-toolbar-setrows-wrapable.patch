+/* Buttons per row in order, read from TB_GETITEMRECT: S for a separator on
+ * a row of its own, s after the count when it shares a row with buttons. */
+static void setrows_layout(HWND toolbar, const TBBUTTON *buttons, int count, char *layout)
+{
+    int i, in_row = 0, row_sep = 0;
+    LONG top = LONG_MIN;
+    char part[16];
+    RECT rc;
+
+    layout[0] = 0;
+    for (i = 0; i <= count; i++)
+    {
+        if (i < count)
+            ok(SendMessageA(toolbar, TB_GETITEMRECT, i, (LPARAM)&rc), "TB_GETITEMRECT %d failed\n", i);
+        if (i == count || rc.top != top)
+        {
+            if (top != LONG_MIN)
+            {
+                if (in_row) sprintf(part, "%s%d%s", layout[0] ? " " : "", in_row, row_sep ? "s" : "");
+                else sprintf(part, "%sS", layout[0] ? " " : "");
+                strcat(layout, part);
+            }
+            if (i == count) break;
+            top = rc.top;
+            in_row = row_sep = 0;
+        }
+        if (buttons[i].fsStyle & BTNS_SEP) row_sep = 1;
+        else in_row++;
+    }
+}
+
+static void setrows_fill(TBBUTTON *buttons, const int *groups, int max_groups, int *count)
+{
+    int g, i;
+
+    *count = 0;
+    memset(buttons, 0, 64 * sizeof(*buttons));
+    for (g = 0; g < max_groups && groups[g]; g++)
+    {
+        if (g) buttons[(*count)++].fsStyle = BTNS_SEP;
+        for (i = 0; i < groups[g]; i++, (*count)++)
+        {
+            buttons[*count].iBitmap = *count % 4;
+            buttons[*count].idCommand = 100 + *count;
+            buttons[*count].fsState = TBSTATE_ENABLED;
+            buttons[*count].fsStyle = BTNS_BUTTON;
+            buttons[*count].iString = -1;
+        }
+    }
+}
