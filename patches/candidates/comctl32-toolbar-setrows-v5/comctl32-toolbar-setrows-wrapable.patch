+/* Wrap after "columns" buttons; a separator ends the row and gets a row of
+ * its own, so every group of buttons starts on a new row. Returns the number
+ * of button rows (separator rows not counted). */
+static INT
+TOOLBAR_WrapColumns(TOOLBAR_INFO *infoPtr, INT columns)
+{
+    TBUTTON_INFO *btnPtr = infoPtr->buttons;
+    INT i, column = 0, last = -1, rows = 0;
+
+    for (i = 0; i < infoPtr->nNumButtons; i++)
+        btnPtr[i].fsState &= ~TBSTATE_WRAP;
+
+    for (i = 0; i < infoPtr->nNumButtons; i++)
+    {
+        if (btnPtr[i].fsState & TBSTATE_HIDDEN)
+            continue;
+
+        if (btnPtr[i].fsStyle & BTNS_SEP)
+        {
+            if (column && last >= 0)
+                btnPtr[last].fsState |= TBSTATE_WRAP;
+            btnPtr[i].fsState |= TBSTATE_WRAP;
+            column = 0;
+            last = i;
+            continue;
+        }
+
+        if (!column) rows++;
+        last = i;
+        if (++column >= columns)
+        {
+            btnPtr[i].fsState |= TBSTATE_WRAP;
+            column = 0;
+        }
+    }
+    return rows;
+}
