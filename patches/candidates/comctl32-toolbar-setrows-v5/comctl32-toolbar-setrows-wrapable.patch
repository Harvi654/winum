+/* Inventor's palette sequence on the same Windows run: TB_SETPADDING(0, 0),
+ * TB_SETROWS(12), the toolbar sized to the returned rectangle, button 5
+ * deleted and inserted again, a resize to 500x300, TB_AUTOSIZE, a resize to
+ * 60x600. After TB_SETROWS a change of width gives as many buttons per row
+ * as fit, keeping the groups. TB_SETROWS keeps the 23x22 buttons although
+ * the padding is 0 (no recalculation), so 60 pixels fit 2 per row. */
+static void test_setrows_palette(void)
+{
+    static const int groups[] = { 12, 10, 10, 8, 7, 0 };
+    static const struct { const char *step; int getrows[2]; const char *layout[2]; } steps[] =
+    {
