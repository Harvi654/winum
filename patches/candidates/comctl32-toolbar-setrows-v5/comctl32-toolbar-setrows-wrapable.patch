+/* Button size around TB_SETROWS. Windows sets it when the bitmap size is
+ * set (bitmap + the padding current then) or with TB_SETBUTTONSIZE; a later
+ * TB_SETPADDING and TB_SETROWS change nothing. Sequences from the same
+ * Windows 10 MEASURE (winum docs/wine-repro/comctl32-toolbar-padding-height,
+ * measure-sequence.c, 2026-11-10; comctl32 5.82 and 6.16 alike); the first
+ * is Inventor's symbol palette: bitmap size 16x15, button size 23x22,
+ * bitmap size 32x16, button size 40x24, the buttons one by one with their
+ * own bitmaps, padding 4x0, TB_SETROWS(12, TRUE). */
+static void test_setrows_button_size(void)
+{
+    static const int groups[] = { 12, 10, 10, 8, 7, 0 };
+    static const struct
+    {
+        const char *name, *steps;
+        DWORD size;
+        const char *setrows, *width;
+    } tests[] =
+    {
+        { "inventor", "1b2Bmpr", MAKELONG(40, 24), "4 4 4 S 4 4 2 S 4 4 2 S 4 4 S 4 3", "5 5 2 S 5 5 S 5 5 S 5 3 S 5 2" },
+        { "no-size-change", "1iapr", MAKELONG(23, 22), "4 4 4 S 4 4 2 S 4 4 2 S 4 4 S 4 3", "8 4 S 8 2 S 8 2 S 8 S 7" },
+        { "padding-first", "p12Iar", MAKELONG(36, 16), "4 4 4 S 4 4 2 S 4 4 2 S 4 4 S 4 3", "5 5 2 S 5 5 S 5 5 S 5 3 S 5 2" },
+    };
+    HIMAGELIST (WINAPI *pImageList_Create)(int, int, UINT, int, int);
+    int (WINAPI *pImageList_Add)(HIMAGELIST, HBITMAP, HBITMAP);
+    BOOL (WINAPI *pImageList_Destroy_)(HIMAGELIST);
+    TBBUTTON buttons[64], button;
+    HIMAGELIST himl16, himl32;
+    HBITMAP bitmap16, bitmap32, bitmaps[64];
+    TBADDBITMAP add;
+    char layout[128];
+    HMODULE module;
+    const char *step;
+    int count, t, i;
+    DWORD size;
+    HWND toolbar;
+    RECT rc;
+    HDC hdc;
+
+    module = GetModuleHandleA("comctl32.dll");
+    pImageList_Create = (void *)GetProcAddress(module, "ImageList_Create");
+    pImageList_Add = (void *)GetProcAddress(module, "ImageList_Add");
+    pImageList_Destroy_ = (void *)GetProcAddress(module, "ImageList_Destroy");
+    hdc = GetDC(NULL);
+    bitmap16 = CreateCompatibleBitmap(hdc, 64, 16);
+    bitmap32 = CreateCompatibleBitmap(hdc, 128, 16);
+    ReleaseDC(NULL, hdc);
+    himl16 = pImageList_Create(16, 16, ILC_COLOR24, 4, 0);
+    himl32 = pImageList_Create(32, 16, ILC_COLOR24, 4, 0);
+    ok(himl16 && himl32, "ImageList_Create failed\n");
+    ok(pImageList_Add(himl16, bitmap16, NULL) == 0, "ImageList_Add failed\n");
+    ok(pImageList_Add(himl32, bitmap32, NULL) == 0, "ImageList_Add failed\n");
+    DeleteObject(bitmap16);
+    DeleteObject(bitmap32);
+
+    for (t = 0; t < ARRAY_SIZE(tests); t++)
+    {
+        winetest_push_context("%s", tests[t].name);
+        setrows_fill(buttons, groups, ARRAY_SIZE(groups), &count);
+        memset(bitmaps, 0, sizeof(bitmaps));
+        toolbar = CreateWindowExA(0, TOOLBARCLASSNAMEA, NULL, WS_CHILD | WS_VISIBLE | CCS_NORESIZE |
+                                  CCS_NOPARENTALIGN | CCS_NODIVIDER | TBSTYLE_FLAT | TBSTYLE_WRAPABLE | CCS_VERT,
+                                  0, 0, 300, 400, hMainWnd, NULL, GetModuleHandleA(NULL), NULL);
+        ok(toolbar != NULL, "CreateWindowExA failed\n");
+        SendMessageA(toolbar, TB_BUTTONSTRUCTSIZE, sizeof(TBBUTTON), 0);
+        for (step = tests[t].steps; *step; step++)
+        {
+            switch (*step)
+            {
+            case '1': SendMessageA(toolbar, TB_SETBITMAPSIZE, 0, MAKELPARAM(16, 15)); break;
+            case '2': SendMessageA(toolbar, TB_SETBITMAPSIZE, 0, MAKELPARAM(32, 16)); break;
+            case 'b': SendMessageA(toolbar, TB_SETBUTTONSIZE, 0, MAKELPARAM(23, 22)); break;
+            case 'B': SendMessageA(toolbar, TB_SETBUTTONSIZE, 0, MAKELPARAM(40, 24)); break;
+            case 'i': SendMessageA(toolbar, TB_SETIMAGELIST, 0, (LPARAM)himl16); break;
+            case 'I': SendMessageA(toolbar, TB_SETIMAGELIST, 0, (LPARAM)himl32); break;
+            case 'p': SendMessageA(toolbar, TB_SETPADDING, 0, MAKELPARAM(4, 0)); break;
+            case 'r': SendMessageA(toolbar, TB_SETROWS, MAKEWPARAM(12, TRUE), (LPARAM)&rc); break;
+            case 'a':
+                ok(SendMessageA(toolbar, TB_ADDBUTTONSA, count, (LPARAM)buttons), "TB_ADDBUTTONS failed\n");
+                break;
+            case 'm':
+                for (i = 0; i < count; i++)
+                {
+                    button = buttons[i];
+                    if (!(button.fsStyle & BTNS_SEP))
+                    {
+                        hdc = GetDC(NULL);
+                        bitmaps[i] = CreateCompatibleBitmap(hdc, 32, 16);
+                        ReleaseDC(NULL, hdc);
+                        add.hInst = NULL;
+                        add.nID = (UINT_PTR)bitmaps[i];
+                        button.iBitmap = SendMessageA(toolbar, TB_ADDBITMAP, 1, (LPARAM)&add);
+                    }
+                    ok(SendMessageA(toolbar, TB_ADDBUTTONSA, 1, (LPARAM)&button), "TB_ADDBUTTONS %d failed\n", i);
+                }
+                break;
+            }
+        }
+        size = SendMessageA(toolbar, TB_GETBUTTONSIZE, 0, 0);
+        ok(size == tests[t].size, "after TB_SETROWS button size %ux%u, expected %ux%u\n", LOWORD(size), HIWORD(size),
+           LOWORD(tests[t].size), HIWORD(tests[t].size));
+        setrows_layout(toolbar, buttons, count, layout);
+        ok(!strcmp(layout, tests[t].setrows), "after TB_SETROWS layout \"%s\", expected \"%s\"\n", layout, tests[t].setrows);
+        SetWindowPos(toolbar, NULL, 0, 0, 200, 600, SWP_NOZORDER | SWP_NOACTIVATE | SWP_NOMOVE);
+        size = SendMessageA(toolbar, TB_GETBUTTONSIZE, 0, 0);
+        ok(size == tests[t].size, "after the resize button size %ux%u, expected %ux%u\n", LOWORD(size), HIWORD(size),
+           LOWORD(tests[t].size), HIWORD(tests[t].size));
+        setrows_layout(toolbar, buttons, count, layout);
+        ok(!strcmp(layout, tests[t].width), "after the resize layout \"%s\", expected \"%s\"\n", layout, tests[t].width);
+        DestroyWindow(toolbar);
+        for (i = 0; i < count; i++) if (bitmaps[i]) DeleteObject(bitmaps[i]);
+        winetest_pop_context();
+    }
+    pImageList_Destroy_(himl16);
+    pImageList_Destroy_(himl32);
+}
