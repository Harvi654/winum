     s = WSASocketW(AF_UNIX, SOCK_STREAM, 0, NULL, 0, WSA_FLAG_OVERLAPPED);
-    todo_wine ok(s != INVALID_SOCKET, "WSASocketW failed, error %d\n", WSAGetLastError());
