     if (s == INVALID_SOCKET)
     {
         skip("AF_UNIX sockets are not supported\n");
@@ -15489,7 +15489,7 @@ static void test_afunix_extensions(void)
     DWORD size, flags;
 
     listener = WSASocketW(AF_UNIX, SOCK_STREAM, 0, NULL, 0, WSA_FLAG_OVERLAPPED);
-    todo_wine ok(listener != INVALID_SOCKET, "WSASocketW failed, error %d\n", WSAGetLastError());
+    ok(listener != INVALID_SOCKET, "WSASocketW failed, error %d\n", WSAGetLastError());
     if (listener == INVALID_SOCKET)
     {
         skip("AF_UNIX sockets are not supported\n");
