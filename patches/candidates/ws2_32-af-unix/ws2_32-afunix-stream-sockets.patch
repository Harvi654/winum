     }
-    todo_wine ok(found == 1, "found %d AF_UNIX entries\n", found);
+    ok(found == 1, "found %d AF_UNIX entries\n", found);
     free(info);
 
     s = socket(AF_UNIX, SOCK_DGRAM, 0);
@@ -15166,11 +15166,11 @@ static void test_afunix_catalogue(void)
     s = socket(AF_UNIX, SOCK_SEQPACKET, 0);
     ok(s == INVALID_SOCKET && WSAGetLastError() == WSAESOCKTNOSUPPORT, "seqpacket: error %d\n", WSAGetLastError());
     s = socket(AF_UNIX, SOCK_STREAM, IPPROTO_TCP);
-    todo_wine ok(s == INVALID_SOCKET && WSAGetLastError() == WSAEPROTONOSUPPORT, "stream/tcp: error %d\n",
