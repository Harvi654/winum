From: Harvi654 <202698022+Harvi654@users.noreply.github.com>
Subject: [PATCH] server: Support AF_UNIX stream sockets.

AI-assisted (Claude), original code; LGPL-2.1-or-later. Not submitted
upstream.

Windows 10 (1803+) and 11 have AF_UNIX stream sockets in Winsock; Wine
answered every AF_UNIX socket with WSAEAFNOSUPPORT. CodeMeter's runtime
(ABB RobotStudio) listens on one and fails to start its event server.

Measured on Windows 10 22H2 (docs/wine-repro/ws2_32-afunix, 2026-11-17)
and implemented here: stream sockets only (datagram WSAEAFNOSUPPORT,
IPPROTO_TCP WSAEPROTONOSUPPORT); bind creates the socket file and the
name is the path as given, with the length of the string; the peer of a
connect is the address as given; every other name (accept, a client's
own name, an accepted socket's peer, AcceptEx's remote address) is
unnamed with the length of SOCKADDR_UN; an accepted socket and AcceptEx's
local address carry the listener's name; a connection to a path that is
not a socket is refused (WSAECONNREFUSED), a bind in a missing directory
is STATUS_OBJECT_PATH_NOT_FOUND (WSAENETDOWN); a non-blocking connect is
reported as pending (WSAEWOULDBLOCK) though a local one completes at
once. The socket file is a reparse point with IO_REPARSE_TAG_AF_UNIX: it
can only be opened with FILE_OPEN_REPARSE_POINT (otherwise
STATUS_IO_REPARSE_TAG_NOT_HANDLED), so that DeleteFile works, and
FSCTL_GET_REPARSE_POINT returns the tag with no data.

The server cannot turn a Windows path into a Unix path, so a path
address reaches it as struct afd_unix_addr (include/wine/afd.h) with
the Unix path ntdll worked out and the Windows address as given. A Unix
path longer than sun_path is reached through its directory
(/proc/self/fd/N/name, Linux only). Unnamed (autobind) and abstract
names pass through as before.

--- a/include/wine/afd.h
+++ b/include/wine/afd.h
@@ -321,6 +321,25 @@ struct afd_connect_params
 };
 C_ASSERT( sizeof(struct afd_connect_params) == 8 );
 
+/* An AF_UNIX address with a path, as IOCTL_AFD_BIND and IOCTL_AFD_WINE_CONNECT
+ * pass it inside Wine: ws2_32 resolves the Windows path to an NT path, ntdll
+ * the NT path to a Unix path; the server binds or connects to the Unix path
+ * and reports the Windows address. Longer than a SOCKADDR_UN, so it cannot be
+ * mistaken for one. */
+#define AFD_UNIX_ADDR_NT_PATH   1  /* path is an NT path, WCHAR */
+#define AFD_UNIX_ADDR_UNIX_PATH 2  /* path is a Unix path, char */
+
+struct afd_unix_addr
+{
+    unsigned short family;    /* WS_AF_UNIX */
+    unsigned short win_len;   /* length of the Windows address in win */
+    unsigned short flags;     /* AFD_UNIX_ADDR_* */
+    unsigned short path_len;  /* size in bytes of the path that follows, terminator included */
+    char win[110];            /* the Windows address (SOCKADDR_UN) as given */
+    /* VARARG(path, ...); */
+};
+C_ASSERT( sizeof(struct afd_unix_addr) == 118 );
+
 struct afd_recvmsg_params
 {
     ULONGLONG control_ptr; /* WSABUF */
--- a/server/fd.c
+++ b/server/fd.c
@@ -1971,6 +1971,20 @@ struct fd *open_fd( struct fd *root, const char *name, struct unicode_str nt_nam
         }
     }
 
+#ifdef O_PATH
+    /* an AF_UNIX socket file is a reparse point (IO_REPARSE_TAG_AF_UNIX):
+     * like on Windows it can only be opened as such, e.g. to delete it */
+    if (fd->unix_fd == -1 && errno == ENXIO && !stat( name, &st ) && S_ISSOCK( st.st_mode ))
+    {
+        if (!(options & FILE_OPEN_REPARSE_POINT))
+        {
+            set_error( STATUS_IO_REPARSE_TAG_NOT_HANDLED );
+            goto error;
+        }
+        fd->unix_fd = open( name, O_PATH );
+    }
+#endif
+
     if (fd->unix_fd == -1)
     {
         /* check for trailing slash on file path */
@@ -1986,8 +2000,8 @@ struct fd *open_fd( struct fd *root, const char *name, struct unicode_str nt_nam
     fstat( fd->unix_fd, &st );
     *mode = st.st_mode;
 
-    /* only bother with an inode for normal files and directories */
-    if (S_ISREG(st.st_mode) || S_ISDIR(st.st_mode))
+    /* only bother with an inode for normal files, directories and socket files */
+    if (S_ISREG(st.st_mode) || S_ISDIR(st.st_mode) || S_ISSOCK(st.st_mode))
     {
         unsigned int err;
         struct inode *inode = get_inode( st.st_dev, st.st_ino, fd->unix_fd );
@@ -2494,6 +2508,20 @@ static void get_reparse_point( struct fd *fd, struct async *async )
         return;
     }
 
+    {
+        struct stat st;
+
+        /* an AF_UNIX socket file: a reparse point with the tag only, as on Windows */
+        if (!fstat( fd->unix_fd, &st ) && S_ISSOCK( st.st_mode ))
+        {
+            struct { unsigned int tag; unsigned short len, reserved; } data = { IO_REPARSE_TAG_AF_UNIX };
+
+            if (get_reply_max_size() < sizeof(data)) set_error( STATUS_BUFFER_TOO_SMALL );
+            else set_reply_data( &data, sizeof(data) );
+            return;
+        }
+    }
+
     if (fd->unix_name[strlen( fd->unix_name ) - 1] != '?')
     {
         set_error( STATUS_NOT_A_REPARSE_POINT );
--- a/server/sock.c
+++ b/server/sock.c
