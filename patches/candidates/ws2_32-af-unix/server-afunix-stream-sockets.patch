+        memcpy( wsaddr, &win, sizeof(win) );
+        return sizeof(win);
+    }
+
     case AF_UNSPEC:
         return 0;
 
@@ -596,6 +613,21 @@ static socklen_t sockaddr_to_unix( const struct WS_sockaddr *wsaddr, int wsaddrl
 
     switch (wsaddr->sa_family)
     {
+    case WS_AF_UNIX:
+    {
+        const struct WS_sockaddr_un *win = (const struct WS_sockaddr_un *)wsaddr;
+        int len = wsaddrlen - (int)offsetof( struct WS_sockaddr_un, sun_path );
+
+        /* only unnamed (autobind) and abstract names come this way; a path
+         * comes as struct afd_unix_addr with the Unix path from ntdll */
+        uaddr->un.sun_family = AF_UNIX;
+        if (len <= 0) return offsetof( struct sockaddr_un, sun_path );
+        if (wsaddrlen > sizeof(*win) || win->sun_path[0]) return 0;
+        if (len > sizeof(uaddr->un.sun_path)) len = sizeof(uaddr->un.sun_path);
+        memcpy( uaddr->un.sun_path, win->sun_path, len );
+        return offsetof( struct sockaddr_un, sun_path ) + len;
+    }
+
     case WS_AF_INET:
     {
         struct WS_sockaddr_in win = {0};
@@ -977,6 +1009,8 @@ static void fill_accept_output( struct accept_req *req )
             free( out_data );
             return;
         }
+        if (req->sock->family == WS_AF_UNIX && req->sock->addr_len <= win_len)
+            memcpy( win_addr, &req->sock->addr, req->sock->addr_len );
         memcpy( out_data + req->recv_len, &win_len, sizeof(int) );
     }
 
@@ -1828,6 +1862,7 @@ static int get_unix_family( int family )
 #ifdef AF_BLUETOOTH
         case WS_AF_BTH: return AF_BLUETOOTH;
 #endif
+        case WS_AF_UNIX: return AF_UNIX;
         case WS_AF_UNSPEC: return AF_UNSPEC;
         default: return -1;
     }
@@ -1899,6 +1934,80 @@ static void set_dont_fragment( int fd, int level, int value )
     setsockopt( fd, level, optname, &value, sizeof(value) );
 }
 
+/* Validate an AF_UNIX path address (struct afd_unix_addr with a Unix path,
+ * from ntdll) and fill a sockaddr_un for it. A path too long for sun_path
+ * is reached through its directory, opened in *dir_fd. */
+static socklen_t afunix_sockaddr( const struct WS_sockaddr *addr, data_size_t len,
+                                  struct sockaddr_un *un, int *dir_fd )
+{
+    const struct afd_unix_addr *ua = (const struct afd_unix_addr *)addr;
+    const char *path = (const char *)(ua + 1);
+    size_t path_len;
+
+    *dir_fd = -1;
+    if (len < sizeof(*ua) + 2 || ua->family != WS_AF_UNIX || ua->flags != AFD_UNIX_ADDR_UNIX_PATH
+            || ua->path_len > len - sizeof(*ua) || ua->win_len < 3 || ua->win_len > sizeof(ua->win))
+    {
+        set_error( STATUS_INVALID_ADDRESS );
+        return 0;
+    }
+    path_len = strnlen( path, ua->path_len );
+    if (!path_len || path_len == ua->path_len)
+    {
+        set_error( STATUS_INVALID_ADDRESS );
+        return 0;
+    }
+
+    memset( un, 0, sizeof(*un) );
+    un->sun_family = AF_UNIX;
+    if (path_len < sizeof(un->sun_path))
+    {
+        memcpy( un->sun_path, path, path_len );
+        return offsetof( struct sockaddr_un, sun_path ) + path_len + 1;
+    }
+#ifdef __linux__
+    {
+        const char *name = strrchr( path, '/' );
+        char *dir;
+
+        if (name && name != path && (dir = mem_alloc( name - path + 1 )))
+        {
+            memcpy( dir, path, name - path );
+            dir[name - path] = 0;
+            *dir_fd = open( dir, O_RDONLY | O_DIRECTORY );
+            free( dir );
+            if (*dir_fd != -1 && snprintf( un->sun_path, sizeof(un->sun_path), "/proc/self/fd/%d/%s",
+                                           *dir_fd, name + 1 ) < sizeof(un->sun_path))
+                return offsetof( struct sockaddr_un, sun_path ) + strlen( un->sun_path ) + 1;
+            if (*dir_fd != -1) close( *dir_fd );
+            *dir_fd = -1;
+        }
+    }
+#endif
+    set_error( STATUS_NAME_TOO_LONG );
+    return 0;
+}
+
+/* The Windows name of an AF_UNIX path address as given (connect target). */
+static int afunix_win_addr( const struct WS_sockaddr *addr, union win_sockaddr *win )
+{
+    const struct afd_unix_addr *ua = (const struct afd_unix_addr *)addr;
+
+    memset( win, 0, sizeof(*win) );
+    memcpy( &win->un, ua->win, ua->win_len );
+    win->un.sun_family = WS_AF_UNIX;
+    return ua->win_len;
+}
+
+/* The name of a socket bound to an AF_UNIX path: the path as given, its
+ * length that of the string, whatever length the caller passed. */
+static int afunix_bound_addr( const struct WS_sockaddr *addr, union win_sockaddr *win )
+{
+    afunix_win_addr( addr, win );
+    win->un.sun_path[sizeof(win->un.sun_path) - 1] = 0;
+    return offsetof( struct WS_sockaddr_un, sun_path ) + strlen( win->un.sun_path ) + 1;
+}
+
 static int init_socket( struct sock *sock, int family, int type, int protocol )
 {
     unsigned int options = 0;
@@ -1909,6 +2018,13 @@ static int init_socket( struct sock *sock, int family, int type, int protocol )
     unix_type = get_unix_type( type );
     unix_protocol = get_unix_protocol( family, protocol );
 
+    /* Windows has AF_UNIX stream sockets only */
+    if (family == WS_AF_UNIX && type == WS_SOCK_DGRAM)
+    {
+        set_win32_error( WSAEAFNOSUPPORT );
+        return -1;
+    }
+
     if (unix_protocol < 0)
     {
         if (family && unix_family < 0)
@@ -2127,6 +2243,11 @@ static struct sock *accept_socket( struct sock *sock )
                                                                 &acceptsock->peer_addr.addr,
                                                                 sizeof(acceptsock->peer_addr) );
         }
+        if (sock->family == WS_AF_UNIX)
+        {
+            acceptsock->addr = sock->addr;
+            acceptsock->addr_len = sock->addr_len;
+        }
     }
 
     clear_error();
@@ -2191,6 +2312,11 @@ static int accept_into_socket( struct sock *sock, struct sock *acceptsock )
                                                             &acceptsock->peer_addr.addr,
                                                             sizeof(acceptsock->peer_addr) );
     }
+    if (sock->family == WS_AF_UNIX)
+    {
+        acceptsock->addr = sock->addr;
+        acceptsock->addr_len = sock->addr_len;
+    }
 
     clear_error();
     sock->pending_events &= ~AFD_POLL_ACCEPT;
@@ -2668,7 +2794,7 @@ static void sock_ioctl( struct fd *fd, ioctl_code_t code, struct async *async )
         union unix_sockaddr unix_addr, peer_addr;
         struct connect_req *req;
         socklen_t unix_len;
-        int send_len, ret;
+        int send_len, ret, dir_fd = -1;
 
         if (get_req_data_size() < sizeof(*params) ||
             get_req_data_size() - sizeof(*params) < params->addr_len)
@@ -2718,8 +2844,11 @@ static void sock_ioctl( struct fd *fd, ioctl_code_t code, struct async *async )
                 break;
         }
 
-        unix_len = sockaddr_to_unix( addr, params->addr_len, &unix_addr );
-        if (!unix_len)
+        if (sock->family == WS_AF_UNIX && params->addr_len > sizeof(struct WS_sockaddr_un))
+        {
+            if (!(unix_len = afunix_sockaddr( addr, params->addr_len, &unix_addr.un, &dir_fd ))) return;
+        }
+        else if (!(unix_len = sockaddr_to_unix( addr, params->addr_len, &unix_addr )))
         {
             set_error( STATUS_INVALID_ADDRESS );
             return;
@@ -2764,9 +2893,14 @@ static void sock_ioctl( struct fd *fd, ioctl_code_t code, struct async *async )
             }
         }
 
+        if (dir_fd != -1) close( dir_fd );
         if (ret < 0 && errno != EINPROGRESS)
         {
-            set_error( sock_get_ntstatus( errno ) );
+            /* Windows refuses a connection to a path that is not a socket */
+            if (sock->family == WS_AF_UNIX && (errno == ENOENT || errno == ENOTDIR))
+                set_error( STATUS_CONNECTION_REFUSED );
+            else
+                set_error( sock_get_ntstatus( errno ) );
             return;
         }
 
@@ -2777,9 +2911,17 @@ static void sock_ioctl( struct fd *fd, ioctl_code_t code, struct async *async )
         getsockname( unix_fd, &unix_addr.addr, &unix_len );
         sock->addr_len = sockaddr_from_unix( &unix_addr, &sock->addr.addr, sizeof(sock->addr) );
         sock->peer_addr_len = sockaddr_from_unix( &peer_addr, &sock->peer_addr.addr, sizeof(sock->peer_addr));
+        /* the peer of an AF_UNIX connection is the address as given */
+        if (sock->family == WS_AF_UNIX && params->addr_len > sizeof(struct WS_sockaddr_un))
+            sock->peer_addr_len = afunix_win_addr( addr, &sock->peer_addr );
 
         sock->bound = 1;
 
+        /* a local connection completes at once, but Windows reports a
+         * non-blocking AF_UNIX connect as pending, like a TCP one */
+        if (!ret && sock->family == WS_AF_UNIX && params->synchronous && sock->nonblocking)
+            ret = -1;
+
         if (!ret)
         {
             if (sock->type != WS_SOCK_DGRAM)
@@ -3029,7 +3171,7 @@ static void sock_ioctl( struct fd *fd, ioctl_code_t code, struct async *async )
         }
         in_size = get_req_data_size() - get_reply_max_size();
         if (in_size < offsetof(struct afd_bind_params, addr.sa_data)
-                || get_reply_max_size() < in_size - sizeof(int))
+                || (sock->family != WS_AF_UNIX && get_reply_max_size() < in_size - sizeof(int)))
         {
             set_error( STATUS_INVALID_PARAMETER );
             return;
@@ -3041,6 +3183,40 @@ static void sock_ioctl( struct fd *fd, ioctl_code_t code, struct async *async )
             return;
         }
 
+        if (sock->family == WS_AF_UNIX)
+        {
+            data_size_t addr_len = in_size - sizeof(int);
+            int dir_fd = -1, ret;
+
+            if (addr_len > sizeof(struct WS_sockaddr_un))
+                unix_len = afunix_sockaddr( &params->addr, addr_len, &unix_addr.un, &dir_fd );
+            else if (!(unix_len = sockaddr_to_unix( &params->addr, addr_len, &unix_addr )))
+                set_error( STATUS_INVALID_ADDRESS );
+            if (!unix_len) return;
+
+            ret = bind( unix_fd, &unix_addr.addr, unix_len );
+            if (dir_fd != -1) close( dir_fd );
+            if (ret < 0)
+            {
+                /* a missing directory; ntdll normally finds it first */
+                if (errno == ENOENT || errno == ENOTDIR) set_error( STATUS_OBJECT_PATH_NOT_FOUND );
+                else set_error( sock_get_ntstatus( errno ) );
+                return;
+            }
+            sock->bound = 1;
+            if (addr_len > sizeof(struct WS_sockaddr_un))
+                sock->addr_len = afunix_bound_addr( &params->addr, &sock->addr );
+            else
+            {
+                memset( &sock->addr, 0, sizeof(sock->addr) );
+                sock->addr.un.sun_family = WS_AF_UNIX;
+                sock->addr_len = sizeof(sock->addr.un);
+            }
+            if (get_reply_max_size() >= sock->addr_len)
+                set_reply_data( &sock->addr, sock->addr_len );
+            return;
+        }
+
         unix_len = sockaddr_to_unix( &params->addr, in_size - sizeof(int), &unix_addr );
         if (!unix_len)
         {
