From: Harvi654 <202698022+Harvi654@users.noreply.github.com>
Subject: [PATCH] opengl32: Describe 8-bit RGB window formats without alpha as 32-bit.

AI-assisted (Claude), original code; LGPL-2.1-or-later. Not submitted
upstream.

Windows describes an RGB window pixel format with 8 bits per channel and
no alpha with cColorBits 32, the size of its pixel, like the format with
alpha (measured on Windows 10: the Microsoft generic formats 8/8/8/0 have
cColorBits 32; AMD's driver offers only 8/8/8/8 window formats, so there
ChoosePixelFormat and wglChoosePixelFormatARB return the same format).
GLX and EGL report the buffer size, 24. wglChoosePixelFormat compares
cColorBits before cAlphaBits, so a request for colour 24 with alpha 8
returned the 24-bit format without alpha, wglChoosePixelFormatARB with
alpha 8 returned another format, and SetPixelFormat with it on the same
window failed. Autodesk Inventor makes exactly these calls before it
offers GPU ray tracing, and greys the option out.

The change is made where opengl32 fetches the formats for one DC, and
only for a DC that is not a memory DC, only for on-screen formats that
can draw to a window and have 8/8/8 RGB without alpha. A memory DC keeps
the descriptions it had: a bitmap's pixel size is the bitmap's, and what
Windows reports there is not measured. Format indices, the driver's
formats and the window/pbuffer configs behind them are unchanged.

v2 (2026-11-06, after Codex's cross review): v1 changed the shared
descriptors in win32u, so memory DCs saw the change too, because GLX and
EGL formats that draw to windows can also draw to bitmaps. The change
moved to opengl32's per-DC copy and leaves memory DCs alone. The test
now checks that the exact accelerated double-buffered format the ARB
request asks for exists before it compares the two choices, and checks
the return values of restoring the previous context.

diff --git a/dlls/opengl32/tests/opengl.c b/dlls/opengl32/tests/opengl.c
index 2f25f57..a5ff111 100644
--- a/dlls/opengl32/tests/opengl.c
+++ b/dlls/opengl32/tests/opengl.c
@@ -1018,6 +1018,107 @@ static void test_choosepixelformat(void)
     pfd.cDepthBits = 0;
 }
 
+static void test_choosepixelformat_alpha(void)
+{
+    PIXELFORMATDESCRIPTOR pfd =
+    {
+        .nSize = sizeof(PIXELFORMATDESCRIPTOR),
+        .nVersion = 1,
+        .dwFlags = PFD_DRAW_TO_WINDOW | PFD_SUPPORT_OPENGL | PFD_DOUBLEBUFFER,
+        .iPixelType = PFD_TYPE_RGBA,
+        .cColorBits = 24,
+        .cAlphaBits = 8,
+        .cDepthBits = 24,
+        .cStencilBits = 8,
+        .iLayerType = PFD_MAIN_PLANE,
+    };
+    int attribs[] =
+    {
+        WGL_DRAW_TO_WINDOW_ARB, 1,
+        WGL_SUPPORT_OPENGL_ARB, 1,
+        WGL_DOUBLE_BUFFER_ARB, 1,
+        WGL_ACCELERATION_ARB, WGL_FULL_ACCELERATION_ARB,
+        WGL_PIXEL_TYPE_ARB, WGL_TYPE_RGBA_ARB,
+        WGL_COLOR_BITS_ARB, 32,
+        WGL_ALPHA_BITS_ARB, 8,
+        WGL_DEPTH_BITS_ARB, 24,
+        WGL_STENCIL_BITS_ARB, 8,
+        0
+    };
+    int i, count, format, arb_format = 0, with_alpha = 0, exact = 0;
+    PIXELFORMATDESCRIPTOR fmt;
+    HGLRC old_ctx = wglGetCurrentContext(), ctx;
+    HDC old_hdc = wglGetCurrentDC(), hdc;
+    UINT arb_count = 0;
+    HWND hwnd;
+    BOOL ret;
+
+    if (!ext.wglChoosePixelFormatARB)
+    {
+        win_skip( "wglChoosePixelFormatARB is not available.\n" );
+        return;
+    }
+
+    hwnd = CreateWindowA( "static", "Title", WS_OVERLAPPEDWINDOW, 10, 10, 200, 200, NULL, NULL, NULL, NULL );
+    ok( hwnd != NULL, "Failed to create window, error %lu.\n", GetLastError() );
+    hdc = GetDC( hwnd );
+
+    /* An 8-bit RGB window format without alpha counts its whole 32-bit pixel. */
+    count = DescribePixelFormat( hdc, 1, sizeof(fmt), &fmt );
+    for (i = 1; i <= count; i++)
+    {
+        if (!DescribePixelFormat( hdc, i, sizeof(fmt), &fmt )) continue;
+        if (!(fmt.dwFlags & PFD_DRAW_TO_WINDOW) || !(fmt.dwFlags & PFD_SUPPORT_OPENGL)) continue;
+        if (fmt.iPixelType != PFD_TYPE_RGBA) continue;
+        if (fmt.cRedBits != 8 || fmt.cGreenBits != 8 || fmt.cBlueBits != 8) continue;
+        if (!fmt.cAlphaBits)
+        {
+            ok( fmt.cColorBits == 32, "format %d: got cColorBits %u.\n", i, fmt.cColorBits );
+            continue;
+        }
+        with_alpha++;
+        if ((fmt.dwFlags & PFD_DOUBLEBUFFER) && !(fmt.dwFlags & PFD_GENERIC_FORMAT) && fmt.cAlphaBits == 8 &&
+                fmt.cDepthBits == 24 && fmt.cStencilBits == 8)
+            exact++;
+    }
+    if (!exact)
+    {
+        skip( "No accelerated double-buffered 8/8/8/8 format with depth 24 and stencil 8 (%d with alpha).\n",
+              with_alpha );
+        goto done;
+    }
+
+    /* A request for colour 24 with alpha gets alpha, and choosing again with
+     * wglChoosePixelFormatARB gives the same format, so it can be set again. */
+    format = ChoosePixelFormat( hdc, &pfd );
+    ok( format, "ChoosePixelFormat failed, error %lu.\n", GetLastError() );
+    ret = DescribePixelFormat( hdc, format, sizeof(fmt), &fmt );
+    ok( ret, "DescribePixelFormat failed, error %lu.\n", GetLastError() );
+    ok( fmt.cAlphaBits >= 8, "format %d: got cAlphaBits %u.\n", format, fmt.cAlphaBits );
+    ok( fmt.cColorBits == 32, "format %d: got cColorBits %u.\n", format, fmt.cColorBits );
+
+    ret = SetPixelFormat( hdc, format, &pfd );
+    ok( ret, "SetPixelFormat failed, error %lu.\n", GetLastError() );
+    ctx = wglCreateContext( hdc );
+    ok( ctx != NULL, "wglCreateContext failed, error %lu.\n", GetLastError() );
+    ret = wglMakeCurrent( hdc, ctx );
+    ok( ret, "wglMakeCurrent failed, error %lu.\n", GetLastError() );
+    ret = ext.wglChoosePixelFormatARB( hdc, attribs, NULL, 1, &arb_format, &arb_count );
+    ok( ret, "wglChoosePixelFormatARB failed, error %lu.\n", GetLastError() );
+    ok( arb_count == 1, "got %u formats.\n", arb_count );
+    ok( arb_format == format, "got format %d, expected %d.\n", arb_format, format );
+    ret = wglMakeCurrent( old_hdc, old_ctx );
+    ok( ret, "wglMakeCurrent failed, error %lu.\n", GetLastError() );
+    ret = wglDeleteContext( ctx );
+    ok( ret, "wglDeleteContext failed, error %lu.\n", GetLastError() );
+    ret = SetPixelFormat( hdc, arb_format, &pfd );
+    ok( ret, "SetPixelFormat failed, error %lu.\n", GetLastError() );
+
+done:
+    ReleaseDC( hwnd, hdc );
+    DestroyWindow( hwnd );
+}
+
 static void test_choosepixelformat_flag_is_ignored_when_unset(DWORD flag)
 {
     PIXELFORMATDESCRIPTOR pfd = {
@@ -6171,6 +6272,7 @@ START_TEST(opengl)
     }
 
     test_choosepixelformat();
+    test_choosepixelformat_alpha();
     test_choosepixelformat_flag_is_ignored_when_unset( PFD_DRAW_TO_WINDOW );
     test_choosepixelformat_flag_is_ignored_when_unset( PFD_DRAW_TO_BITMAP );
     test_choosepixelformat_flag_is_ignored_when_unset( PFD_SUPPORT_GDI );
diff --git a/dlls/opengl32/wgl.c b/dlls/opengl32/wgl.c
index ff4c5c2..37e4863 100644
--- a/dlls/opengl32/wgl.c
+++ b/dlls/opengl32/wgl.c
@@ -1690,6 +1690,21 @@ static struct wgl_pixel_format *get_pixel_formats( HDC hdc, UINT *num_formats,
     if ((status = UNIX_CALL( get_pixel_formats, &args ))) goto error;
 
     if (is_memdc) args.num_onscreen_formats = args.num_formats;
+    else
+    {
+        /* Windows describes an 8-bit RGB window format without alpha by its
+         * 32-bit pixel, like the one with alpha; GLX and EGL give 24. Memory
+         * DCs keep the size of their bitmap. */
+        for (UINT i = 0; i < args.num_onscreen_formats; i++)
+        {
+            PIXELFORMATDESCRIPTOR *pfd = &args.formats[i].pfd;
+
+            if ((pfd->dwFlags & PFD_DRAW_TO_WINDOW) && pfd->iPixelType == PFD_TYPE_RGBA &&
+                pfd->cColorBits == 24 && pfd->cRedBits == 8 && pfd->cGreenBits == 8 &&
+                pfd->cBlueBits == 8 && !pfd->cAlphaBits)
+                pfd->cColorBits = 32;
+        }
+    }
 
     *num_formats = args.num_formats;
     *num_onscreen_formats = args.num_onscreen_formats;
