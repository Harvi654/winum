From: Harvi654 <202698022+Harvi654@users.noreply.github.com>
Subject: [PATCH] msxml3: Implement IXMLDOMParseError::get_filepos.

AI-assisted (Claude), original code; LGPL-2.1-or-later. Not submitted
upstream.

Windows 10 (msxml3 and msxml6, x86_64 and i686, measured with
docs/wine-repro/msxml3-parseerror-filepos/measure.c, 2026-11-08):
get_filepos returns S_FALSE and 0 when the document has no parse error
(new document, after a successful loadXML), like get_errorCode, get_line,
get_linepos and get_reason; with a parse error it returns S_OK and the
offset of the offending character (0 after loadXML(""), 8 for
"<a><b></a>"); a NULL pointer gives E_INVALIDARG.

Wine returned E_NOTIMPL. SOLIDWORKS calls get_filepos after loadXML("")
fails, and the E_NOTIMPL preceded its C++ exception.

The change is limited to get_filepos: Wine does not record error positions
(filepos stays 0, marked todo_wine), and the other getters returning S_OK
without an error are left as they are.

v2 (2026-11-08): v1 returned S_OK also without a parse error; its own
test failed on Windows 10 (L1). Returns S_FALSE then, and the test covers
the loadXML("") and malformed-XML cases measured on Windows.

--- a/dlls/msxml3/parseerror.c
+++ b/dlls/msxml3/parseerror.c
@@ -242,8 +242,11 @@
     LONG *filepos )
 {
     parse_error_t *This = impl_from_IXMLDOMParseError2( iface );
-    FIXME("(%p)->(%p)\n", This, filepos);
-    return E_NOTIMPL;
+    TRACE("(%p)->(%p)\n", This, filepos);
+    if (!filepos) return E_INVALIDARG;
+
+    *filepos = This->filepos;
+    return This->code ? S_OK : S_FALSE;
 }
 
 static HRESULT WINAPI parseError_get_errorXPath(
--- a/dlls/msxml3/tests/domdoc.c
+++ b/dlls/msxml3/tests/domdoc.c
@@ -12939,7 +12939,9 @@
 {
     IXMLDOMParseError *error;
     IXMLDOMDocument *doc;
+    VARIANT_BOOL b;
     HRESULT hr;
+    LONG filepos;
 
     doc = create_document(&IID_IXMLDOMDocument);
 
@@ -12953,6 +12955,15 @@
     todo_wine
     check_interface(error, &IID_IXMLDOMParseError2, FALSE);
 
+    /* no parse error: S_FALSE and 0, as the other getters on Windows */
+    filepos = -1;
+    hr = IXMLDOMParseError_get_filepos(error, &filepos);
+    ok(hr == S_FALSE, "Unexpected hr %#lx.\n", hr);
+    ok(filepos == 0, "Unexpected file position %ld.\n", filepos);
+
+    hr = IXMLDOMParseError_get_filepos(error, NULL);
+    ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
+
     hr = IXMLDOMParseError_get_line(error, NULL);
     ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
 
@@ -12963,7 +12974,33 @@
     ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
 
     IXMLDOMParseError_Release(error);
+
+    /* loadXML("") fails with a parse error at position 0 */
+    b = VARIANT_TRUE;
+    hr = IXMLDOMDocument_loadXML(doc, _bstr_(""), &b);
+    ok(hr == S_FALSE, "Unexpected hr %#lx.\n", hr);
+    ok(b == VARIANT_FALSE, "Unexpected result %d.\n", b);
+    hr = IXMLDOMDocument_get_parseError(doc, &error);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    filepos = -1;
+    hr = IXMLDOMParseError_get_filepos(error, &filepos);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(filepos == 0, "Unexpected file position %ld.\n", filepos);
+    IXMLDOMParseError_Release(error);
+
+    /* the position is the offset of the offending character */
+    hr = IXMLDOMDocument_loadXML(doc, _bstr_("<a><b></a>"), &b);
+    ok(hr == S_FALSE, "Unexpected hr %#lx.\n", hr);
+    hr = IXMLDOMDocument_get_parseError(doc, &error);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    filepos = -1;
+    hr = IXMLDOMParseError_get_filepos(error, &filepos);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    todo_wine ok(filepos == 8, "Unexpected file position %ld.\n", filepos);
+    IXMLDOMParseError_Release(error);
+
     IXMLDOMDocument_Release(doc);
+    free_bstrs();
 }
 
 static void test_getAttributeNode(void)
