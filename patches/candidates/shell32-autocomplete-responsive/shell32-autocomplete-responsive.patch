+static void finish_enumeration(IAutoCompleteImpl *ac, struct enum_request *request)
+{
+    enum prefix_filtering filter = setup_prefix_filtering(ac, ac->txtbackup);
+
+    cancel_enumeration(ac);
+    sort_strs(request->strings, request->count, filter);
+    ac->enum_strs = request->strings;
+    ac->enum_strs_num = request->count;
+    request->strings = NULL;
+    request->count = 0;
+    if (!display_matching_strs(ac, ac->txtbackup, lstrlenW(ac->txtbackup),
+                               filter, ac->hwndEdit, request->flag))
+        hide_listbox(ac, ac->hwndListBox, FALSE);
+}
+
+static void CALLBACK enum_timer_proc(HWND hwnd, UINT msg, UINT_PTR id, DWORD now)
+{
+    IAutoCompleteImpl *ac = GetPropW(hwnd, autocomplete_propertyW);
+    struct enum_request *request;
+    unsigned int calls;
+    DWORD started = GetTickCount();
+
+    if (!ac || !(request = ac->request) || (UINT_PTR)request != id || ac->running_request)
+        return;
+
+    IAutoComplete2_AddRef(&ac->IAutoComplete2_iface);
+    ac->running_request = request;
+    if (!request->started)
+    {
+        request->started = TRUE;
+        IEnumString_Reset(ac->enumstr);
+        if (ac->request == request && request->prefix[0])
+            IACList_Expand(ac->aclist, request->prefix);
+    }
+
+    /* Keep the source in its apartment. Process a small slice after input. */
+    for (calls = 0; ac->request == request && calls < 64; ++calls)
+    {
+        WCHAR *str = NULL, **strings;
+        ULONG fetched;
+        HRESULT hr;
+
+        if (request->count == request->capacity)
+        {
+            UINT capacity = request->capacity;
+
+            if (capacity > min(UINT_MAX, SIZE_MAX / sizeof(*strings)) / 2 ||
+                !(strings = realloc(request->strings, 2 * capacity * sizeof(*strings))))
+            {
+                cancel_enumeration(ac);
+                break;
+            }
+            request->strings = strings;
+            request->capacity = 2 * capacity;
+        }
+
+        /* Some sources leave the fetched count uninitialized. Check the HRESULT. */
+        hr = IEnumString_Next(ac->enumstr, 1, &str, &fetched);
+        if (SUCCEEDED(hr) && hr != S_FALSE && str)
+            request->strings[request->count++] = str;
+        else
+        {
+            if (ac->request == request) finish_enumeration(ac, request);
+            break;
+        }
+        if (GetTickCount() - started >= 8) break;
+    }
+
+    ac->running_request = NULL;
+    if (ac->request != request) free_enum_request(request);
+    IAutoComplete2_Release(&ac->IAutoComplete2_iface);
+}
