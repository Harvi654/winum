+struct feature
+{
+    const char *name, *parent;
+    unsigned int level, attributes;
+};
+
+static const struct feature features[] =
+{
+    {"Root", NULL, 100, 0},
+    {"Anchor", "Root", 100, 24},
+    {"Branch", "Root", 100, 26},
+    {"UpperParent", "Branch", 200, 10},
+    {"Parent", "UpperParent", 200, 10},
+    {"Grandchild", "Parent", 200, 8},
+    {"Sibling", "Parent", 100, 10},
+    {"PlainSibling", "Parent", 100, 8}
+};
+
+struct variant
+{
+    const char *name, *selection;
+    BOOL set;
+    unsigned int parent_level;
+};
+
+static const struct variant variants[] =
+{
+    {"ancestor-addlocal-control", "ADDLOCAL=Anchor", FALSE, 100},
+    {"ancestor-addlocal-set", "ADDLOCAL=Anchor", TRUE, 100},
+    {"ancestor-addlocal-high-control", "ADDLOCAL=Anchor", FALSE, 200},
+    {"ancestor-addlocal-high-set", "ADDLOCAL=Anchor", TRUE, 200},
+    {"ancestor-level-control", "", FALSE, 200},
+    {"ancestor-level-set", "", TRUE, 200}
+};
