+/* BEGIN token integrity tests */
+static DWORD expected_integrity(HANDLE token)
+{
+    TOKEN_ELEVATION elevation;
+    DWORD type, size;
+    BOOL ret;
+
+    ret = GetTokenInformation(token, TokenElevationType, &type, sizeof(type), &size);
+    ok(ret, "TokenElevationType failed, error %lu\n", GetLastError());
+    if (type == TokenElevationTypeLimited) return SECURITY_MANDATORY_MEDIUM_RID;
+    if (type == TokenElevationTypeFull) return SECURITY_MANDATORY_HIGH_RID;
+    /* a default token (no UAC split) is high for an administrator, medium otherwise */
+    ret = GetTokenInformation(token, TokenElevation, &elevation, sizeof(elevation), &size);
+    ok(ret, "TokenElevation failed, error %lu\n", GetLastError());
+    return elevation.TokenIsElevated ? SECURITY_MANDATORY_HIGH_RID : SECURITY_MANDATORY_MEDIUM_RID;
+}
+
+static DWORD get_integrity(HANDLE token)
+{
+    BYTE buffer[64];
+    TOKEN_MANDATORY_LABEL *tml = (TOKEN_MANDATORY_LABEL *)buffer;
+    SID_IDENTIFIER_AUTHORITY *auth;
+    DWORD size = 0;
+    BOOL ret;
+
+    ret = GetTokenInformation(token, TokenIntegrityLevel, buffer, sizeof(buffer), &size);
+    ok(ret, "TokenIntegrityLevel failed, error %lu\n", GetLastError());
+    if (!ret) return ~0u;
+    ok(tml->Label.Attributes == (SE_GROUP_INTEGRITY | SE_GROUP_INTEGRITY_ENABLED),
+       "got attributes %#lx\n", tml->Label.Attributes);
+    ok(*GetSidSubAuthorityCount(tml->Label.Sid) == 1, "got %u sub authorities\n",
+       *GetSidSubAuthorityCount(tml->Label.Sid));
+    auth = GetSidIdentifierAuthority(tml->Label.Sid);
+    ok(auth->Value[5] == 16, "got authority %u\n", auth->Value[5]);
+    return *GetSidSubAuthority(tml->Label.Sid, 0);
+}
+
+#define check_integrity(token, expect) check_integrity_(__LINE__, token, expect)
+static void check_integrity_(int line, HANDLE token, DWORD expect)
+{
+    DWORD level = get_integrity(token);
+    ok_(__FILE__, line)(level == expect, "got integrity %#lx, expected %#lx\n", level, expect);
+}
+
+static void test_token_integrity_level(void)
+{
+    TOKEN_LINKED_TOKEN linked, linked2;
+    HANDLE token, dup, thread_token;
+    DWORD expect, size;
+    BOOL ret;
+
+    ret = OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY | TOKEN_DUPLICATE, &token);
+    ok(ret, "OpenProcessToken failed, error %lu\n", GetLastError());
+    expect = expected_integrity(token);
+    check_integrity(token, expect);
+    check_integrity(GetCurrentProcessToken(), expect);
+    check_integrity(GetCurrentThreadEffectiveToken(), expect);
+
+    ret = DuplicateTokenEx(token, MAXIMUM_ALLOWED, NULL, SecurityAnonymous, TokenPrimary, &dup);
+    ok(ret, "DuplicateTokenEx failed, error %lu\n", GetLastError());
+    check_integrity(dup, expect);
+    CloseHandle(dup);
+
+    ret = DuplicateTokenEx(token, MAXIMUM_ALLOWED, NULL, SecurityImpersonation, TokenImpersonation, &dup);
+    ok(ret, "DuplicateTokenEx failed, error %lu\n", GetLastError());
+    check_integrity(dup, expect);
+    CloseHandle(dup);
+
+    ret = DuplicateToken(token, SecurityIdentification, &dup);
+    ok(ret, "DuplicateToken failed, error %lu\n", GetLastError());
+    check_integrity(dup, expect);
+    CloseHandle(dup);
+
+    ret = CreateRestrictedToken(token, DISABLE_MAX_PRIVILEGE, 0, NULL, 0, NULL, 0, NULL, &dup);
+    ok(ret, "CreateRestrictedToken failed, error %lu\n", GetLastError());
+    check_integrity(dup, expect);
+    CloseHandle(dup);
+
+    ret = ImpersonateSelf(SecurityImpersonation);
+    ok(ret, "ImpersonateSelf failed, error %lu\n", GetLastError());
+    ret = OpenThreadToken(GetCurrentThread(), TOKEN_QUERY, TRUE, &thread_token);
+    ok(ret, "OpenThreadToken failed, error %lu\n", GetLastError());
+    check_integrity(thread_token, expect);
+    check_integrity(GetCurrentThreadEffectiveToken(), expect);
+    CloseHandle(thread_token);
+    RevertToSelf();
+
+    ret = GetTokenInformation(token, TokenLinkedToken, &linked, sizeof(linked), &size);
+    if (ret && linked.LinkedToken)
+    {
+        check_integrity(linked.LinkedToken, expected_integrity(linked.LinkedToken));
+        ret = GetTokenInformation(linked.LinkedToken, TokenLinkedToken, &linked2, sizeof(linked2), &size);
+        ok(ret, "TokenLinkedToken failed, error %lu\n", GetLastError());
+        check_integrity(linked2.LinkedToken, expected_integrity(linked2.LinkedToken));
+        CloseHandle(linked2.LinkedToken);
+        CloseHandle(linked.LinkedToken);
+    }
+    else skip("no linked token\n");
+
+    CloseHandle(token);
+}
