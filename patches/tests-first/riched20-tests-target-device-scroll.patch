From: Harvi654 <202698022+Harvi654@users.noreply.github.com>
Subject: [PATCH] riched20/tests: Test the scroll range of a target device line width.

AI-assisted (Claude), original code; LGPL-2.1-or-later. Not submitted
upstream.

Expected values come from the offline Windows 10 VM at 96 dpi (winum
docs/wine-repro/riched20-target-device-width, 2026-11-26): with a
reference DC and a line width wider than the window, the horizontal
scroll range of both classes covers the line (42211 twips: 2814 in
RICHEDIT50W, 2815 in RichEdit20W; 100000 twips: 6667 and 6668), a
narrower width leaves it alone, and the focus scrolls the caret after a
centred or right-aligned letter into view. Wine 11.22 keeps the range at
the width of the text, so the letter cannot be scrolled to.

 dlls/riched20/tests/editor.c | 109 +++++++++++++++++++++++++++++++++++
 1 file changed, 109 insertions(+)

diff --git a/dlls/riched20/tests/editor.c b/dlls/riched20/tests/editor.c
index 0ba1935..70480be 100644
--- a/dlls/riched20/tests/editor.c
+++ b/dlls/riched20/tests/editor.c
@@ -9617,6 +9617,114 @@ static void test_EM_SETCHARFORMAT_word_point(void)
     DestroyWindow(hwnd);
 }
 
+/* EM_SETTARGETDEVICE with a reference DC and a line width wider than the
+ * window: the horizontal scroll range covers the whole line, so that the
+ * focus can scroll the caret into view (values measured on Windows 10 at
+ * 96 dpi). */
+static void test_target_device_scroll(void)
+{
+    static const struct
+    {
+        LONG width;
+        WORD align;
+        int range[2]; /* nMax for RichEdit20W and RICHEDIT50W, 1 when not extended */
+        BOOL scrolls;
+    }
+    tests[] =
+    {
+        { 42211, PFA_CENTER, { 2815, 2814 }, TRUE },
+        { 42211, PFA_LEFT, { 2815, 2814 }, FALSE },
+        { 42211, PFA_RIGHT, { 2815, 2814 }, TRUE },
+        { 100000, PFA_CENTER, { 6668, 6667 }, TRUE },
+        { 5000, PFA_CENTER, { 1, 1 }, FALSE },
+    };
+    static const WCHAR *classes[] = { L"RichEdit20W", L"RICHEDIT50W" };
+    SETTEXTEX st = { ST_SELECTION, 1200 };
+    HMODULE msftedit;
+    PARAFORMAT2 pf;
+    SCROLLINFO si;
+    CHARRANGE sel;
+    POINTL pos;
+    POINT scroll;
+    RECT client;
+    HWND parent, edit;
+    LRESULT res;
+    MSG msg;
+    HDC dc;
+    int i, c;
+
+    dc = GetDC( NULL );
+    if (GetDeviceCaps( dc, LOGPIXELSX ) != 96)
+    {
+        skip( "expected values were measured at 96 dpi\n" );
+        ReleaseDC( NULL, dc );
+        return;
+    }
+    msftedit = LoadLibraryW( L"msftedit.dll" );
+    ok( msftedit != NULL, "msftedit.dll not loaded: %lu\n", GetLastError() );
+    parent = CreateWindowExW( 0, L"static", L"", WS_OVERLAPPEDWINDOW | WS_VISIBLE,
+                              0, 0, 700, 260, NULL, NULL, NULL, NULL );
+    ok( parent != NULL, "parent not created: %lu\n", GetLastError() );
+
+    for (c = 0; c < ARRAY_SIZE(classes); c++)
+    {
+        if (c == 1 && !msftedit) break;
+        for (i = 0; i < ARRAY_SIZE(tests); i++)
+        {
+            winetest_push_context( "%s width %ld align %u", wine_dbgstr_w( classes[c] ),
+                                   tests[i].width, tests[i].align );
+            edit = CreateWindowExW( 0, classes[c], L"", WS_CHILD | WS_VISIBLE | WS_BORDER | ES_MULTILINE |
+                                    ES_WANTRETURN | WS_HSCROLL | WS_VSCROLL | ES_DISABLENOSCROLL,
+                                    10, 10, 610, 165, parent, NULL, NULL, NULL );
+            ok( edit != NULL, "edit not created: %lu\n", GetLastError() );
+
+            /* Inventor's order: target device, text at the selection, alignment. */
+            res = SendMessageW( edit, EM_SETTARGETDEVICE, (WPARAM)dc, tests[i].width );
+            ok( res == 1, "EM_SETTARGETDEVICE returned %d\n", (int)res );
+            SendMessageW( edit, EM_SETTEXTEX, (WPARAM)&st, (LPARAM)L"A" );
+            SendMessageW( edit, EM_EXGETSEL, 0, (LPARAM)&sel );
+            SendMessageW( edit, EM_SETSEL, 0, -1 );
+            memset( &pf, 0, sizeof(pf) );
+            pf.cbSize = sizeof(pf);
+            pf.dwMask = PFM_ALIGNMENT;
+            pf.wAlignment = tests[i].align;
+            SendMessageW( edit, EM_SETPARAFORMAT, 0, (LPARAM)&pf );
+            SendMessageW( edit, EM_EXSETSEL, 0, (LPARAM)&sel );
+
+            memset( &si, 0, sizeof(si) );
+            si.cbSize = sizeof(si);
+            si.fMask = SIF_RANGE;
+            ok( GetScrollInfo( edit, SB_HORZ, &si ), "GetScrollInfo failed\n" );
+            ok( si.nMin == 0, "got nMin %d\n", si.nMin );
+            ok( si.nMax == tests[i].range[c], "got nMax %d, expected %d\n", si.nMax, tests[i].range[c] );
+
+            SetFocus( edit );
+            UpdateWindow( edit );
+            while (PeekMessageW( &msg, NULL, 0, 0, PM_REMOVE )) DispatchMessageW( &msg );
+
+            scroll.x = scroll.y = -1;
+            SendMessageW( edit, EM_GETSCROLLPOS, 0, (LPARAM)&scroll );
+            pos.x = pos.y = -99999;
+            SendMessageW( edit, EM_POSFROMCHAR, (WPARAM)&pos, 0 );
+            GetClientRect( edit, &client );
+            if (tests[i].scrolls)
+                ok( scroll.x > 0, "got scroll position %ld\n", scroll.x );
+            else
+                ok( scroll.x == 0, "got scroll position %ld\n", scroll.x );
+            ok( scroll.y == 0, "got vertical scroll position %ld\n", scroll.y );
+            /* Wine's view width still includes the vertical scroll bar. */
+            todo_wine_if( tests[i].scrolls )
+            ok( pos.x >= 0 && pos.x < client.right, "letter at %ld, client width %ld\n", pos.x, client.right );
+
+            DestroyWindow( edit );
+            winetest_pop_context();
+        }
+    }
+    DestroyWindow( parent );
+    if (msftedit) FreeLibrary( msftedit );
+    ReleaseDC( NULL, dc );
+}
+
 START_TEST( editor )
 {
   BOOL ret;
@@ -9697,6 +9805,7 @@ START_TEST( editor )
   test_EM_SELECTIONTYPE();
 
   test_EM_SETCHARFORMAT_word_point();
+  test_target_device_scroll();
 
   /* Set the environment variable WINETEST_RICHED20 to keep windows
    * responsive and open for 30 seconds. This is useful for debugging.
