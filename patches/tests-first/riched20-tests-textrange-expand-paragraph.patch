From: Harvi654 <202698022+Harvi654@users.noreply.github.com>
Subject: [PATCH] riched20/tests: Cover TOM paragraph navigation.

AI-assisted (Codex), original code; LGPL-2.1-or-later. Not submitted upstream.

Test the paragraph boundaries, change counts and HRESULTs measured on
Windows 10. The 11.22-3 baseline lacks paragraph navigation.
The previous Expand cases remain part of this test.

--- a/dlls/riched20/tests/richole.c
+++ b/dlls/riched20/tests/richole.c
@@ -5568,6 +5568,358 @@
+static BOOL set_expand_text(ITextDocument *doc, const WCHAR *text)
+{
+    ITextRange *range;
+    HRESULT hr;
+    BSTR str;
+
+    hr = ITextDocument_Range(doc, 0, 0, &range);
+    ok(hr == S_OK, "Range failed: %#lx\n", hr);
+    if (FAILED(hr)) return FALSE;
+    hr = ITextRange_Expand(range, tomStory, NULL);
+    ok(SUCCEEDED(hr), "Expand story failed: %#lx\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        str = SysAllocString(text);
+        hr = ITextRange_SetText(range, str);
+        SysFreeString(str);
+        ok(hr == S_OK, "SetText failed: %#lx\n", hr);
+    }
+    ITextRange_Release(range);
+    return SUCCEEDED(hr);
+}
+
+static void check_expand_paragraph(ITextRange *range, LONG expected_start, LONG expected_end,
+                                   LONG expected_delta, HRESULT expected_hr, BOOL want_delta)
+{
+    LONG start = -1, end = -1, delta = 0x12345678;
+    HRESULT hr;
+
+    hr = ITextRange_Expand(range, tomParagraph, want_delta ? &delta : NULL);
+    todo_wine
+    ok(hr == expected_hr, "Expand returned %#lx, expected %#lx\n", hr, expected_hr);
+    if (FAILED(hr)) return;
+
+    ITextRange_GetStart(range, &start);
+    ITextRange_GetEnd(range, &end);
+    ok(start == expected_start && end == expected_end, "range %ld,%ld, expected %ld,%ld\n",
+       start, end, expected_start, expected_end);
+    if (want_delta)
+        ok(delta == expected_delta, "delta %ld, expected %ld\n", delta, expected_delta);
+}
+
+enum paragraph_operation
+{
+    start_of, end_of, move, move_start, move_end
+};
+
+struct paragraph_case
+{
+    enum paragraph_operation op;
+    LONG arg, start, end, new_start, new_end, delta;
+    HRESULT hr;
+};
+
+static void run_paragraph_cases(ITextDocument *doc, const WCHAR *text,
+                                const struct paragraph_case *cases, unsigned int count)
+{
+    unsigned int i, want_delta;
+
+    if (!set_expand_text(doc, text)) return;
+    for (i = 0; i < count; ++i)
+    {
+        const struct paragraph_case *entry = cases + i;
+
+        for (want_delta = 0; want_delta <= 1; ++want_delta)
+        {
+            LONG delta = 0x12345678, start = -1, end = -1;
+            LONG *out = want_delta ? &delta : NULL;
+            ITextRange *range;
+            HRESULT hr;
+
+            hr = ITextDocument_Range(doc, entry->start, entry->end, &range);
+            ok(hr == S_OK, "Range failed: %#lx\n", hr);
+            if (FAILED(hr)) continue;
+
+            winetest_push_context("operation %u, case %u, want_delta %u", entry->op, i, want_delta);
+            switch (entry->op)
+            {
+            case start_of: hr = ITextRange_StartOf(range, tomParagraph, entry->arg, out); break;
+            case end_of: hr = ITextRange_EndOf(range, tomParagraph, entry->arg, out); break;
+            case move: hr = ITextRange_Move(range, tomParagraph, entry->arg, out); break;
+            case move_start: hr = ITextRange_MoveStart(range, tomParagraph, entry->arg, out); break;
+            case move_end: hr = ITextRange_MoveEnd(range, tomParagraph, entry->arg, out); break;
+            default: hr = E_UNEXPECTED; break;
+            }
+            todo_wine_if(entry->arg || entry->op == start_of || entry->op == end_of)
+            ok(hr == entry->hr, "returned %#lx, expected %#lx\n", hr, entry->hr);
+            if (SUCCEEDED(hr))
+            {
+                ITextRange_GetStart(range, &start);
+                ITextRange_GetEnd(range, &end);
+                ok(start == entry->new_start && end == entry->new_end,
+                   "range %ld,%ld, expected %ld,%ld\n", start, end, entry->new_start, entry->new_end);
+                if (want_delta)
+                    ok(delta == entry->delta, "delta %ld, expected %ld\n", delta, entry->delta);
+            }
+            ITextRange_Release(range);
+            winetest_pop_context();
+        }
+    }
+}
+
