opengl32: Optionally require the requested alpha bits in wglChoosePixelFormat.

TEST BUILD ONLY (topic/gpu-rt), not for series. Taken unchanged from
Autodesk-Inventor-for-Linux PR #3 (krokosik; written with Codex and
GPT-6.1-Sol), patches/gpu/wine-opengl-require-alpha.patch. LGPL 2.1 or
later like the code it changes.

With WINE_OPENGL_REQUIRE_ALPHA=1, formats with fewer alpha bits than
requested are skipped, so Inventor's GPU ray tracing check gets the same
format from ChoosePixelFormat and wglChoosePixelFormatARB. Purpose of this
build: check on the RX 6400 whether this is the only thing missing on AMD.
See docs/wine-repro/opengl32-pixel-format-alpha/README.md.

--- a/dlls/opengl32/wgl.c
+++ b/dlls/opengl32/wgl.c
@@ -1456,6 +1456,9 @@
     int i, count, best_format;
     int bestDBuffer = -1, bestStereo = -1;
     DWORD is_memdc;
+    char require_alpha_env[2];
+    BOOL require_alpha = GetEnvironmentVariableA( "WINE_OPENGL_REQUIRE_ALPHA", require_alpha_env,
+                                                 sizeof(require_alpha_env) ) == 1 && require_alpha_env[0] == '1';
 
     TRACE( "%p %p: size %u version %u flags %lu type %u color %u %u,%u,%u,%u "
            "accum %u depth %u stencil %u aux %u\n",
@@ -1480,6 +1483,16 @@
     for (i = 1; i <= count; i++)
     {
         if (!wglDescribePixelFormat( hdc, i, sizeof(format), &format )) continue;
+
+        /* Opt-in compatibility for applications which bootstrap a context with
+         * ChoosePixelFormat and then require alpha with wglChoosePixelFormatARB
+         * on the same window. Select a format with real requested alpha support
+         * instead of preferring an exact RGB-only color depth match. */
+        if (require_alpha && format.cAlphaBits < ppfd->cAlphaBits)
+        {
+            TRACE( "Requested alpha bits %u not available for iPixelFormat=%d\n", ppfd->cAlphaBits, i );
+            continue;
+        }
 
         if ((ppfd->iPixelType == PFD_TYPE_COLORINDEX) != (format.iPixelType == PFD_TYPE_COLORINDEX))
         {
