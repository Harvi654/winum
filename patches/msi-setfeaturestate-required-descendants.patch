From: Harvi654 <202698022+Harvi654@users.noreply.github.com>
Subject: [PATCH] msi: Select required descendants with one post-cost worklist.

AI-assisted (Codex), original code; LGPL-2.1-or-later. Not submitted
upstream.

Windows v13/v14 x64/i686: post-cost Local selects required descendants of
its explicit target and newly promoted ancestors, including attr24/18/26,
levels150/200, and two-level chains. Skip disabled and already Source or
Advertised children. Do not traverse an unchanged Local required node.

Share one index, parent map, visited set and worklist with the explicit
level-mode child walk; never recursively Set a parent. O(features+child
edges) graph work per fresh post-cost Local call, even on cyclic tables;
component updates are performed once per changed node, with their own cost.
Remember static Level0 before the older costing code can overwrite it.

Apply after frozen A/A2/B/D. Original v13 tests/expectations below are
unchanged. V14 test-first conformance is a separate shared test artifact;
see v14-conformance.md. No series/profile change; not an L0 runtime.

--- a/dlls/msi/install.c
+++ b/dlls/msi/install.c
@@ -912,6 +912,106 @@
     }
 }
 
+/* One per-call worklist for both the explicit selection and newly promoted
+ * ancestors. Child edges provide constant-time parent/index lookup. Never call
+ * SetFeatureState recursively from this walk (Windows v11-v14). */
+struct feature_selection_node
+{
+    MSIFEATURE *feature;
+    struct feature_selection_node *parent;
+    BOOL visited, promoted, updated;
+};
+
+static void set_feature_local( MSIPACKAGE *package, struct feature_selection_node *node )
+{
+    if (node->updated) return;
+    node->feature->ActionRequest = node->feature->Action = INSTALLSTATE_LOCAL;
+    ACTION_UpdateComponentStates( package, node->feature );
+    node->updated = TRUE;
+}
+
+static UINT select_local_feature( MSIPACKAGE *package, MSIFEATURE *target )
+{
+    struct feature_selection_node *nodes, **queue, *node, *parent;
+    unsigned int count = list_count( &package->features ), i = 0, head, tail;
+    MSIFEATURE *feature;
+    FeatureList *child;
+    WCHAR *addlocal;
+    BOOL explicit_selection;
+
+    nodes = calloc( count, sizeof(*nodes) );
+    queue = malloc( count * sizeof(*queue) );
+    if (!nodes || !queue) { free( nodes ); free( queue ); return ERROR_OUTOFMEMORY; }
+    LIST_FOR_EACH_ENTRY( feature, &package->features, MSIFEATURE, entry )
+    {
+        feature->selection_index = i;
+        nodes[i++].feature = feature;
+    }
+    LIST_FOR_EACH_ENTRY( feature, &package->features, MSIFEATURE, entry )
+        LIST_FOR_EACH_ENTRY( child, &feature->Children, FeatureList, entry )
+            nodes[child->feature->selection_index].parent = &nodes[feature->selection_index];
+
+    node = &nodes[target->selection_index];
+    set_feature_local( package, node );
+    node->promoted = TRUE;
+    parent = node->parent;
+    while (parent && !parent->updated)
+    {
+        feature = parent->feature;
+        if (feature->Level <= 0 || (feature->ActionRequest != INSTALLSTATE_UNKNOWN &&
+                                   feature->ActionRequest != INSTALLSTATE_ABSENT)) break;
+        parent->promoted = TRUE;
+        set_feature_local( package, parent );
+        parent = parent->parent;
+    }
+    addlocal = msi_dup_property( package->db, L"ADDLOCAL" );
+    explicit_selection = addlocal && *addlocal;
+    free( addlocal );
+
+    /* Finish the explicit target's level-mode subtree before required walks.
+     * Every node is enqueued once, including malformed back edges. */
+    head = tail = 0;
+    if (!explicit_selection) { node->visited = TRUE; queue[tail++] = node; }
+    while (head < tail)
+    {
+        node = queue[head++];
+        set_feature_local( package, node );
+        LIST_FOR_EACH_ENTRY( child, &node->feature->Children, FeatureList, entry )
+        {
+            struct feature_selection_node *next = &nodes[child->feature->selection_index];
+            if (next->visited || next->feature->Level <= 0 || next->feature->disabled_at_load) continue;
+            next->visited = TRUE;
+            queue[tail++] = next;
+        }
+    }
+
+    /* A required child is selected even above INSTALLLEVEL, but disabled and
+     * already Source/Advertised children are boundaries. Unchanged Local nodes
+     * are not reopened by this required walk. */
+    head = tail = 0;
+    for (i = 0; i < count; ++i)
+        if (nodes[i].promoted && !nodes[i].visited)
+        { nodes[i].visited = TRUE; queue[tail++] = &nodes[i]; }
+    while (head < tail)
+    {
+        node = queue[head++];
+        LIST_FOR_EACH_ENTRY( child, &node->feature->Children, FeatureList, entry )
+        {
+            struct feature_selection_node *next = &nodes[child->feature->selection_index];
+            feature = next->feature;
+            if (next->visited || feature->Level <= 0 || feature->disabled_at_load ||
+                !(feature->Attributes & msidbFeatureAttributesUIDisallowAbsent) ||
+                (feature->ActionRequest != INSTALLSTATE_UNKNOWN && feature->ActionRequest != INSTALLSTATE_ABSENT)) continue;
+            next->visited = TRUE;
+            set_feature_local( package, next );
+            queue[tail++] = next;
+        }
+    }
+    free( queue );
+    free( nodes );
+    return ERROR_SUCCESS;
+}
+
