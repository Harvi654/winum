+#define _WIN32_MSI 300
+#include <windows.h>
+#include <msi.h>
+#include <msiquery.h>
+#include <stdio.h>
+#include <string.h>
+
+static void observe(MSIHANDLE package, const char *stage)
+{
+    static const char *names[] = {"Root", "Anchor", "Branch", "Parent", "Languages", "Grandchild",
+        "RequiredData", "RequiredProgramFiles", "OptionalSibling", "PlainSibling"};
+    unsigned int i;
+    for (i = 0; i < sizeof(names) / sizeof(names[0]); ++i)
+    {
+        INSTALLSTATE installed = INSTALLSTATE_UNKNOWN, request = INSTALLSTATE_UNKNOWN;
+        MSIHANDLE record;
+        char code[11];
+        UINT result = MsiGetFeatureStateA(package, names[i], &installed, &request);
+        record = MsiCreateRecord(5);
+        if (!record) continue;
+        snprintf(code, sizeof(code), "%u", result);
+        MsiRecordSetStringA(record, 0, "V13OBS stage=[1] name=[2] rc=[3] installed=[4] request=[5]");
+        MsiRecordSetStringA(record, 1, stage);
+        MsiRecordSetStringA(record, 2, names[i]);
+        MsiRecordSetStringA(record, 3, code);
+        MsiRecordSetInteger(record, 4, installed);
+        MsiRecordSetInteger(record, 5, request);
+        MsiProcessMessage(package, INSTALLMESSAGE_INFO, record);
+        MsiCloseHandle(record);
+    }
+}
+
+__declspec(dllexport) UINT WINAPI ProbeCosting(MSIHANDLE package)
+{
+    MSIHANDLE record;
+    char code[11];
+    UINT result;
+    char target[40];
+    DWORD size = sizeof(target);
+    result = MsiGetPropertyA(package, "PROBESET", target, &size);
+    if (result || (strcmp(target, "Grandchild") && strcmp(target, "Parent"))) return ERROR_INVALID_DATA;
+    observe(package, "before");
+    result = MsiSetFeatureStateA(package, target, INSTALLSTATE_LOCAL);
+    record = MsiCreateRecord(3);
+    if (record)
+    {
+        snprintf(code, sizeof(code), "%u", result);
+        MsiRecordSetStringA(record, 0, "V13SET name=[1] requested=[2] rc=[3]");
+        /* A numeric first field can be treated as an MSI message identifier. */
+        MsiRecordSetStringA(record, 1, target);
+        MsiRecordSetInteger(record, 2, INSTALLSTATE_LOCAL);
+        MsiRecordSetStringA(record, 3, code);
+        MsiProcessMessage(package, INSTALLMESSAGE_INFO, record);
+        MsiCloseHandle(record);
+    }
+    observe(package, "after");
+    /* Keep installation observable even if the measured API returns an error. */
+    return ERROR_SUCCESS;
+}
