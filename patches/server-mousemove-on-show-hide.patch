--- /dev/null
+++ b/dlls/user32/tests/mousemove.c
@@ -0,0 +1,202 @@
+/*
+ * Mouse move sent after window layout changes
+ *
+ * Original, AI-assisted (Claude), LGPL-2.1-or-later.
+ * Expected values: own Windows 10 MEASURE, x86_64 and i686, 2026-11-08
+ * (docs/wine-repro/server-mousemove-show-hide in winum).
+ */
+
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "wingdi.h"
+#include "winuser.h"
+
+#include "wine/test.h"
+
+/* Windows delivered the move 15-32 ms after the change. The wait below is
+ * far longer so that a slow machine still sees it; the delay itself is not
+ * checked, only that one move arrives and at which window. */
+#define SETTLE_MS 400
+#define WAIT_MS   800
+
+static HWND moves_hwnd[16];
+static unsigned int moves;
+
+static LRESULT CALLBACK mousemove_proc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    if (msg == WM_MOUSEMOVE && moves < ARRAY_SIZE(moves_hwnd)) moves_hwnd[moves++] = hwnd;
+    return DefWindowProcA(hwnd, msg, wparam, lparam);
+}
+
+/* Dispatch what is queued, then wait; the queue is drained once more after
+ * every wait, also one that ends past the deadline, so a message that is
+ * already queued is never left for the next scenario. */
+static void pump_messages(DWORD ms)
+{
+    DWORD start = GetTickCount(), elapsed;
+    unsigned int count;
+    MSG msg;
+
+    for (;;)
+    {
+        for (count = 0; count < 1000 && PeekMessageA(&msg, 0, 0, 0, PM_REMOVE); count++)
+        {
+            TranslateMessage(&msg);
+            DispatchMessageA(&msg);
+        }
+        elapsed = GetTickCount() - start;
+        if (elapsed >= ms) break;
+        MsgWaitForMultipleObjects(0, NULL, FALSE, min(ms - elapsed, 10), QS_ALLINPUT);
+    }
+}
+
+static void start_scenario(void)
+{
+    pump_messages(SETTLE_MS);
+    moves = 0;
+}
+
+static void check_moves_(const char *name, unsigned int expect_count, HWND expect_hwnd, BOOL todo)
+{
+    unsigned int i;
+
+    pump_messages(WAIT_MS);
+    winetest_push_context("%s", name);
+    todo_wine_if(todo)
+    ok(moves == expect_count, "got %u WM_MOUSEMOVE, expected %u\n", moves, expect_count);
+    for (i = 0; i < moves; i++)
+        ok(moves_hwnd[i] == expect_hwnd, "move %u went to %p, expected %p\n", i, moves_hwnd[i], expect_hwnd);
+    winetest_pop_context();
+}
+#define check_moves(name, count, hwnd) check_moves_(name, count, hwnd, FALSE)
+
+static HWND create_child(HWND parent, DWORD style, int x, int y)
+{
+    return CreateWindowA("winetest_mousemove", NULL, WS_CHILD | style, x, y, 40, 40, parent, NULL, NULL, NULL);
+}
+
+static void test_mousemove_after_layout_change(void)
+{
+    HWND main, top_away, top_under, child_away, child_under, tmp;
+    POINT centre, client_centre, pos;
+    WNDCLASSA cls = {0};
+    RECT rect;
+    int i;
+
+    cls.lpfnWndProc = mousemove_proc;
+    cls.hInstance = GetModuleHandleA(NULL);
+    cls.hCursor = LoadCursorA(NULL, (LPCSTR)IDC_ARROW);
+    cls.hbrBackground = GetStockObject(WHITE_BRUSH);
+    cls.lpszClassName = "winetest_mousemove";
+    ok(RegisterClassA(&cls), "RegisterClassA failed, error %lu\n", GetLastError());
+
+    main = CreateWindowA("winetest_mousemove", "A", WS_OVERLAPPEDWINDOW | WS_VISIBLE,
+                         100, 100, 420, 320, NULL, NULL, NULL, NULL);
+    ok(main != NULL, "CreateWindowA failed, error %lu\n", GetLastError());
+    GetClientRect(main, &rect);
+    client_centre.x = rect.right / 2;
+    client_centre.y = rect.bottom / 2;
+    centre = client_centre;
+    ClientToScreen(main, &centre);
+    child_away = create_child(main, 0, 10, 10);
+    child_under = create_child(main, 0, client_centre.x - 20, client_centre.y - 20);
+    top_away = CreateWindowExA(WS_EX_TOOLWINDOW, "winetest_mousemove", "B away", WS_POPUP,
+                               700, 500, 100, 80, NULL, NULL, NULL, NULL);
+    top_under = CreateWindowExA(WS_EX_TOOLWINDOW, "winetest_mousemove", "B under", WS_POPUP,
+                                centre.x - 30, centre.y - 30, 60, 60, NULL, NULL, NULL, NULL);
+    SetForegroundWindow(main);
+    SetCursorPos(centre.x, centre.y);
+    pump_messages(2 * SETTLE_MS);
+
+    GetCursorPos(&pos);
+    if (pos.x != centre.x || pos.y != centre.y || WindowFromPoint(pos) != main)
+    {
+        skip("cursor could not be placed over the test window (%ld,%ld)\n", pos.x, pos.y);
+        goto done;
+    }
+
+    start_scenario();
+    check_moves("nothing", 0, NULL);
+
+    start_scenario();
+    ShowWindow(top_away, SW_SHOWNOACTIVATE);
+    check_moves("show top-level away", 1, main);
+    start_scenario();
+    ShowWindow(top_away, SW_HIDE);
+    check_moves("hide top-level away", 1, main);
+
+    start_scenario();
+    ShowWindow(top_under, SW_SHOWNOACTIVATE);
+    check_moves("show top-level under", 1, top_under);
+    start_scenario();
+    ShowWindow(top_under, SW_HIDE);
+    check_moves("hide top-level under", 1, main);
+
+    start_scenario();
+    ShowWindow(child_away, SW_SHOWNA);
+    check_moves("show child away", 1, main);
+    start_scenario();
+    ShowWindow(child_away, SW_HIDE);
+    check_moves("hide child away", 1, main);
+
+    start_scenario();
+    ShowWindow(child_under, SW_SHOWNA);
+    check_moves("show child under", 1, child_under);
+    start_scenario();
+    ShowWindow(child_under, SW_HIDE);
+    check_moves("hide child under", 1, main);
+
+    start_scenario();
+    for (i = 0; i < 5; i++)
+    {
+        ShowWindow(child_away, SW_SHOWNA);
+        ShowWindow(child_away, SW_HIDE);
+    }
+    check_moves("five show/hide pairs", 1, main);
+
+    start_scenario();
+    SetWindowPos(top_away, NULL, 720, 520, 0, 0, SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE);
+    /* Windows sends a move even for a hidden window that moves; Wine sends
+     * one only when a visible window moves or changes visibility. */
+    check_moves_("move hidden top-level", 1, main, TRUE);
+
+    start_scenario();
+    tmp = create_child(main, WS_VISIBLE, 10, 60);
+    check_moves("create visible child away", 1, main);
+    start_scenario();
+    DestroyWindow(tmp);
+    check_moves("destroy child away", 1, main);
+
+    start_scenario();
+    tmp = create_child(main, WS_VISIBLE, client_centre.x - 20, client_centre.y - 20);
+    check_moves("create visible child under", 1, tmp);
+    start_scenario();
+    DestroyWindow(tmp);
+    check_moves("destroy child under", 1, main);
+
+    start_scenario();
+    InvalidateRect(main, NULL, TRUE);
+    UpdateWindow(main);
+    check_moves("repaint", 0, NULL);
+
+    SetCursorPos(5, 5);
+    start_scenario();
+    ShowWindow(top_away, SW_SHOWNOACTIVATE);
+    check_moves("cursor elsewhere, show", 0, NULL);
+    start_scenario();
+    ShowWindow(top_away, SW_HIDE);
+    check_moves("cursor elsewhere, hide", 0, NULL);
+
+done:
+    DestroyWindow(top_under);
+    DestroyWindow(top_away);
+    DestroyWindow(main);
+    UnregisterClassA("winetest_mousemove", GetModuleHandleA(NULL));
+}
+
+START_TEST(mousemove)
+{
+    test_mousemove_after_layout_change();
+}
