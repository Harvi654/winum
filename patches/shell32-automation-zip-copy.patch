+typedef struct {
+    IEnumVARIANT IEnumVARIANT_iface;
+    LONG ref;
+    FolderItems3 *items;
+    ULONG position;
+} FolderEnum;
+
+static HRESULT folder_enum_create(FolderItems3 *items, ULONG position, IEnumVARIANT **result);
+
+static HRESULT WINAPI folder_enum_QueryInterface(IEnumVARIANT *iface, REFIID iid, void **result)
+{
+    if (!result) return E_POINTER;
+    *result = NULL;
+    if (!IsEqualIID(iid, &IID_IUnknown) && !IsEqualIID(iid, &IID_IEnumVARIANT)) return E_NOINTERFACE;
+    *result = iface;
+    IEnumVARIANT_AddRef(iface);
+    return S_OK;
+}
+
+static ULONG WINAPI folder_enum_AddRef(IEnumVARIANT *iface)
+{
+    FolderEnum *enumerator = CONTAINING_RECORD(iface, FolderEnum, IEnumVARIANT_iface);
+    return InterlockedIncrement(&enumerator->ref);
+}
+
+static ULONG WINAPI folder_enum_Release(IEnumVARIANT *iface)
+{
+    FolderEnum *enumerator = CONTAINING_RECORD(iface, FolderEnum, IEnumVARIANT_iface);
+    ULONG ref = InterlockedDecrement(&enumerator->ref);
+    if (!ref) { FolderItems3_Release(enumerator->items); free(enumerator); }
+    return ref;
+}
+
+static HRESULT WINAPI folder_enum_Next(IEnumVARIANT *iface, ULONG count, VARIANT *values, ULONG *fetched)
+{
+    FolderEnum *enumerator = CONTAINING_RECORD(iface, FolderEnum, IEnumVARIANT_iface);
+    ULONG done = 0;
+    HRESULT hr = S_OK;
+    if (fetched) *fetched = 0;
+    if (!values || (count != 1 && !fetched)) return E_POINTER;
+    while (done < count)
+    {
+        FolderItem *item = NULL;
+        VARIANT index;
+        VariantInit(&values[done]);
+        VariantInit(&index);
+        V_VT(&index) = VT_I4;
+        V_I4(&index) = enumerator->position;
+        hr = FolderItems3_Item(enumerator->items, index, &item);
+        if (hr != S_OK || !item) break;
+        V_VT(&values[done]) = VT_DISPATCH;
+        V_DISPATCH(&values[done]) = (IDispatch *)item;
+        ++enumerator->position;
+        ++done;
+    }
+    if (fetched) *fetched = done;
+    return FAILED(hr) ? hr : done == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI folder_enum_Skip(IEnumVARIANT *iface, ULONG count)
+{
+    FolderEnum *enumerator = CONTAINING_RECORD(iface, FolderEnum, IEnumVARIANT_iface);
+    ULONG total = impl_from_FolderItems(enumerator->items)->item_count;
+    ULONG remaining = total - min(total, enumerator->position);
+    enumerator->position += min(count, remaining);
+    return count <= remaining ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI folder_enum_Reset(IEnumVARIANT *iface)
+{
+    CONTAINING_RECORD(iface, FolderEnum, IEnumVARIANT_iface)->position = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI folder_enum_Clone(IEnumVARIANT *iface, IEnumVARIANT **result)
+{
+    FolderEnum *enumerator = CONTAINING_RECORD(iface, FolderEnum, IEnumVARIANT_iface);
+    return folder_enum_create(enumerator->items, enumerator->position, result);
+}
+
+static const IEnumVARIANTVtbl folder_enum_vtbl = {
+    folder_enum_QueryInterface, folder_enum_AddRef, folder_enum_Release,
+    folder_enum_Next, folder_enum_Skip, folder_enum_Reset, folder_enum_Clone
+};
+
+static HRESULT folder_enum_create(FolderItems3 *items, ULONG position, IEnumVARIANT **result)
+{
+    FolderEnum *enumerator;
+    if (!result) return E_POINTER;
+    *result = NULL;
+    if (!(enumerator = calloc(1, sizeof(*enumerator)))) return E_OUTOFMEMORY;
+    enumerator->IEnumVARIANT_iface.lpVtbl = &folder_enum_vtbl;
+    enumerator->ref = 1;
+    enumerator->items = items;
+    enumerator->position = position;
+    FolderItems3_AddRef(items);
+    *result = &enumerator->IEnumVARIANT_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI FolderItemsImpl__NewEnum(FolderItems3 *iface, IUnknown **result)
+{
+    if (!result) return E_INVALIDARG;
+    return folder_enum_create(iface, 0, (IEnumVARIANT **)result);
 }
 
