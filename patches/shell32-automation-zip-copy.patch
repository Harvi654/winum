+#include "shellzip.h"
+
+struct zip_entry
+{
+    WCHAR *name;
+    char *raw_name;
+    DWORD compressed, size, crc, offset;
+    WORD flags, method, name_len;
+    BOOL directory;
+};
+
+struct shell_zip
+{
+    LONG ref;
+    HANDLE file;
+    WCHAR *path;
+    ULONGLONG length;
+    unsigned count;
+    struct zip_entry *entries;
+    CRITICAL_SECTION lock;
+};
+
+static WORD get16(const BYTE *p) { return p[0] | (p[1] << 8); }
+static DWORD get32(const BYTE *p) { return get16(p) | ((DWORD)get16(p + 2) << 16); }
+static HRESULT invalid_zip(void) { return HRESULT_FROM_WIN32(ERROR_INVALID_DATA); }
+
+static voidpf zip_alloc(voidpf opaque, uInt count, uInt size)
+{
+    if (size && count > (SIZE_T)-1 / size) return NULL;
+    return calloc(count, size);
+}
+
+static void zip_free(voidpf opaque, voidpf memory) { free(memory); }
+
+static HRESULT read_at(struct shell_zip *zip, ULONGLONG offset, void *data, DWORD length)
+{
+    LARGE_INTEGER position;
+    DWORD read;
+    if (offset > zip->length || length > zip->length - offset) return invalid_zip();
+    position.QuadPart = offset;
+    if (!SetFilePointerEx(zip->file, position, NULL, FILE_BEGIN) ||
+        !ReadFile(zip->file, data, length, &read, NULL)) return HRESULT_FROM_WIN32(GetLastError());
+    return read == length ? S_OK : invalid_zip();
+}
+
+static BOOL valid_name(const WCHAR *name)
+{
+    const WCHAR *start = name, *p;
+    if (!*name || *name == '\\' || *name == '/') return FALSE;
+    for (p = name; ; ++p)
+    {
+        if (*p && (*p < 32 || wcschr(L":<>\"|?*", *p))) return FALSE;
+        if (*p && *p != '\\') continue;
+        if (p == start || p[-1] == '.' || p[-1] == ' ') return FALSE;
+        {
+            const WCHAR *dot = wmemchr(start, '.', p - start);
+            size_t len = dot ? dot - start : p - start;
+            if ((len == 3 && (!wcsnicmp(start, L"CON", 3) || !wcsnicmp(start, L"PRN", 3) ||
+                             !wcsnicmp(start, L"AUX", 3) || !wcsnicmp(start, L"NUL", 3))) ||
+                (len == 4 && (!wcsnicmp(start, L"COM", 3) || !wcsnicmp(start, L"LPT", 3)) &&
+                             ((start[3] >= '1' && start[3] <= '9') || start[3] == 0xb9 ||
+                              start[3] == 0xb2 || start[3] == 0xb3)) ||
+                (len == 6 && !wcsnicmp(start, L"CONIN$", 6)) ||
+                (len == 7 && !wcsnicmp(start, L"CONOUT$", 7)) ||
+                (len == 6 && !wcsnicmp(start, L"CLOCK$", 6))) return FALSE;
+        }
+        if (!*p) return TRUE;
+        start = p + 1;
+    }
+}
+
+static int entry_compare(const void *a, const void *b)
+{
+    return wcsicmp(((const struct zip_entry *)a)->name, ((const struct zip_entry *)b)->name);
+}
+
+static struct zip_entry *find_entry(struct shell_zip *zip, const WCHAR *name)
+{
+    struct zip_entry key = {0};
+    key.name = (WCHAR *)name;
+    return bsearch(&key, zip->entries, zip->count, sizeof(*zip->entries), entry_compare);
+}
+
+HRESULT shell_zip_open(const WCHAR *path, struct shell_zip **out)
+{
+    struct shell_zip *zip;
+    BYTE *tail = NULL, header[46];
+    LARGE_INTEGER size;
+    ULONGLONG position, end;
+    DWORD tail_len, central_size, central_offset, i, path_length;
+    int eocd;
+    HRESULT hr = invalid_zip();
+    *out = NULL;
+    if (!(zip = calloc(1, sizeof(*zip)))) return E_OUTOFMEMORY;
+    zip->ref = 1;
+    zip->file = INVALID_HANDLE_VALUE;
+    InitializeCriticalSection(&zip->lock);
+    path_length = GetFullPathNameW(path, 0, NULL, NULL);
+    if (!path_length || path_length > 32760) { hr = HRESULT_FROM_WIN32(ERROR_FILENAME_EXCED_RANGE); goto failed; }
+    if (!(zip->path = malloc(path_length * sizeof(WCHAR)))) { hr = E_OUTOFMEMORY; goto failed; }
+    if (!GetFullPathNameW(path, path_length, zip->path, NULL)) { hr = HRESULT_FROM_WIN32(GetLastError()); goto failed; }
+    zip->file = CreateFileW(zip->path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, 0, NULL);
+    if (zip->file == INVALID_HANDLE_VALUE) { hr = HRESULT_FROM_WIN32(GetLastError()); goto failed; }
+    if (!GetFileSizeEx(zip->file, &size)) { hr = HRESULT_FROM_WIN32(GetLastError()); goto failed; }
+    zip->length = size.QuadPart;
+    if (zip->length < 22) goto failed;
+    tail_len = min(zip->length, 65557);
+    if (!(tail = malloc(tail_len))) { hr = E_OUTOFMEMORY; goto failed; }
+    if (FAILED(hr = read_at(zip, zip->length - tail_len, tail, tail_len))) goto failed;
+    hr = invalid_zip();
+    for (eocd = tail_len - 22; eocd >= 0; --eocd)
+        if (get32(tail + eocd) == 0x06054b50 && eocd + 22 + get16(tail + eocd + 20) == tail_len) break;
+    if (eocd < 0) goto failed;
+    if (get16(tail + eocd + 4) || get16(tail + eocd + 6) ||
+        get16(tail + eocd + 8) != get16(tail + eocd + 10)) goto failed;
+    zip->count = get16(tail + eocd + 10);
+    central_size = get32(tail + eocd + 12);
+    central_offset = get32(tail + eocd + 16);
+    if (zip->count == 0xffff || central_offset == 0xffffffff || central_size == 0xffffffff)
+    { hr = HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED); goto failed; }
+    position = central_offset;
+    end = position + central_size;
+    if (end > zip->length - tail_len + eocd || zip->count > central_size / 46) goto failed;
+    if (!(zip->entries = calloc(max(zip->count, 1), sizeof(*zip->entries))))
+    { hr = E_OUTOFMEMORY; goto failed; }
+    for (i = 0; i < zip->count; ++i)
+    {
+        struct zip_entry *entry = zip->entries + i;
+        unsigned name_length, total;
+        WCHAR *p;
+        int chars;
+        if (position > end || sizeof(header) > end - position ||
+            FAILED(hr = read_at(zip, position, header, sizeof(header)))) goto failed;
+        hr = invalid_zip();
+        if (get32(header) != 0x02014b50 || get16(header + 34)) goto failed;
+        entry->flags = get16(header + 8);
+        entry->method = get16(header + 10);
+        entry->crc = get32(header + 16);
+        entry->compressed = get32(header + 20);
+        entry->size = get32(header + 24);
+        entry->offset = get32(header + 42);
+        entry->name_len = name_length = get16(header + 28);
+        total = 46 + name_length + get16(header + 30) + get16(header + 32);
+        if (!name_length || total > end - position) goto failed;
+        if (entry->flags & 1 || (entry->method != 0 && entry->method != 8) ||
+            entry->compressed == 0xffffffff || entry->size == 0xffffffff || entry->offset == 0xffffffff ||
+            ((get32(header + 38) >> 16) & 0170000) == 0120000 ||
+            (get32(header + 38) & FILE_ATTRIBUTE_REPARSE_POINT))
+        { hr = HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED); goto failed; }
+        if (!(entry->raw_name = malloc(name_length))) { hr = E_OUTOFMEMORY; goto failed; }
+        if (FAILED(hr = read_at(zip, position + 46, entry->raw_name, name_length))) goto failed;
+        hr = invalid_zip();
+        if (memchr(entry->raw_name, 0, name_length)) goto failed;
+        chars = MultiByteToWideChar(entry->flags & 0x800 ? CP_UTF8 : CP_OEMCP,
+                                   entry->flags & 0x800 ? MB_ERR_INVALID_CHARS : 0,
+                                   entry->raw_name, name_length, NULL, 0);
+        if (!chars || chars > 32700) goto failed;
+        if (!(entry->name = calloc(chars + 1, sizeof(WCHAR)))) { hr = E_OUTOFMEMORY; goto failed; }
+        MultiByteToWideChar(entry->flags & 0x800 ? CP_UTF8 : CP_OEMCP,
+                           entry->flags & 0x800 ? MB_ERR_INVALID_CHARS : 0,
+                           entry->raw_name, name_length, entry->name, chars);
+        for (p = entry->name; *p; ++p) if (*p == '/') *p = '\\';
+        if (entry->name[chars - 1] == '\\') { entry->directory = TRUE; entry->name[--chars] = 0; }
+        if (!valid_name(entry->name) || (entry->directory && entry->size)) goto failed;
+        if (!entry->directory && !entry->method && entry->compressed != entry->size) goto failed;
+        position += total;
+    }
+    hr = invalid_zip();
+    if (position != end) goto failed;
+    qsort(zip->entries, zip->count, sizeof(*zip->entries), entry_compare);
+    for (i = 0; i < zip->count; ++i)
+    {
+        WCHAR *parent, *p;
+        if (i && !wcsicmp(zip->entries[i-1].name, zip->entries[i].name)) goto failed;
+        if (!(parent = wcsdup(zip->entries[i].name))) { hr = E_OUTOFMEMORY; goto failed; }
+        for (p = parent; *p; ++p) if (*p == '\\')
+        {
+            struct zip_entry *ancestor;
+            *p = 0;
+            ancestor = find_entry(zip, parent);
+            *p = '\\';
+            if (ancestor && !ancestor->directory) { free(parent); hr = invalid_zip(); goto failed; }
+        }
+        free(parent);
+    }
+    free(tail);
+    *out = zip;
+    return S_OK;
+failed:
+    free(tail);
+    shell_zip_release(zip);
+    return hr;
+}
+
+void shell_zip_addref(struct shell_zip *zip) { InterlockedIncrement(&zip->ref); }
+
+void shell_zip_release(struct shell_zip *zip)
+{
+    unsigned i;
+    if (InterlockedDecrement(&zip->ref)) return;
+    if (zip->file != INVALID_HANDLE_VALUE) CloseHandle(zip->file);
+    for (i = 0; zip->entries && i < zip->count; ++i)
+    { free(zip->entries[i].name); free(zip->entries[i].raw_name); }
+    free(zip->entries);
+    free(zip->path);
+    DeleteCriticalSection(&zip->lock);
+    free(zip);
+}
+
+const WCHAR *shell_zip_path(struct shell_zip *zip) { return zip->path; }
+
+BOOL shell_zip_directory(struct shell_zip *zip, const WCHAR *relative)
+{
+    size_t len = wcslen(relative);
+    unsigned i;
+    if (!len) return TRUE;
+    for (i = 0; i < zip->count; ++i)
+        if ((!wcsicmp(relative, zip->entries[i].name) && zip->entries[i].directory) ||
+            (!wcsnicmp(relative, zip->entries[i].name, len) && zip->entries[i].name[len] == '\\')) return TRUE;
+    return FALSE;
+}
+
+HRESULT shell_zip_size(struct shell_zip *zip, const WCHAR *relative, DWORD *size)
+{
+    struct zip_entry *entry = find_entry(zip, relative);
+    if (!entry && !shell_zip_directory(zip, relative)) return HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND);
+    *size = entry ? entry->size : 0;
+    return S_OK;
+}
+
+static int bstr_compare(const void *a, const void *b) { return wcsicmp(*(BSTR *)a, *(BSTR *)b); }
+
+HRESULT shell_zip_children(struct shell_zip *zip, const WCHAR *relative, BSTR **names, LONG *count)
+{
+    size_t prefix = wcslen(relative), archive = wcslen(zip->path);
+    unsigned i, used = 0, unique = 0;
+    BSTR *result;
+    HRESULT hr = E_OUTOFMEMORY;
+    *names = NULL;
+    *count = 0;
+    if (!(result = calloc(max(zip->count, 1), sizeof(*result)))) return hr;
+    for (i = 0; i < zip->count; ++i)
+    {
+        const WCHAR *name = zip->entries[i].name, *child, *slash;
+        size_t length;
+        if (prefix && (wcsnicmp(name, relative, prefix) || name[prefix] != '\\')) continue;
+        child = name + (prefix ? prefix + 1 : 0);
+        slash = wcschr(child, '\\');
+        length = slash ? slash - name : wcslen(name);
+        if (archive + length + 1 > 32760) { hr = HRESULT_FROM_WIN32(ERROR_FILENAME_EXCED_RANGE); goto failed; }
+        if (!(result[used] = SysAllocStringLen(NULL, archive + 1 + length))) goto failed;
+        memcpy(result[used], zip->path, archive * sizeof(WCHAR));
+        result[used][archive] = '\\';
+        memcpy(result[used] + archive + 1, name, length * sizeof(WCHAR));
+        ++used;
+    }
+    qsort(result, used, sizeof(*result), bstr_compare);
+    for (i = 0; i < used; ++i)
+    {
+        if (unique && !wcsicmp(result[unique-1], result[i])) SysFreeString(result[i]);
+        else result[unique++] = result[i];
+    }
+    *names = result;
+    *count = unique;
+    return S_OK;
+failed:
+    for (i = 0; i < used; ++i) SysFreeString(result[i]);
+    free(result);
+    return hr;
+}
+
+static HRESULT create_parents(WCHAR *path, size_t root, BOOL include_leaf)
+{
+    WCHAR *p;
+    for (p = path + root + 1; ; ++p)
+    {
+        DWORD attributes;
+        if (*p && *p != '\\') continue;
+        if (!*p && !include_leaf) break;
+        {
+            WCHAR saved = *p;
+            *p = 0;
+            if (!CreateDirectoryW(path, NULL) && GetLastError() != ERROR_ALREADY_EXISTS)
+            { *p = saved; return HRESULT_FROM_WIN32(GetLastError()); }
+            attributes = GetFileAttributesW(path);
+            *p = saved;
+            if (attributes == INVALID_FILE_ATTRIBUTES || !(attributes & FILE_ATTRIBUTE_DIRECTORY) ||
+                attributes & FILE_ATTRIBUTE_REPARSE_POINT) return HRESULT_FROM_WIN32(ERROR_ACCESS_DENIED);
+        }
+        if (!*p) break;
+    }
+    return S_OK;
+}
+
+static HRESULT extract_entry(struct shell_zip *zip, struct zip_entry *entry, HANDLE output)
+{
+    BYTE local[30], *buffers = NULL, *input, *out;
+    char *name = NULL;
+    ULONGLONG position, produced = 0;
+    DWORD remaining = entry->compressed, crc = crc32(0, NULL, 0);
+    z_stream stream = {0};
+    BOOL initialized = FALSE, ended = FALSE;
+    HRESULT hr;
+    if (FAILED(hr = read_at(zip, entry->offset, local, sizeof(local)))) return hr;
+    if (get32(local) != 0x04034b50 || get16(local + 6) != entry->flags ||
+        get16(local + 8) != entry->method || get16(local + 26) != entry->name_len) return invalid_zip();
+    position = (ULONGLONG)entry->offset + 30 + get16(local + 26) + get16(local + 28);
+    if (position > zip->length || remaining > zip->length - position) return invalid_zip();
+    if (!(name = malloc(entry->name_len))) return E_OUTOFMEMORY;
+    hr = read_at(zip, (ULONGLONG)entry->offset + 30, name, entry->name_len);
+    if (SUCCEEDED(hr) && memcmp(name, entry->raw_name, entry->name_len)) hr = invalid_zip();
+    free(name);
+    if (FAILED(hr)) return hr;
+    if (!(buffers = malloc(131072))) return E_OUTOFMEMORY;
+    input = buffers;
+    out = buffers + 65536;
+    if (entry->method == 8)
+    {
+        stream.zalloc = zip_alloc;
+        stream.zfree = zip_free;
+        if (inflateInit2(&stream, -MAX_WBITS) != Z_OK) { free(buffers); return E_OUTOFMEMORY; }
+        initialized = TRUE;
+    }
+    hr = S_OK;
+    do
+    {
+        DWORD n = min(remaining, 65536), written, amount;
+        if (n)
+        {
+            if (FAILED(hr = read_at(zip, position, input, n))) break;
+            position += n;
+            remaining -= n;
+        }
+        stream.next_in = input;
+        stream.avail_in = n;
+        do
+        {
+            BYTE *data = input;
+            if (initialized)
+            {
+                int result;
+                stream.next_out = out;
+                stream.avail_out = 65536;
+                result = inflate(&stream, Z_NO_FLUSH);
+                if (result == Z_BUF_ERROR && !stream.avail_in && remaining) break;
+                if (result != Z_OK && result != Z_STREAM_END) { hr = invalid_zip(); break; }
+                amount = 65536 - stream.avail_out;
+                ended = result == Z_STREAM_END;
+                data = out;
+            }
+            else amount = n;
+            if (amount > entry->size - produced) { hr = invalid_zip(); break; }
+            if (amount && !WriteFile(output, data, amount, &written, NULL))
+            { hr = HRESULT_FROM_WIN32(GetLastError()); break; }
+            if (amount && written != amount) { hr = HRESULT_FROM_WIN32(ERROR_WRITE_FAULT); break; }
+            produced += amount;
+            crc = crc32(crc, data, amount);
+            if (!initialized || ended || (!stream.avail_in && stream.avail_out)) break;
+        } while (SUCCEEDED(hr));
+        if (ended && (remaining || stream.avail_in)) hr = invalid_zip();
+        if (!remaining && initialized && !ended && SUCCEEDED(hr)) hr = invalid_zip();
+    } while (remaining && SUCCEEDED(hr) && !ended);
+    if (initialized) inflateEnd(&stream);
+    free(buffers);
+    if (SUCCEEDED(hr) && (produced != entry->size || crc != entry->crc)) hr = invalid_zip();
+    return hr;
+}
+
+void shell_zip_cleanup(WCHAR *directory)
+{
+    SHFILEOPSTRUCTW operation = {0};
+    if (!directory) return;
+    operation.wFunc = FO_DELETE;
+    operation.pFrom = directory; /* allocated with two terminal NULs */
+    operation.fFlags = FOF_NOCONFIRMATION | FOF_SILENT | FOF_NOERRORUI;
+    SHFileOperationW(&operation);
+    free(directory);
+}
+
+HRESULT shell_zip_stage(struct shell_zip *zip, WCHAR **directory)
+{
+    WCHAR temp[MAX_PATH], name[MAX_PATH], *stage = NULL;
+    HRESULT hr = E_FAIL;
+    unsigned i;
+    DWORD temp_length;
+    *directory = NULL;
+    temp_length = GetTempPathW(MAX_PATH, temp);
+    if (!temp_length || temp_length >= MAX_PATH) return HRESULT_FROM_WIN32(ERROR_FILENAME_EXCED_RANGE);
+    if (!GetTempFileNameW(temp, L"wsz", 0, name))
+        return HRESULT_FROM_WIN32(GetLastError());
+    if (!DeleteFileW(name) || !CreateDirectoryW(name, NULL)) return HRESULT_FROM_WIN32(GetLastError());
+    if (!(stage = calloc(wcslen(name) + 2, sizeof(WCHAR))))
+    { RemoveDirectoryW(name); return E_OUTOFMEMORY; }
+    wcscpy(stage, name);
+    EnterCriticalSection(&zip->lock);
+    for (i = 0; i < zip->count; ++i)
+    {
+        struct zip_entry *entry = zip->entries + i;
+        WCHAR *path;
+        size_t root = wcslen(stage), length = root + wcslen(entry->name) + 2;
+        HANDLE output;
+        if (length > 32760) { hr = HRESULT_FROM_WIN32(ERROR_FILENAME_EXCED_RANGE); goto failed; }
+        if (!(path = malloc(length * sizeof(WCHAR)))) { hr = E_OUTOFMEMORY; goto failed; }
+        swprintf(path, length, L"%s\\%s", stage, entry->name);
+        hr = create_parents(path, root, entry->directory);
+        if (SUCCEEDED(hr) && !entry->directory)
+        {
+            output = CreateFileW(path, GENERIC_WRITE, 0, NULL, CREATE_NEW,
+                                 FILE_ATTRIBUTE_NORMAL | FILE_FLAG_OPEN_REPARSE_POINT, NULL);
+            if (output == INVALID_HANDLE_VALUE) hr = HRESULT_FROM_WIN32(GetLastError());
+            else { hr = extract_entry(zip, entry, output); CloseHandle(output); }
+        }
+        free(path);
+        if (FAILED(hr)) goto failed;
+    }
+    LeaveCriticalSection(&zip->lock);
+    *directory = stage;
+    return S_OK;
+failed:
+    LeaveCriticalSection(&zip->lock);
+    shell_zip_cleanup(stage);
+    return hr;
+}
