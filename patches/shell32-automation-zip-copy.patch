+static HRESULT append_copy_path(WCHAR **list, size_t *used, const WCHAR *path,
+                               struct shell_zip *zip, const WCHAR *stage)
+{
+    const WCHAR *relative = path;
+    size_t length, total;
+    WCHAR *new_list;
+    if (!path || !*path) return E_INVALIDARG;
+    if (zip)
+    {
+        size_t archive = wcslen(shell_zip_path(zip));
+        if (wcsnicmp(path, shell_zip_path(zip), archive) || path[archive] != '\\') return E_INVALIDARG;
+        relative = path + archive + 1;
+        length = wcslen(stage) + 1 + wcslen(relative);
+    }
+    else length = wcslen(path);
+    if (length > 32760 || *used > 0x7fffffff / sizeof(WCHAR) - length - 2) return E_OUTOFMEMORY;
+    total = *used + length + 2;
+    if (!(new_list = realloc(*list, total * sizeof(WCHAR)))) return E_OUTOFMEMORY;
+    *list = new_list;
+    if (zip) swprintf(new_list + *used, length + 1, L"%s\\%s", stage, relative);
+    else memcpy(new_list + *used, path, (length + 1) * sizeof(WCHAR));
+    *used += length + 1;
+    new_list[*used] = 0;
+    return S_OK;
+}
