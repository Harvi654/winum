From: Harvi654 <202698022+Harvi654@users.noreply.github.com>
Subject: [PATCH] riched20: Drop temporary formatting after ITextFont::Reset(tomApplyTmp).

AI-assisted (Claude), original code; LGPL-2.1-or-later. Not submitted
upstream.

Windows 10 (x86_64 and i686, msftedit; winum
docs/wine-repro/riched20-textfont-applytmp, windows-2026-11-09):
ITextFont::Reset(tomApplyTmp) on a font of a range returns S_OK, and the
changes made after it are temporary - the font object's getters and
EM_GETCHARFORMAT keep the old values, and a following Reset(tomApplyNow),
also after Reset(tomApplyLater), writes nothing. When the text changed
after the font object was taken, the newer formatting stays.

Wine ignored tomApplyTmp (FIXME), so the changes went into the text, and
the next tomApplyNow wrote the font's cached properties back over newer
formatting. Inventor's spell checker uses temporary formatting for its
wavy underline; inserting a symbol turned the text black. Temporary
formatting is not displayed here; the changes are collected and dropped.

Not changed: RichEdit20W on Windows (riched20.dll) returns E_INVALIDARG
for tomApplyTmp and applies the changes directly; Wine's riched20 serves
both classes and follows msftedit. A duplicated (detached) font returns
S_OK on Windows and E_NOTIMPL in Wine, and SetUnderline(tomWave) fails in
Wine; both are todo_wine in the test.

v2 (2026-11-09): tomApplyLater no longer ends the temporary state (v1 made
the following tomApplyNow write the temporary changes, Windows does not);
adds the Wine test in dlls/msftedit/tests.

--- a/dlls/msftedit/tests/richole.c
+++ b/dlls/msftedit/tests/richole.c
@@ -181,10 +181,138 @@
     ITextSelection_Release(txtsel);
 }
 
+/* ITextFont::Reset(tomApplyTmp): changes made after it are temporary - the
+ * font object and the text's CHARFORMAT keep the old values, and a
+ * following tomApplyNow (also after tomApplyLater) writes nothing, not even
+ * values cached before the text changed. Measured on Windows 10 with
+ * msftedit (x86_64 and i686). */
+#define check_range_format(a,b,c,d) check_range_format_(__LINE__,a,b,c,d)
+static void check_range_format_(unsigned int line, HWND hwnd, LONG start, COLORREF color, BOOL bold)
+{
+    CHARFORMAT2W cf;
+
+    memset(&cf, 0, sizeof(cf));
+    cf.cbSize = sizeof(cf);
+    SendMessageW(hwnd, EM_SETSEL, start, start + 3);
+    SendMessageW(hwnd, EM_GETCHARFORMAT, SCF_SELECTION, (LPARAM)&cf);
+    ok_(__FILE__, line)((cf.dwMask & CFM_COLOR) && !(cf.dwEffects & CFE_AUTOCOLOR) && cf.crTextColor == color,
+                        "got mask %#lx effects %#lx color %#lx, expected %#lx\n",
+                        cf.dwMask, cf.dwEffects, cf.crTextColor, color);
+    ok_(__FILE__, line)((cf.dwMask & CFM_BOLD) && !!(cf.dwEffects & CFE_BOLD) == bold,
+                        "got mask %#lx effects %#lx, expected bold %d\n", cf.dwMask, cf.dwEffects, bold);
+}
+
+static void test_textfont_applytmp(void)
+{
+    static const char *sequences[] = { "now", "stale", "later", "empty" };
+    COLORREF expected;
+    ITextDocument *doc;
+    IRichEditOle *ole;
+    ITextRange *range;
+    ITextFont *font, *dup;
+    CHARFORMAT2W cf;
+    unsigned int s;
+    HRESULT hr;
+    LONG value;
+    HWND hwnd;
+
+    for (s = 0; s < ARRAY_SIZE(sequences); s++)
+    {
+        winetest_push_context("%s", sequences[s]);
+        hwnd = new_window(MSFTEDIT_CLASS, ES_MULTILINE, NULL);
+        ole = NULL;
+        SendMessageW(hwnd, EM_GETOLEINTERFACE, 0, (LPARAM)&ole);
+        ok(ole != NULL, "no IRichEditOle\n");
+        hr = IRichEditOle_QueryInterface(ole, &IID_ITextDocument, (void **)&doc);
+        ok(hr == S_OK, "got %#lx\n", hr);
+
+        /* "abc def ghi" in green, "def" red and bold */
+        SendMessageW(hwnd, WM_SETTEXT, 0, (LPARAM)L"abc def ghi");
+        memset(&cf, 0, sizeof(cf));
+        cf.cbSize = sizeof(cf);
+        cf.dwMask = CFM_COLOR | CFM_BOLD;
+        cf.crTextColor = RGB(0, 128, 0);
+        SendMessageW(hwnd, EM_SETCHARFORMAT, SCF_ALL, (LPARAM)&cf);
+        SendMessageW(hwnd, EM_SETSEL, 4, 7);
+        cf.crTextColor = RGB(255, 0, 0);
+        cf.dwEffects = CFE_BOLD;
+        SendMessageW(hwnd, EM_SETCHARFORMAT, SCF_SELECTION, (LPARAM)&cf);
+        expected = RGB(255, 0, 0);
+
+        hr = ITextDocument_Range(doc, 4, 7, &range);
+        ok(hr == S_OK, "got %#lx\n", hr);
+        hr = ITextRange_GetFont(range, &font);
+        ok(hr == S_OK, "got %#lx\n", hr);
+
+        if (s == 1)
+        {
+            /* the text changes after the font object was taken */
+            cf.dwMask = CFM_COLOR;
+            cf.crTextColor = RGB(128, 0, 128);
+            SendMessageW(hwnd, EM_SETSEL, 4, 7);
+            SendMessageW(hwnd, EM_SETCHARFORMAT, SCF_SELECTION, (LPARAM)&cf);
+            expected = RGB(128, 0, 128);
+            hr = ITextFont_GetForeColor(font, &value);
+            ok(hr == S_OK && (COLORREF)value == expected, "got %#lx, color %#lx\n", hr, value);
+        }
+
+        hr = ITextFont_Reset(font, tomApplyTmp);
+        ok(hr == S_OK, "got %#lx\n", hr);
+        if (s != 3)
+        {
+            hr = ITextFont_SetUnderline(font, tomWave);
+            todo_wine ok(hr == S_OK, "got %#lx\n", hr);
+            hr = ITextFont_SetForeColor(font, RGB(0, 0, 255));
+            ok(hr == S_OK, "got %#lx\n", hr);
+            hr = ITextFont_SetBold(font, tomFalse);
+            ok(hr == S_OK, "got %#lx\n", hr);
+
+            /* neither the font object nor the text show the changes */
+            hr = ITextFont_GetForeColor(font, &value);
+            ok(hr == S_OK && (COLORREF)value == expected, "got %#lx, color %#lx\n", hr, value);
+            hr = ITextFont_GetBold(font, &value);
+            ok(hr == S_OK && value == tomTrue, "got %#lx, bold %ld\n", hr, value);
+            hr = ITextFont_GetUnderline(font, &value);
+            ok(hr == S_OK && value == tomNone, "got %#lx, underline %ld\n", hr, value);
+            check_range_format(hwnd, 4, expected, TRUE);
+        }
+        if (s == 2)
+        {
+            hr = ITextFont_Reset(font, tomApplyLater);
+            ok(hr == S_OK, "got %#lx\n", hr);
+        }
+        hr = ITextFont_Reset(font, tomApplyNow);
+        ok(hr == S_OK, "got %#lx\n", hr);
+        check_range_format(hwnd, 4, expected, TRUE);
+        check_range_format(hwnd, 0, RGB(0, 128, 0), FALSE);
+        check_range_format(hwnd, 8, RGB(0, 128, 0), FALSE);
+
+        if (s == 0)
+        {
+            /* a font that is not attached to a range */
+            hr = ITextFont_GetDuplicate(font, &dup);
+            ok(hr == S_OK, "got %#lx\n", hr);
+            hr = ITextFont_Reset(dup, tomApplyTmp);
+            todo_wine ok(hr == S_OK, "got %#lx\n", hr);
+            hr = ITextFont_Reset(dup, tomApplyNow);
+            ok(hr == S_OK, "got %#lx\n", hr);
+            ITextFont_Release(dup);
+        }
+
+        ITextFont_Release(font);
+        ITextRange_Release(range);
+        ITextDocument_Release(doc);
+        IRichEditOle_Release(ole);
+        DestroyWindow(hwnd);
+        winetest_pop_context();
+    }
+}
+
 START_TEST(richole)
 {
     msftedit_hmodule = LoadLibraryA("msftedit.dll");
     ok(msftedit_hmodule != NULL, "error: %d\n", (int) GetLastError());
 
     test_Interfaces();
+    test_textfont_applytmp();
 }
--- a/dlls/riched20/richole.c
+++ b/dlls/riched20/richole.c
@@ -224,6 +224,7 @@
     textfont_prop_val props[FONT_PROPID_LAST];
     BOOL get_cache_enabled;
     BOOL set_cache_enabled;
+    BOOL apply_tmp;
 } ITextFontImpl;
 
 typedef struct ITextParaImpl {
@@ -727,6 +728,9 @@
     CHARFORMAT2W fmt;
     LONG start, end;
 
+    if (font->apply_tmp)
+        TRACE("temporary formatting, property %d not applied\n", propid);
+
     /* when font is not attached to any range use cache */
     if (!font->range || font->set_cache_enabled) {
         if (propid == FONT_NAME) {
@@ -3004,11 +3008,29 @@
             This->get_cache_enabled = FALSE;
             break;
         case tomApplyLater:
+            /* temporary changes stay temporary: a following tomApplyNow
+               drops them as well */
             This->set_cache_enabled = TRUE;
             break;
         case tomApplyNow:
             This->set_cache_enabled = FALSE;
-            textfont_apply_range_props(This);
+            /* temporary (display-only) formatting is not supported: drop it
+               instead of writing it into the text */
+            if (This->apply_tmp)
+                This->apply_tmp = FALSE;
+            else
+                textfont_apply_range_props(This);
+            break;
+        case tomApplyTmp:
+            /* Temporary formatting is shown on screen only and never becomes
+               part of the text (spell checkers use it for the wavy underline
+               under misspelled words). It is not implemented; collect the
+               following changes in the cache and drop them, rather than
+               applying them as real formatting. */
+            WARN("temporary formatting (tomApplyTmp) not supported, ignored\n");
+            textfont_cache_range_props(This);
+            This->set_cache_enabled = TRUE;
+            This->apply_tmp = TRUE;
             break;
         case tomUsePoints:
         case tomUseTwips:
@@ -3495,6 +3517,7 @@
 
     font->ITextFont_iface.lpVtbl = &textfontvtbl;
     font->ref = 1;
+    font->apply_tmp = FALSE;
 
     if (src) {
         font->range = NULL;
