+
+/* Count boundaries reached, with the last legal position set by the endpoint. */
+static LONG textrange_move_paragraphs(ME_TextEditor *editor, LONG *offset, LONG count, LONG limit)
+{
+    ME_Paragraph *para = textrange_paragraph_at(editor, *offset);
+    LONG moved = 0;
+
+    while (count > 0 && *offset < limit)
+    {
+        para = para_next(para);
+        *offset = min(para->nCharOfs, limit);
+        --count;
+        ++moved;
+    }
+
+    while (count < 0)
+    {
+        if (*offset <= para->nCharOfs)
+            para = para_prev(para);
+        if (!para)
+            break;
+        *offset = para->nCharOfs;
+        ++count;
+        --moved;
+    }
+    return moved;
+}
