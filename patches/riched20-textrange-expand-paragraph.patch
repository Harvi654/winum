+        { move_end, 1, 31, 32, 31, 32, 0, S_FALSE },
+    };
+
+    run_paragraph_cases(doc, L"-\r", short_cases, ARRAY_SIZE(short_cases));
+    run_paragraph_cases(doc, L"Alpha beta. Next!\rGamma delta.", two_paragraphs, ARRAY_SIZE(two_paragraphs));
+    run_paragraph_cases(doc, L"Alpha beta. Next!\rGamma delta.\r", two_trailing_cr, ARRAY_SIZE(two_trailing_cr));
+}
