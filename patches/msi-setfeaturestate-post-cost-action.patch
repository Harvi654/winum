+
+struct feature
+{
+    const char *name, *parent;
+    unsigned int level, attributes;
+};
+
+static const struct feature features[] =
+{
+    {"Root", NULL, 100, 0},
+    {"Anchor", "Root", 100, 24},
+    {"Branch", "Root", 100, 26},
+    {"UpperParent", "Branch", 200, 10},
+    {"Parent", "UpperParent", 200, 10},
+    {"Grandchild", "Parent", 200, 8},
+    {"Sibling", "Parent", 100, 10},
+    {"PlainSibling", "Parent", 100, 8},
+    {"Leaf", "Grandchild", 200, 8}
+};
+
+struct variant
+{
+    const char *name, *selection;
+    BOOL set;
+    unsigned int parent_level;
+};
+
+static const struct variant variants[] =
+{
+    {"maintenance-level", "", TRUE, 200},
+    {"maintenance-addlocal", "ADDLOCAL=Anchor", TRUE, 200}
+};
+static BOOL chain = TRUE;
+
+static BOOL active_feature(unsigned int index)
+{
+    return chain || strcmp(features[index].name, "UpperParent");
+}
+
+#ifndef STANDALONE
+static char own_ca_path[MAX_PATH];
+#endif
+
+static UINT execute(MSIHANDLE db, const char *sql)
+{
+    MSIHANDLE view = 0;
+    UINT result = MsiDatabaseOpenViewA(db, sql, &view);
+    if (!result) result = MsiViewExecute(view, 0);
+    if (view) MsiCloseHandle(view);
+    return result;
+}
+
+static BOOL new_guid(char *text)
+{
+    GUID guid;
+    WCHAR wide[39];
+    HRESULT hr = CoCreateGuid(&guid);
+    ok(hr == S_OK, "CoCreateGuid returned %#lx\n", hr);
+    if (hr != S_OK) return FALSE;
+    StringFromGUID2(&guid, wide, ARRAY_SIZE(wide));
+    return !!WideCharToMultiByte(CP_ACP, 0, wide, -1, text, 39, NULL, NULL);
+}
+
+static UINT insert_feature(MSIHANDLE db, const struct variant *variant, unsigned int index)
+{
+    const struct feature *f = features + index;
+    const char *parent = !chain && !strcmp(f->name, "Parent") ? "Branch" : f->parent;
+    char sql[1024];
+    unsigned int level = (!strcmp(f->name, "Parent") || !strcmp(f->name, "UpperParent")) ? variant->parent_level : f->level;
+    if (parent)
+        snprintf(sql, sizeof(sql), "INSERT INTO `Feature` (`Feature`,`Feature_Parent`,`Title`,`Display`,`Level`,`Directory_`,`Attributes`) VALUES ('%s','%s','%s',%u,%u,'PROBEDIR',%u)",
+                 f->name, parent, f->name, index + 1, level, f->attributes);
+    else
+        snprintf(sql, sizeof(sql), "INSERT INTO `Feature` (`Feature`,`Title`,`Display`,`Level`,`Directory_`,`Attributes`) VALUES ('%s','%s',%u,%u,'PROBEDIR',%u)",
+                 f->name, f->name, index + 1, level, f->attributes);
+    return execute(db, sql);
+}
+
+static UINT insert_own_ca(MSIHANDLE db)
+{
+    char path[MAX_PATH], *slash;
+    MSIHANDLE view = 0, record = 0;
+    UINT result;
+#ifdef STANDALONE
+    DWORD size = GetModuleFileNameA(NULL, path, sizeof(path));
+    if (!size || size >= sizeof(path) || !(slash = strrchr(path, '\\'))) return ERROR_INVALID_DATA;
+    *++slash = 0;
+    if (strlen(path) + 40 >= sizeof(path)) return ERROR_INVALID_DATA;
+    strcat(path, sizeof(void *) == 8 ? "msi-maintenance-ca-x86_64.dll" : "msi-maintenance-ca-i686.dll");
+#else
+    (void)slash;
+    strcpy(path, own_ca_path);
+#endif
+    result = execute(db, "CREATE TABLE `Binary` (`Name` CHAR(72) NOT NULL, `Data` OBJECT NOT NULL PRIMARY KEY `Name`)");
+    if (!result) result = execute(db, "CREATE TABLE `CustomAction` (`Action` CHAR(72) NOT NULL, `Type` SHORT NOT NULL, `Source` CHAR(72), `Target` CHAR(255) PRIMARY KEY `Action`)");
+    if (result) return result;
+    result = MsiDatabaseOpenViewA(db, "INSERT INTO `Binary` (`Name`,`Data`) VALUES ('OwnFeatureStateCA', ?)", &view);
+    if (result) goto done;
+    record = MsiCreateRecord(1);
+    if (!record) { result = ERROR_OUTOFMEMORY; goto done; }
+    result = MsiRecordSetStreamA(record, 1, path);
+    if (!result) result = MsiViewExecute(view, record);
+    if (!result) result = execute(db, "INSERT INTO `CustomAction` (`Action`,`Type`,`Source`,`Target`) VALUES ('OwnSetFeatures',1,'OwnFeatureStateCA','ProbeMaintenance')");
+    if (!result) result = execute(db, "INSERT INTO `InstallExecuteSequence` (`Action`,`Condition`,`Sequence`) VALUES ('OwnSetFeatures','Installed AND NOT REMOVE',1100)");
+done:
+    if (record) MsiCloseHandle(record);
+    if (view) MsiCloseHandle(view);
+    return result;
+}
+
+static BOOL create_package(const char *path, const char *product, const struct variant *variant)
+{
+    static const char *schema[] =
+    {
+        "CREATE TABLE `Property` (`Property` CHAR(72) NOT NULL, `Value` CHAR(0) LOCALIZABLE PRIMARY KEY `Property`)",
+        "CREATE TABLE `Directory` (`Directory` CHAR(72) NOT NULL, `Directory_Parent` CHAR(72), `DefaultDir` CHAR(255) NOT NULL PRIMARY KEY `Directory`)",
+        "CREATE TABLE `Feature` (`Feature` CHAR(38) NOT NULL, `Feature_Parent` CHAR(38), `Title` CHAR(64), `Description` CHAR(255), `Display` SHORT, `Level` SHORT, `Directory_` CHAR(72), `Attributes` SHORT PRIMARY KEY `Feature`)",
+        "CREATE TABLE `Component` (`Component` CHAR(72) NOT NULL, `ComponentId` CHAR(38), `Directory_` CHAR(72), `Attributes` SHORT, `Condition` CHAR(255), `KeyPath` CHAR(72) PRIMARY KEY `Component`)",
+        "CREATE TABLE `FeatureComponents` (`Feature_` CHAR(38) NOT NULL, `Component_` CHAR(72) NOT NULL PRIMARY KEY `Feature_`, `Component_`)",
+        /* Windows' RegisterProduct reads Media (2228 without it); one empty disk. */
+        "CREATE TABLE `Media` (`DiskId` SHORT NOT NULL, `LastSequence` SHORT NOT NULL, `DiskPrompt` CHAR(64), `Cabinet` CHAR(255), `VolumeLabel` CHAR(32), `Source` CHAR(72) PRIMARY KEY `DiskId`)",
+        "INSERT INTO `Media` (`DiskId`,`LastSequence`) VALUES (1,0)",
+        "CREATE TABLE `InstallExecuteSequence` (`Action` CHAR(72) NOT NULL, `Condition` CHAR(255), `Sequence` SHORT PRIMARY KEY `Action`)",
+        "INSERT INTO `Property` (`Property`,`Value`) VALUES ('ProductName','Synthetic feature selection probe')",
+        "INSERT INTO `Property` (`Property`,`Value`) VALUES ('Manufacturer','Synthetic MSI tests')",
+        "INSERT INTO `Property` (`Property`,`Value`) VALUES ('ProductVersion','1.0.0')",
+        "INSERT INTO `Property` (`Property`,`Value`) VALUES ('ProductLanguage','1033')",
+        "INSERT INTO `Property` (`Property`,`Value`) VALUES ('INSTALLLEVEL','100')",
+        "INSERT INTO `Directory` (`Directory`,`DefaultDir`) VALUES ('TARGETDIR','SourceDir')",
+        "INSERT INTO `Directory` (`Directory`,`Directory_Parent`,`DefaultDir`) VALUES ('PROBEDIR','TARGETDIR','FeatureProbe')"
+    };
+    static const struct { const char *name; unsigned int sequence; } actions[] =
+    {
+        {"CostInitialize", 800}, {"FileCost", 900}, {"CostFinalize", 1000},
+        {"InstallValidate", 1400}, {"InstallInitialize", 1500},
+        {"ProcessComponents", 1600}, {"UnpublishFeatures", 1800},
+        {"RegisterProduct", 6100}, {"PublishFeatures", 6300},
+        {"PublishProduct", 6400}, {"InstallFinalize", 6600}
+    };
+    MSIHANDLE db = 0, summary = 0;
+    char sql[1024], guid[39];
+    unsigned int i, count = ARRAY_SIZE(features);
+    const struct feature *feature;
+    UINT result;
+    BOOL success = FALSE;
+
+    result = MsiOpenDatabaseA(path, (LPCSTR)MSIDBOPEN_CREATE, &db);
+    ok(result == ERROR_SUCCESS, "create database returned %u\n", result);
+    if (result) return FALSE;
+#define EXEC_SQL(statement) do { result = execute(db, statement); \
+    ok(result == ERROR_SUCCESS, "database statement returned %u\n", result); \
+    if (result) goto done; } while (0)
+    for (i = 0; i < ARRAY_SIZE(schema); ++i) EXEC_SQL(schema[i]);
+    sprintf(sql, "INSERT INTO `Property` (`Property`,`Value`) VALUES ('ProductCode','%s')", product);
+    EXEC_SQL(sql);
+    for (i = 0; i < count; ++i)
+    {
+        if (!active_feature(i)) continue;
+        feature = features + i;
+        result = insert_feature(db, variant, i);
+        ok(!result, "feature row returned %u\n", result);
+        if (result) goto done;
+        if (!new_guid(guid)) goto done;
+        /* Empty components: directory key path, unique GUID, no File/Registry rows. */
+        sprintf(sql, "INSERT INTO `Component` (`Component`,`ComponentId`,`Directory_`,`Attributes`) VALUES ('C_%s','%s','PROBEDIR',0)", feature->name, guid);
+        EXEC_SQL(sql);
+        sprintf(sql, "INSERT INTO `FeatureComponents` (`Feature_`,`Component_`) VALUES ('%s','C_%s')", feature->name, feature->name);
+        EXEC_SQL(sql);
+    }
+    for (i = 0; i < ARRAY_SIZE(actions); ++i)
+    {
+        sprintf(sql, "INSERT INTO `InstallExecuteSequence` (`Action`,`Sequence`) VALUES ('%s',%u)", actions[i].name, actions[i].sequence);
+        EXEC_SQL(sql);
+    }
+    if (variant->set)
+    {
+        result = insert_own_ca(db);
+        ok(!result, "embed our synthetic CA returned %u\n", result);
+        if (result) goto done;
+    }
+#undef EXEC_SQL
+    if (!new_guid(guid)) goto done;
+    result = MsiGetSummaryInformationA(db, NULL, 5, &summary);
+    ok(!result, "open summary returned %u\n", result);
+    if (result) goto done;
+#define SUMMARY(call) do { result = (call); ok(!result, "summary returned %u\n", result); if (result) goto done; } while (0)
+    SUMMARY(MsiSummaryInfoSetPropertyA(summary, 7, VT_LPSTR, 0, NULL, sizeof(void *) == 8 ? "x64;1033" : "Intel;1033"));
+    SUMMARY(MsiSummaryInfoSetPropertyA(summary, 9, VT_LPSTR, 0, NULL, guid));
+    SUMMARY(MsiSummaryInfoSetPropertyA(summary, 14, VT_I4, 200, NULL, NULL));
+    SUMMARY(MsiSummaryInfoSetPropertyA(summary, 15, VT_I4, 0, NULL, NULL));
+    SUMMARY(MsiSummaryInfoPersist(summary));
+    SUMMARY(MsiDatabaseCommit(db));
+#undef SUMMARY
+    success = TRUE;
+done:
+    if (summary) MsiCloseHandle(summary);
+    MsiCloseHandle(db);
+    return success;
+}
+
+static unsigned int observations, sets, flags;
+static INT CALLBACK ui_handler(void *context, UINT type, const char *message)
+{
+    (void)context; (void)type;
+    if (!message) return 0;
+    if (!strncmp(message, "P21OBS ", 7)) { observations++; trace("MEASURE %s\n", message); }
+    if (!strncmp(message, "P21SET ", 7)) { sets++; trace("MEASURE %s\n", message); }
+    if (!strncmp(message, "P21FLAGS ", 9)) { flags++; trace("MEASURE %s\n", message); }
+    return 0;
+}
+
+static void test_variant(const char *directory, const struct variant *variant)
+{
+    char path[MAX_PATH], command[2 * MAX_PATH], product[39];
+    UINT result;
+    unsigned int i;
+    winetest_push_context("%s", variant->name);
+    if (!new_guid(product)) goto done;
+    snprintf(path, sizeof(path), "%s\\probe.msi", directory);
+    if (!create_package(path, product, variant)) goto remove_file;
+    snprintf(command, sizeof(command), "ALLUSERS=1 INSTALLLEVEL=100 ADDLOCAL=Anchor PROBEDIR=\"%s\\empty\"", directory);
+    observations = sets = flags = 0;
+    result = MsiInstallProductA(path, command);
+    ok(!result, "initial registration rc=%u\n", result);
+    ok(!observations && !sets && !flags, "maintenance CA ran during fresh install\n");
+    if (result) goto uninstall;
+    snprintf(command, sizeof(command), "ALLUSERS=1 INSTALLLEVEL=100 %s PROBEDIR=\"%s\\empty\"", variant->selection, directory);
+    result = MsiInstallProductA(path, command);
+    ok(!result, "maintenance rc=%u\n", result);
+    ok(flags == 1 && sets == 1 && observations == 2 * ARRAY_SIZE(features),
+       "incomplete maintenance capture: flags=%u sets=%u observations=%u\n", flags, sets, observations);
+    /* No native state expectations yet. Record all public published states. */
+    for (i = 0; i < ARRAY_SIZE(features); i++)
+        trace("MEASURE P21PUBLISH name=%s state=%d\n", features[i].name,
+              MsiQueryFeatureStateA(product, features[i].name));
+ uninstall:
+    snprintf(command, sizeof(command), "ALLUSERS=1 REMOVE=ALL PROBEDIR=\"%s\\empty\"", directory);
+    result = MsiConfigureProductExA(product, INSTALLLEVEL_DEFAULT, INSTALLSTATE_ABSENT, command);
+    ok(!result, "uninstall rc=%u\n", result);
+    ok(MsiQueryProductStateA(product) == INSTALLSTATE_UNKNOWN, "synthetic product still registered\n");
+ remove_file:
+    ok(DeleteFileA(path), "remove synthetic MSI rc=%lu\n", GetLastError());
+ done:
+    winetest_pop_context();
+}
+
+#ifndef STANDALONE
+void restart_as_admin_elevated(void);
+#endif
+
+static BOOL is_process_limited(void)
+{
+    SID_IDENTIFIER_AUTHORITY authority = SECURITY_NT_AUTHORITY;
+    TOKEN_ELEVATION_TYPE type = TokenElevationTypeDefault;
+    HANDLE token;
+    PSID administrators;
+    DWORD size;
+    BOOL member = FALSE;
+
+    if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token)) return TRUE;
+    GetTokenInformation(token, TokenElevationType, &type, sizeof(type), &size);
+    CloseHandle(token);
+    if (type == TokenElevationTypeLimited) return TRUE;
+
+    /* A standard user without a linked UAC token also cannot install ALLUSERS. */
+    if (!AllocateAndInitializeSid(&authority, 2, SECURITY_BUILTIN_DOMAIN_RID,
+                                 DOMAIN_ALIAS_RID_ADMINS, 0, 0, 0, 0, 0, 0, &administrators))
+        return TRUE;
+    CheckTokenMembership(NULL, administrators, &member);
+    FreeSid(administrators);
+    return !member;
+}
+
+START_TEST(maintenance)
+{
+    char directory[MAX_PATH], temp[MAX_PATH], exe[MAX_PATH];
+    DWORD length;
+    unsigned int i;
+    INSTALLUILEVEL previous;
+    INSTALLUI_HANDLERA previous_handler;
+
+#ifndef STANDALONE
+    restart_as_admin_elevated();
+#endif
+    if (is_process_limited())
+    {
+        skip("ALLUSERS installation requires an administrator token\n");
+        return;
+    }
+
+#ifdef STANDALONE
+    length = GetModuleFileNameA(NULL,exe,sizeof(exe));
+    ok(length && length < sizeof(exe) && !strnicmp(exe,"C:\\",3),"copy the whole bundle to C: before running\n");
+    if (!length || length >= sizeof(exe) || strnicmp(exe,"C:\\",3)) return;
+#else
+    (void)exe;
+#endif
+    length = GetTempPathA(sizeof(temp),temp);
+    ok(length && length < sizeof(temp),"temporary directory unavailable\n");
+    if (!length || length >= sizeof(temp)) return;
+    if (!GetTempFileNameA(temp,"anc",0,directory)) { ok(0,"unique directory rc=%lu\n",GetLastError()); return; }
+    if (!DeleteFileA(directory) || !CreateDirectoryA(directory,NULL)) { ok(0,"create scratch directory rc=%lu\n",GetLastError()); return; }
+#ifndef STANDALONE
+    {
+        HRSRC resource = FindResourceA(NULL, "maintenance_ca.dll", "TESTDLL");
+        HANDLE file;
+        DWORD written, size;
+        const void *data;
+        ok(!!resource, "own CA resource missing\n");
+        if (!resource) goto cleanup;
+        data = LockResource(LoadResource(NULL, resource));
+        size = SizeofResource(NULL, resource);
+        snprintf(own_ca_path, sizeof(own_ca_path), "%s\\own-ca.dll", directory);
+        file = CreateFileA(own_ca_path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL);
+        ok(file != INVALID_HANDLE_VALUE, "create own CA file rc=%lu\n", GetLastError());
+        if (file == INVALID_HANDLE_VALUE) goto cleanup;
+        if (!WriteFile(file,data,size,&written,NULL) || written != size)
+        { ok(0, "write own CA resource failed\n"); CloseHandle(file); goto cleanup; }
+        CloseHandle(file);
+    }
+#endif
+    winetest_mute_threshold = 1000;
+    if (winetest_debug < 1) winetest_debug = 1;
+    previous = MsiSetInternalUI(INSTALLUILEVEL_NONE,NULL);
+    previous_handler = MsiSetExternalUIA(ui_handler,INSTALLLOGMODE_INFO | INSTALLLOGMODE_ACTIONSTART,NULL);
+    trace("Maintenance MEASURE only, native states unknown, bits=%u\n",
+          (unsigned int)(8 * sizeof(void *)));
+    for (i = 0; i < ARRAY_SIZE(variants); ++i) test_variant(directory,variants + i);
+    MsiSetExternalUIA(previous_handler,0,NULL);
+    MsiSetInternalUI(previous,NULL);
+#ifndef STANDALONE
+cleanup:
+    DeleteFileA(own_ca_path);
+#endif
+    ok(RemoveDirectoryA(directory),"remove scratch directory rc=%lu\n",GetLastError());
+}
