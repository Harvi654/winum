+#endif
+
+#include <windows.h>
+#include <msi.h>
+#include <msiquery.h>
+#include <string.h>
+
+static void observe(MSIHANDLE package, const char *stage)
+{
+    static const char *names[] = {"Root", "Anchor", "Branch", "UpperParent", "Parent",
+                                 "Grandchild", "Sibling", "PlainSibling", "Leaf"};
+    unsigned int i;
+    for (i = 0; i < sizeof(names) / sizeof(names[0]); i++)
+    {
+        INSTALLSTATE installed = -99, request = -99;
+        UINT rc = MsiGetFeatureStateA(package, names[i], &installed, &request);
+        MSIHANDLE record = MsiCreateRecord(5);
+        MsiRecordSetStringA(record, 0, "P21OBS stage=[1] name=[2] rc=[3] installed=[4] request=[5]");
+        MsiRecordSetStringA(record, 1, stage);
+        MsiRecordSetStringA(record, 2, names[i]);
+        MsiRecordSetInteger(record, 3, rc);
+        MsiRecordSetInteger(record, 4, installed);
+        MsiRecordSetInteger(record, 5, request);
+        MsiProcessMessage(package, INSTALLMESSAGE_INFO, record);
+        MsiCloseHandle(record);
+    }
+}
+
+UINT __stdcall ProbeMaintenance(MSIHANDLE package)
+{
+    char installed[16] = "", costing[16] = "";
+    DWORD ni = sizeof(installed), nc = sizeof(costing);
+    UINT ri = MsiGetPropertyA(package, "Installed", installed, &ni);
+    UINT rc = MsiGetPropertyA(package, "CostingComplete", costing, &nc), result;
+    MSIHANDLE record = MsiCreateRecord(5);
+    MsiRecordSetStringA(record, 0, "P21FLAGS stage=[1] installed_rc=[2] installed=[3] costing_rc=[4] costing=[5]");
+    MsiRecordSetStringA(record, 1, "maintenance");
+    MsiRecordSetInteger(record, 2, ri);
+    MsiRecordSetStringA(record, 3, installed);
+    MsiRecordSetInteger(record, 4, rc);
+    MsiRecordSetStringA(record, 5, costing);
+    MsiProcessMessage(package, INSTALLMESSAGE_INFO, record);
+    MsiCloseHandle(record);
+    /* Properties are MEASURE only; the sequence condition selects maintenance. */
+    observe(package, "before");
+    result = MsiSetFeatureStateA(package, "Grandchild", INSTALLSTATE_LOCAL);
+    record = MsiCreateRecord(2);
+    MsiRecordSetStringA(record, 0, "P21SET target=[1] requested=3 rc=[2]");
+    MsiRecordSetStringA(record, 1, "Grandchild");
+    MsiRecordSetInteger(record, 2, result);
+    MsiProcessMessage(package, INSTALLMESSAGE_INFO, record);
+    MsiCloseHandle(record);
+    observe(package, "after");
+    return ERROR_SUCCESS;
