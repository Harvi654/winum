# vkd3d-proton built by winum (.github/workflows/build-vkd3d.yml) for
# Inventor's GPU ray tracing: upstream release + gpu/vkd3d-proton/*.patch.
# A release is the signed tag vkd3d-proton-<VKD3D_VERSION>-winum-<VKD3D_WINUM_BUILD>,
# made by the maintainer; the workflow refuses a tag that does not match.
# Raise VKD3D_WINUM_BUILD whenever a patch here changes.
VKD3D_VERSION=3.0.1
VKD3D_TAG=v3.0.1
VKD3D_COMMIT=3b10bd7a7ec6a7347e616cf8bea59333afec2255
VKD3D_WINUM_BUILD=1
