# Native assertion L1 for mshtml plus the diagnostic NDR controls.
mshtml-open-l1 | docs/wine-repro/mshtml-document-open-optional-result/l1.c | -Wextra -lole32 -loleaut32 -luuid -static
ndrstub-generated-control | docs/wine-repro/rpcrt4-ndrstubcall3/generated-control.c | -Wextra -lrpcrt4 -lole32 -luuid -static
ndrstub-control | docs/wine-repro/rpcrt4-ndrstubcall3/control.c | -Wextra -lrpcrt4 -lole32 -luuid -static
ndrstub-call3 | docs/wine-repro/rpcrt4-ndrstubcall3/measure.c | -Wextra -lrpcrt4 -lole32 -luuid -static
