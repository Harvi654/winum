# Batch 1 native observations (comctl32, riched20); one entry per patch.
# The same entries are in docs/wine-repro/measure-bundle.list.
toolbar-padding | docs/wine-repro/comctl32-toolbar-padding-height/measure.c | -Wextra -lgdi32 -static
header-null-layout | docs/wine-repro/comctl32-header-null-layout/measure.c | -Wextra -municode -static
ownerdraw-capture | docs/wine-repro/comctl32-ownerdraw-existing-capture/measure.c | -Wextra -static
caret-rewrap | docs/wine-repro/riched20-caret-rewrap/measure.c | -Wextra -municode -lole32 -loleaut32 -luuid -static
scf-word | docs/wine-repro/riched20-scf-word-insertion-point/measure.c | -Wextra -static
textfont-applytmp | docs/wine-repro/riched20-textfont-applytmp/measure.c | -Wextra -lole32 -loleaut32 -luuid -static
