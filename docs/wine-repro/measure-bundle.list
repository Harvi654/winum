# One MEASURE or standalone L1 program per line, built for x86_64 and i686
# by scripts/build-measure-bundle.sh (CI: .github/workflows/build-measure-bundle.yml)
# into one folder with run-measure.bat for the Windows VM.
# name | source (relative to the repository) | libraries
parseerror | docs/wine-repro/msxml3-parseerror-filepos/measure.c | -lole32 -loleaut32
mousemove | docs/wine-repro/server-mousemove-show-hide/measure.c | -luser32 -lgdi32
urlzones | docs/wine-repro/urlmon-zones/measure.c | -lurlmon -lole32
tdoffset-records | docs/wine-repro/typedesc-offsets/measure.c | -loleaut32 -lole32 -luuid -static
tdoffset-records-l1 | docs/wine-repro/typedesc-offsets/l1.c | -loleaut32 -lole32 -luuid -static
actctx-model | docs/wine-repro/ntdll-actctx-threadingmodel-case/measure.c | -static
actctx-model-l1 | docs/wine-repro/ntdll-actctx-threadingmodel-case/l1.c | -Wextra -static
com-stub-actctx | docs/wine-repro/combase-stub-activation-context/measure.c | -Wextra -lole32 -luuid -static
