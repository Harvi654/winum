# One MEASURE or standalone L1 program per line, built for x86_64 and i686
# by scripts/build-measure-bundle.sh (CI: .github/workflows/build-measure-bundle.yml)
# into one folder with run-measure.bat for the Windows VM.
# name | source (relative to the repository) | libraries
parseerror | docs/wine-repro/msxml3-parseerror-filepos/measure.c | -lole32 -loleaut32
mousemove | docs/wine-repro/server-mousemove-show-hide/measure.c | -luser32 -lgdi32
urlzones | docs/wine-repro/urlmon-zones/measure.c | -lurlmon -lole32
msi-null-stream | docs/wine-repro/msi-transform-null-stream/measure.c | -Wextra -lmsi -lole32 -static
msi-tree-property | docs/wine-repro/msi-selection-tree-directory-property/measure.c | -Wextra -lmsi -lcomctl32 -lole32 -static
mspatcha-signature | docs/wine-repro/mspatcha-pa19/measure.c | -Wextra -static
tdoffset-records | docs/wine-repro/typedesc-offsets/measure.c | -loleaut32 -lole32 -luuid -static
tdoffset-records-l1 | docs/wine-repro/typedesc-offsets/l1.c | -loleaut32 -lole32 -luuid -static
actctx-model | docs/wine-repro/ntdll-actctx-threadingmodel-case/measure.c | -static
actctx-model-l1 | docs/wine-repro/ntdll-actctx-threadingmodel-case/l1.c | -Wextra -static
com-stub-actctx | docs/wine-repro/combase-stub-activation-context/measure.c | -Wextra -lole32 -luuid -static
com-stub-actctx-l1 | docs/wine-repro/combase-stub-activation-context/l1.c | -Wextra -lole32 -luuid -static
ndrstub-control | docs/wine-repro/rpcrt4-ndrstubcall3/control.c | -Wextra -lrpcrt4 -lole32 -luuid -static
ndrstub-generated-control | docs/wine-repro/rpcrt4-ndrstubcall3/generated-control.c | -Wextra -lrpcrt4 -lole32 -luuid -static
ndrstub-call3 | docs/wine-repro/rpcrt4-ndrstubcall3/measure.c | -Wextra -lrpcrt4 -lole32 -luuid -static
mshtml-open-control | docs/wine-repro/mshtml-document-open-optional-result/control.c | -Wextra -lole32 -loleaut32 -luuid -static
mshtml-open-null | docs/wine-repro/mshtml-document-open-optional-result/measure.c | -Wextra -lole32 -loleaut32 -luuid -static
mshtml-open-l1 | docs/wine-repro/mshtml-document-open-optional-result/l1.c | -Wextra -lole32 -loleaut32 -luuid -static
ndrstub-com-generated | docs/wine-repro/rpcrt4-ndrstubcall3/com-generated-control.c | -Wextra -lrpcrt4 -lole32 -luuid -static
ndrstub-com-control | docs/wine-repro/rpcrt4-ndrstubcall3/com-control.c | -Wextra -lrpcrt4 -lole32 -luuid -static
ndrstub-com-call3 | docs/wine-repro/rpcrt4-ndrstubcall3/com-measure.c | -Wextra -lrpcrt4 -lole32 -luuid -static
